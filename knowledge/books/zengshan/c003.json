  "raw_kind": "source_wikitext",
  "extraction_kind": "frozen_mediawiki_revision",
  "issues": [],
  "passages": [
    {
      "section": "八宮圖第三",
      "text": "八卦各宮全圖〔注文〕初學點卦，不會裝卦者，須裝照此全圖裝拼世應五行。〔/注文〕",
      "layer": "base_text_with_commentary",
      "passage_id": "zengshan:c003:p0001",
      "sha256": "27644d01749426d6e7687ef56385839de3428588371ae333276e148bab6d21e8"
    },
    {
      "section": "八宮圖第三",
      "text": "當年有一朋友宦遊之時，野鶴老人以此全圖相送，友說：我不知五行焉能斷卦？答曰：先學點卦，點出卦象看是何卦，卽出全圖內尋出此卦，照樣裝排「世」「應」「五行」「六親」，不用念卦書，不知五行生克之理，亦能決斷四宗大事，不管卦中動與不動卽照此圖內單看世爻。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0002",
      "sha256": "bf30af312d78b22d8c8384a2e8770dce31873d20dafc69352c027ec749ec2f29"
    },
    {
      "section": "八宮圖第三",
      "text": "如占防憂慮患者，若得子孫持世無憂，官鬼持世憂疑難解，須加意防之。占功名者若得官鬼持世卽許成名，子孫持世且待時。占求財妻財持世者必得，兄弟持世者難求。占病者若得六沖卦近病不藥而愈，久病妙藥難調。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0003",
      "sha256": "b2d1ba4056d75765b6a3c485151a80818458d158c2e16f2fca8c71357faf60fa"
    },
    {
      "section": "八宮圖第三",
      "text": "友問：何以謂之子孫持世？",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0004",
      "sha256": "0aa663e541eb9da5a1361bb0c17ddb38e0ee48efb1675e7748ebe32b1deac223"
    },
    {
      "section": "八宮圖第三",
      "text": "答：子孫與世字同在一爻者卽是子孫持世。倘得官鬼與世字同在一爻者卽是官鬼持世，其餘兄弟、妻財持世皆由此說。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0005",
      "sha256": "087a83d12d860ec0abbd657b760b0e71a35e7fd33646c73e8b7702f21f6c8d7c"
    },
    {
      "section": "八宮圖第三",
      "text": "或問：何謂六沖卦？答：六沖卦者，乾爲天、坎爲水、艮爲山、震爲雷、巽爲風、離爲火、坤爲地、兌爲澤，此八宮第一卦皆是六沖卦，再者天雷無妄、雷天大壯也是六沖卦一共十卦，其餘不是。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0006",
      "sha256": "ecae2806c89c3170d6914a38996d3f47eb311ab1251bf34b431a1e8a6fb95ac8"
    },
    {
      "section": "八宮圖第三",
      "text": "或問：求官者若得官鬼持世，求名必成，求財者得妻財持世，求財必得，倘若官鬼爻與妻財爻或值旬空月破或被卦中子孫發動以傷官，兄弟發動以傷財，𨿽遇官鬼持世、妻財持世有何益也。答：你知五行之理，神早知之，所得之卦，若非凶中藏吉，定是吉中藏凶。此乃神聖引人以知其奧，自然要看旬空、月破，生克、沖刑，今吾友不知五行之理，神亦早知，如若求名，禱於神曰：功名若成，賜我於官鬼持世。倘若無望，賜我子孫持世。如占防憂患，禱於神曰：目下若有禍者，卦得官鬼持世，若能免禍逃災者，賜我於子孫持世。所得之卦自然顯而易見，若有隱微者卽是神變欺人，何以爲神？況我作此一段簡易之法，單欲教其全不知五行之理者學會點卦，卽照全圖裝排就知決斷四宗大事。倘若稍知五行之理者，不可以此爲法，務必細讀此書卷後何謂空而不空，破而不破，何爲墓而不墓，絕而不絕。何爲眞反吟假反吟，何謂進不進。退不退，何爲回頭克者生，何爲回頭克者死。何處可看用神，何處不看用神，何爲占此而應彼，何爲占遠而應近，何爲得其法者百占百靈，何爲不得其法者百占不驗。何爲元神不生用神，何爲忌神無力能害用神。何處辟諸占者之謬，何處增巧驗之奇。細觀種種祕法，方能決事如神。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0007",
      "sha256": "2edb632f71241a3a49ffa6b3157e7ec4951972b14cfc4f331698cd75775d48bf"
    },
    {
      "section": "八宮圖第三",
      "text": "又問：假令占防災、慮、患，若得子孫持世自是無憂，若得官鬼持世驚恐必見，若卦中並不現者何以決之？",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0008",
      "sha256": "177d5b2716781ac9069db01d493858c15217064c87a7889bccb3a0b14e5eb65b"
    },
    {
      "section": "八宮圖第三",
      "text": "答：一卦不見再占一卦，再若不見他日又占，昔人泥其不敢再占，所以無法。我見易經有：「三人占聽二人之言。」古人一事旣可決於三處，今人何妨再占，予生平以來稍得其奧者全賴多占之力也，事之緩者，遲遲再占，事急者歇歇又占。不管早晚，不必焚香。深更半夜亦可占之。只要單爲此事而占，不可又占他事，但有心懷兩三事而占卦者，非一念之誠，絕無靈驗。假令占功名或是官鬼持世，或是子孫持世，得其一者得失已知。不必占矣，不必厭其子孫持世，務求其官鬼持世而後已，此非理也。如占求財或是妻財持世或是兄弟持世，得其一者則止，不必再占。倘一事而與眾人同其禍福者，各占一卦決之更易。卽如行舟遇暴風，家中防火燭，人人俱可占之。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0009",
      "sha256": "56a134dca77763158da9504ffe8675b69b45ec7ad3ffacfa7a3fc249c61c82ea"
    },
    {
      "section": "八宮圖第三",
      "text": "但有一卦若得子孫持世皆同無患。又如占疾病，病人自占，若不得六沖卦者一家俱可代占，但有一人得六沖之卦，或系近病或系久病吉凶合了然矣？",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0010",
      "sha256": "cb324bbd5d20c6cc149db582da4b765657feedcc74f1fcd9fffe13c42a6c3769"
    },
    {
      "section": "八宮圖第三",
      "text": "世人凡有疑難，開口則說求神問卜。可見欲知未來之吉凶，除卜之外，無他矣。我習周易有年，所卜之事，感應之理，就如神聖開口說話。眞令人毛骨悚然。因而不知周易之妙，不念卦書，不得不送此祕訣，試去行之，覓見其靈，從此自肯念書學卜，此法甚善。你亦可以傳人縉紳、士民、行商、坐賈，無人不可。不用須要全不知五行生克之人方用此法，倘若稍知五行者，神必現隱微之卦，須要先念渾天甲子、六親歌，占出卦來會裝五行六親。再學變動，卦中必有動爻，動則必變。卽知動變然後再看用神、元神、忌神，知此者卽如入周易之門也。再看四時旺相章、五行相生相克章、五行相沖相合章、旬空月破生旺墓絕章，又如進周易之堂也。再看後卷各門各類占何事以何法斷之，漸漸由淺入深，以得其奧，不須半載工夫，得予數十年之眞學也。今予先點一卦，教爾學看用神及五行生克旺衰之理。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0011",
      "sha256": "1328628bc0265cb5c4f5de8242482603efac1f189d2d354f8e2ec27148527daa"
    },
    {
      "section": "八宮圖第三",
      "text": "凡問事先寫年月日辰，再照六神章中寫出六神然後占卦。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0012",
      "sha256": "0d4e7c4cb62b53b481c4828120d53c1dc5d9b9e8dddf4c814045068369836572"
    },
    {
      "section": "八宮圖第三",
      "text": "卽如占得乾爲天卦",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0013",
      "sha256": "bf94300ae1e62b4370f9b32098c533beb4969f617959c072922b44c7aa6ef1c2"
    },
    {
      "section": "八宮圖第三",
      "text": "父母戌土⚊世\n兄弟申金⚊\n官鬼午火⚊\n父母辰土⚊應\n妻財寅木⚊\n子孫子水⚊",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0014",
      "sha256": "56fedded0046f2d53bbe915302cf70ad671f405a4e235f379da27354a1755ecd"
    },
    {
      "section": "八宮圖第三",
      "text": "自占吉凶者以世爻爲用神，此卦世臨戌土，卽以此戌土自己之身。宜於旺相，最怕休囚。宜逢巳午之火相生，忌寅卯之木而相克，又不宜世爻落空，更不宜世爻臨月破。此世爻戌土有四處生克沖合。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0015",
      "sha256": "5dd9e342bc5a075371d3fe8cf5cd409fc609cecb804ebf87b1497eddbe3e1088"
    },
    {
      "section": "八宮圖第三",
      "text": "1、月建能生克沖合",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0016",
      "sha256": "849aa6d9b7ed40ce70d4528a53c1f6fe7b6b28f9a73b033a4ae1e79e4a82536d"
    },
    {
      "section": "八宮圖第三",
      "text": "此卦世爻戌土如在寅卯月占卦，被寅卯之木傷克，卽爲世爻受傷。自占吉凶者謂之休囚不利。若在辰月占卦，辰沖戌土，戌爲月破，此謂之世爻逢月破，卽如自己身子如破格也，百無所爲。若在巳午月占卦，巳午之火乃是官鬼，能生戌土，謂之火旺土相，世爻逢旺相，諸事可爲。若在未丑月占卦，此兩月土旺之時亦能幫扶戌土，此世爻戌土亦謂之旺相，亦以爲吉。若在戌月占卦，世爻戌土而爲月建，此旺相以當時也，自占吉凶，諸事享通。若在申、酉，亥、子月占卦此戌土皆爲泄气之時，謂之世爻休囚無力。此謂之月建能生克、沖合世爻戌土之用神也。要知何以謂之用神者，自占吉凶用此世爻爲主，不說世爻而曰用神，占父母以父母爻爲用神。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0017",
      "sha256": "31833fb683826d1b08d1283c441c628680bca7072e6b2ed67ab3de9d9a69f5b7"
    },
    {
      "section": "八宮圖第三",
      "text": "2、日辰能生克沖合",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0018",
      "sha256": "b35b94ca54f2f08b1cb57ea5adb9f9345cebc11ddd0089d0d68873a90d02640e"
    },
    {
      "section": "八宮圖第三",
      "text": "此卦世爻戌土，若在寅卯日占卦，寅卯之木能克戌土，此世爻受日辰傷克不利之象。若在辰日占卦，辰沖戌土，謂之世爻暗動。若在巳午日占卦，巳午之火卽是官鬼能生戌土。此謂之世爻逢官鬼而生旺，諸事皆吉。若在未丑日占卦，土遇土而幫扶，此戌土亦爲得助。若在戌日占卦，謂之世爻臨日建當令得權。若在申酉亥子日占卦，此戌土無克無生。此謂之日建能生克沖合用神也。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0019",
      "sha256": "0ae28b0c578582707286cc7dea90d21e00f89b3d06b8f20653022846893400e4"
    },
    {
      "section": "八宮圖第三",
      "text": "3、卦中之動爻能生克沖合",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0020",
      "sha256": "69ffd8d99016c62c49a72341e5e8e7d4e4c9f00e92ac2f3b2fcf92a9ce9240ff"
    },
    {
      "section": "八宮圖第三",
      "text": "此卦世爻戌土，倘卦中第二爻寅木發動能克戌土，第四爻午火官鬼發動能生戌土，第三爻辰土發動能沖戌土，此謂之卦中之動爻能生克沖合用神。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0021",
      "sha256": "efa36d5f6f57c848cc2360483cffbbb6367c1e3eae3e61585c73a3df5bd0a737"
    },
    {
      "section": "八宮圖第三",
      "text": "4、世爻發動變出之爻能回頭生克沖合",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0022",
      "sha256": "99e1e2b9f0e00418688bb999f4d5c97ef9c2dd4bac9f71454266356b9e1a72b4"
    },
    {
      "section": "八宮圖第三",
      "text": "世爻發動，動而必變，變出巳午之火謂之回頭生世。變出寅卯之木謂之回頭克世，變出辰土謂之回頭沖世，變出卯木謂之合世。此謂之用神自動變出之爻能生克沖合用神也。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0023",
      "sha256": "479edac380f440451a83cc8ca13dbad886e6ccdb7731bc207d979602c61c1e77"
    },
    {
      "section": "八宮圖第三",
      "text": "以上四處若得全來生合用神者，諸占全吉。倘有三處相生一處相克，也以吉斷。若有兩處克兩處生者，須看旺衰。生用神之神旺相者則以吉斷，克用神之神旺相者可以凶推。尙遇三處相克一處相生，若得相生之爻旺相者也可斷爲克處逢凶中得解。若值休囚者有生之名無生之實，與四處俱來克者同斷，諸占大凶。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0024",
      "sha256": "a8ebbb36dda85a631c0ad15b947410fd80b952f1a90a6f73c80f021f98c67640"
    },
    {
      "section": "八宮圖第三",
      "text": "或問：此卦世爻戌土並無變出寅卯巳午之理？",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0025",
      "sha256": "f3043857d5c2a86a21a43fd85a80c8919fb950b8f8a0780133bf7957a6456413"
    },
    {
      "section": "八宮圖第三",
      "text": "答：他爻多有變出回頭生克，借此以爲法也。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0026",
      "sha256": "d02c7ef3ecfe60f060ef17263329fd363cf41640dff038acecf06c5f8e6ddeeb"
    },
    {
      "section": "八宮圖第三",
      "text": "又問：卯木能克戌土又與戌合，還是以之爲合還是以之爲克？",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0027",
      "sha256": "22242f4b3b35796ec063d18d773457f3cfb058f32b705301d2969e48566d0451"
    },
    {
      "section": "八宮圖第三",
      "text": "答：五行相合章注解極明。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0028",
      "sha256": "c1e7550d11c386dc913c13422c1e1b1e8827541a4c09aa8bea5ccf6cc39af8a8"
    },
    {
      "section": "八宮圖第三",
      "text": "又問：此卦乾爲天，卦中午火作官星，如何午月午日占卦也以午火作官星何也？",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0029",
      "sha256": "57fc11e80a5fd7deff9fe597af2017c7cf4f528f1d95c600f52c6bcae6b82265"
    },
    {
      "section": "八宮圖第三",
      "text": "答：不拘占得何卦，卦內若以巳午火作官星者，如遇巳午月日占卦，此巳午日也作官星，卦中若以巳午之火作財星者，而巳午月日也作財星，餘仿此。旺相休囚者，四時旺相查之。空破者旬空月破章查之。沖合者五行相合章查之。暗動者在暗動查之。回頭生回頭克者在動變生克章查之。日辰月建者在日辰月建章查之，生克者五行相生，五行相克章查之。生克者五行相生、五行相克章查之。元神者元神章查之。用神、官星者在用神章查之。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0030",
      "sha256": "7e37d70d9e1dc4b04a99060057761d2d92a2f60673d99bec41c153fcfe192fab"
    },
    {
      "section": "八宮圖第三",
      "text": "占父母者以卦中父母爻爲用神。此卦辰、戌兩爻俱是父母，若兩爻俱動或都不發動，擇其旺者爲用神。如一爻動者擇其動者爲用神。父母卽臨辰戌兩爻二土，卽以土爲父母，宜火相生，怕木相克、忌臨旬空、月破亦有四處生克沖合，但宜生多克少爲吉。與前世爻相參看。占室捨、車舟、文章、章奏、都以父母爻爲用神，須在用神章細看。占他人者以應爻爲用神，此卦用臨辰土，欲其吉者宜四處相生，欲其衰者宜四處沖克。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0031",
      "sha256": "bbb5c5f24a6078cb8a5681f60e35c5ecde383ba6556dc2cf16d81ddcbbfab36c"
    },
    {
      "section": "八宮圖第三",
      "text": "占兄弟者以兄弟爻爲用神。此卦申金兄弟卽爲此爻，宜土相生，怕火相克，忌臨月破、旬空，也有四處生克，都是多生少克爲吉，克多生少爲凶。又云：兄弟爻乃劫財之神。如占弟兄姐妹之否泰者，宜其生旺不宜臨月破旬空。如占妻、妾、婢、僕及財物者宜克多生少。更喜逢空逢破，使其不能劫我之財，克我之妻妾、婢、僕。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0032",
      "sha256": "a86180c97cad8f6478da286b273e5a99c8a6e6c4a53bc0c5674625458c2cba7d"
    },
    {
      "section": "八宮圖第三",
      "text": "占妻、妾、婢、僕及占財物都以妻財爻爲用神，此卦寅木妻財就是用神。忌臨旬空月破，宜水相生，怕金相克，也有四處生克，多生少克爲吉與前同看。凡占金銀、買賣都以妻財爲用神，須在用神章中細看。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0033",
      "sha256": "0cd0249aab12d85f7788ff7837af995de6c7fd636b41be5cae9b8ce8135fc3f3"
    },
    {
      "section": "八宮圖第三",
      "text": "占子孫者以子孫爻爲用神，此卦子水就是用神。忌臨月破、自空，喜金相生、怕土相克。也有四處生克沖合，宜其克少生多，與前同看。占他事者以子孫爻爲用神者，也從用神章查之。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0034",
      "sha256": "52aa8e3421373fc24187dd153b50a7fc9c5d83e11797b8cbf309be52c4032c7a"
    },
    {
      "section": "八宮圖第三",
      "text": "占功名者以官鬼爻爲用神，此卦午火官星卽爲用神。此爻最忌逢空、逢破，怕水相克，宜木相生。也有四處生克與前同看。占鬼祟、妖孽、亂臣、賊盜都以官鬼爻爲用神，須在用神章細看。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0035",
      "sha256": "055a9e1f07a7913522d873d76758b302acc635678efd162891eb7429e0d8b619"
    },
    {
      "section": "八宮圖第三",
      "text": "以上所論諸事，後卷都有細法。恐爾不得其門而入，寫此以爲綱領，引爾入門也。知此綱領再細詳後卷，各章由淺入深，自入佳境。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0036",
      "sha256": "a0be7f60273835610ba8073f0f36cad0f63628b3b009616fc837abbdb3f8a1fd"
    },
    {
      "section": "八宮圖第三",
      "text": "前八宮全圖都是靜爻，然而卦，必有動，動則必變，後篇𨿽有動變章，恐爾不明，再排一變卦爲例，爾宜細詳。卦有「○」變出，「○」爲重重爲陽，陽動變陰。卦有「ㄨ」變出，「ㄨ」爲交，交爲陰，陰動變陽。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0037",
      "sha256": "60f7f90fadbe168f6a82ee4e1dfe58981b3827703eac65d1b47201bed5e84496"
    },
    {
      "section": "八宮圖第三",
      "text": "如得：「澤天夬」變出「天風姤」卦",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0038",
      "sha256": "d6340e1c7a9269498ecd300758c3b721b3ae7b6c7b56ec7716e1c3f457cf6aa4"
    },
    {
      "section": "八宮圖第三",
      "text": "兄弟未土ㄨ　　兄弟戌土⚊\n子孫酉金⚊世　子孫申金⚊\n妻財亥水⚊　　父母午火⚊\n兄弟辰土⚊　　子孫酉金⚊\n官鬼寅木⚊應　妻財亥水⚊\n妻財子水○　　兄弟丑土⚋",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c003:p0039",
      "sha256": "e705bd39b443e28a5ac59b76ee40c9217669aefda3c04f558fa637c230e63a3b"
    },
    {
      "section": "八宮圖第三",
      "text": "澤天夬，上三爻外卦乃是兌卦，兌爲澤，下三爻內卦乃是乾卦，乾爲天，澤在上，天在下，卽是澤天夬卦。從全圖內找出澤天夬卦，照樣裝出世應、五行、六親然後再看動爻。上三爻兌卦，第六爻「交」動變出「⚊」爻，卽是兌卦變乾卦爲乾爲天。下三爻乾卦初爻動「○」變爲「⚋」爻，卽是乾卦變巽卦爲巽爲風。天在上，風在下卽爲天風姤卦。在全圖內找出天風姤卦，以姤卦初爻之丑土，寫在前卦初爻發動　子水之旁謂之子孫變出丑土。以姤卦第六爻之戌土寫在前卦六爻發動之旁，卽是未土變出戌土。餘爻不動不變不必寫出〔注文〕按：宜內卦爻動則寫出變出之內卦，外卦爻動則寫出變出之外卦〔/注文〕。按六親者姤卦之丑土、戌土原是父母，今俱寫兄弟何也？六親須照前卦而按前卦澤天夬土爲兄弟，所以變卦之丑、戌二土也寫兄弟。餘卦仿此。",
      "layer": "base_text_with_commentary",
      "passage_id": "zengshan:c003:p0040",
      "sha256": "49f25e09104002487f74727664e0eece5f90f5d3479a9481320ee02529a0ce29"
    }
  ]
}
