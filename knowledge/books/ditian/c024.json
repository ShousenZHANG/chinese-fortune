    {
      "section": "眾寡論",
      "text": "抑強扶弱者常理，用強捨弱者元機。",
      "layer": "base_text",
      "passage_id": "ditian:c024:p0001",
      "sha256": "8e929b437b03b87a9d4174101ed354e3c750651e6d477cc6c72790e359da6119"
    },
    {
      "section": "眾寡論",
      "text": "強眾而敵寡者，勢在去其寡，強寡而敵眾者，勢在成乎眾，強寡而敵眾者，喜強而助強者吉，強眾而敵寡者，惡敵而敵眾者滯也。",
      "layer": "commentary",
      "passage_id": "ditian:c024:p0002",
      "sha256": "65241e70b879fb789ea04269c87d0fc6407dcaa632fa3afb884d164bfdc14443"
    }
  ]
