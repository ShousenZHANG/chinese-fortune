    {
      "section": "奮鬱論",
      "text": "局中顯奮發之機者，神舒意暢，局內多沉埋之氣者，心鬱志灰。",
      "layer": "base_text",
      "passage_id": "ditian:c025:p0001",
      "sha256": "7fdc7f09b0028e7915e01559996adea3f50453390fe2fdb2116828db34d22942"
    },
    {
      "section": "奮鬱論",
      "text": "陽明用事，用神得力，天地交泰，神顯精通，大都奮發，陰晦用事，情多私戀，主弱臣強，神暗精洩，大抵困鬱。純陽之勢，身旺而財官旺者必發，純陰之局，身弱而官煞多者必困。",
      "layer": "commentary",
      "passage_id": "ditian:c025:p0002",
      "sha256": "3884b7bbc0f739914f13d0bb30332e0c47f3d00150dd9fe5ff446f2288fe6c60"
    }
  ]
}
