{
  "book_id": "yuanhai",
  "chapter_id": "c192",
  "title": "造微论",
  "source_url": "https://luckclub.cn/bazi/001/192/",
  "revision": "sha256:aba23ce2de1ce35f73997269d64ebca8e7e61e4458a0e832f7fd8414f692dbec",
  "source_timestamp": "2026-09-06T04:11:02.351167+00:00",
  "layer": "historical_work_transcription",
  "facsimile_status": "not_checked",
