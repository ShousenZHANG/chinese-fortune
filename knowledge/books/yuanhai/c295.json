  "raw_kind": "cleaned_original_transcription_not_complete_http_response",
  "extraction_kind": "selected_original_html_node",
  "issues": [],
  "passages": [
    {
      "section": "一行禅师天元赋注解",
      "text": "渊海子平卷六",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0001",
      "sha256": "222a11cf776cbb806f37292c1b03f7e25c110d85b0768baf1ed10f8923622000"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "一行禅师天元赋注解",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0002",
      "sha256": "f02022a422240d688b9deebf2d8dbc92308ca3c040d0ba99b789984320e54e97"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "三才即定，五气混同，分之逆顺，贤者皆通。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0003",
      "sha256": "86d2d24cc040da987727d24a887bf4bd87f690f51a1cd7fd67d93fc80fda0f00"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "三才者，天干、地支、藏干。五气者，金木水火土之气。混同於中，以阳顺阴逆分之，然後可以论命。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0004",
      "sha256": "17bc1aef0d54bcbe20d65f824d813d5b1a19216b342fcf48712d13d2ea63536d"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "甲得癸而滋荣，衣食自然丰足。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0005",
      "sha256": "2a15059e2cbb63ee1ed834cd9ddf73aba789b1082b04ae3956d2097e01bb0cdd"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "甲阳木无根，若无水则枯朽矣。癸水，阴水也。犹石泉地中之水脉，不泛不浮。甲木赖之以滋身，方得荣茂。癸水为甲木之母，母子相赖，则衣食自然丰足。如甲木生於春，自然承旺，生於冬，则癸水旺可以滋身，言福矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0006",
      "sha256": "90fdf0edde324104038f5fb8c59f4da77a7c032c7ce668045fbfdcdd4d726009"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "乙伴壬而获福，天赐禄位高崇。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0007",
      "sha256": "ac2a5d87325f4075525e036aee1700febb6bb4d75bbfafe85e3971296f54c096"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "乙阴木有根，藉壬水以养。壬水，阳水也。若江海之水，不能损有根之本。虽多不为淹没、不能飘流，犹树木得雨露之霖，故曰天赐禄位高崇。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0008",
      "sha256": "e33fc85df58c828089f648b7406b2610287c6b03944521118334b482fa5d5790"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "丙乙交会，平生福寿超群，出世深成才业。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0009",
      "sha256": "dc7f6e7e4042632b908f75bc8ce325b8e00f4196f7a65dc2fbbafe5d1a7b98e4"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "丙，阳火也。乙，阴木也。阴木生阳火，相生也。乙为丙之母。丙为太阳之象，在天为日，在人道为君、为父、为夫，主刚毅不屈，有文明之体。又得乙木生之，是谓交会。逞其光辉，故得超群之象，且安寿考焉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0010",
      "sha256": "f74cf8caab338569c63d784ea534648e4ab25c2b282bb036bcfd5dfd247ebabf"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "戊印丁兮，似虎居山谷之威。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0011",
      "sha256": "a797ad7852eb79d7d5222a4e5a871bec4ae47d78f8232a5e850091846b8af716"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "戊为阳土，赖丁火生之。丁即戊之母，母为印绶，且土无正位，寄生於火，乘旺於四季，辰戌丑未之方。故以土为山谷，若土居山谷之间，自然有威。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0012",
      "sha256": "f23067b66e4e882d8baa699c04922ad40392d41bdc58b0348a3e958c7bcb87e1"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "己交丙兮，象龙得风云之势。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0013",
      "sha256": "3084e40e53d59a631c8c0c86acf4d662abb331bbf56a252ba1f1454e1a67f005"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阳火生阴土，犹父生女之象。丙为己之父，言如得父母之庇，如龙之得风云之势，任其自如也，为富贵也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0014",
      "sha256": "065b6f412037e1d3c4a38babc87c2fd64e8d022d545620104542dd8b78b2aa2e"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "庚逢己土，官禄有余。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0015",
      "sha256": "e9b5f583bec5f1703abe3c50c8a58748231c3f200bf819ecd5e41394da56c21c"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "庚金以己土为母。金生人，逢火地，则败其身矣。要有土以生之，则为福矣。若运至土亦可，但若土太多，则埋金矣，无福矣。五行以中和为主。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0016",
      "sha256": "eda0457c9f1296a93353784763b6ef8aa09e39a13c80c8f4f342dc9b4fa7677f"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "辛到戊乡，衣食自足。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0017",
      "sha256": "e40f0e490909ecc2c29fa016f6ae6a970c1e3865039ef3a9db5ffc20e613781a"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "辛金遇戊土之乡，是为父母之邦，得其所。且金赖土生，如辛日逢戊乡，命局原无印绶，忽遇印乡，如逢父母，则快如也，主衣食自足。但如四柱多土，则不宜又行土运，所谓土多金埋。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0018",
      "sha256": "4ed745dfb8b1df6d91cca8e2dc9d35589c63f9877e20f991c83d6068f83cc268"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "壬辛得会，福寿无疆。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0019",
      "sha256": "65fce41f08986d8f1a99a64d25e0dcb4fef6e0cf213b578e9b8ebfbecf9607a9"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "壬水赖辛金为母，得生生不绝之义，如壬水生於夏，则无根矣。若逢辛之生，福寿无疆。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0020",
      "sha256": "43674d38cda5bc0f89053c79c7035bd414ff7061fd7436bda73b883b6ec8d544"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "癸庚相逢，偏饶仆马。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0021",
      "sha256": "6b6287b6e975472829c6a6f04d5a49745905d240a4f2c5e8876c76e6de5f46dd"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "癸水以庚金为母，如以癸干日，四柱有庚金为印。如无丙火克伤，则主人多仆马富厚。柱中无庚金印，而逢庚印运绶之方，亦可为荣矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0022",
      "sha256": "97469da7cf356042dac2b07830dba26ed395a01554bfe252b5dfa7a4d2d97b7e"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "清高符印，须知冠冕以乘轩。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0023",
      "sha256": "2329af03b5c8d1345a2fc0ea98b92948ded96272a75919dfae419bc947acb76a"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "符印、官印之星，则为唐符、国印之星，人命遇之，主有冠冕轩舆之贵。非为人君，则为王侯之贵。以年干之禄宫起，顺数第八位为唐符，第九位为国印。如丙戊生人，丙戊禄在“巳”位，从“巳”位顺数至第八位“子”为唐符；至第九位“丑”为国印，此二星为贵。如下表：",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0024",
      "sha256": "b34ee99ea50fe9d4b07d7f441d7c1390a5d755b2b393da45a2fd4184fe3ebc12"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "年干神煞　甲　乙　丙　丁　戊　己　庚　辛　壬　癸",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0025",
      "sha256": "bb3d4f8cc4c91949dcefe58e0f046a3003aa7c16610966df1e950d598b19a7c4"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "唐　　符　 丙　戌　 子　 丑　子　 丑　卯　 辰　 午　未",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0026",
      "sha256": "587be102ee5d79afacde4115a3beb82d616984b6b9af5d09c59f4b47661818e7"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "国　　印　 戌　亥　 丑　 寅　丑　 寅　辰　 巳　 未　申",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0027",
      "sha256": "b3a44d38b207e12b741b47dcfeef0a8559cd35c994b575ee1b5736ccb0fbb8c8"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "冲破禄星，应显威权而解绶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0028",
      "sha256": "4d41dfc21115b51a17911ca5abb12d09ec80d64b7568e2023cafc5970e18471e"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "禄星者，官禄也。用之为官，不可冲。用之为禄，不可破。破而冲之，两相为害，虽有威权，遇之则避身位矣。如甲用辛为官，官丁火克破，则为害其官。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0029",
      "sha256": "a399d131fc7a5866a6e8ada499ec696f479d348a35938b0ec08fad138300fa6a"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阳木甲逢庚败，枝梢不得无伤。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0030",
      "sha256": "b131a5b8aa515ef715c61e966041d3bca506fd8040866d49891fb51460019877"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "甲阳木，遇庚金，则削之，未免伤其枝体，即庚金克甲木，以人命喻之，主有筋骨疼痛之疾，难获福。惟行火运制庚之地，可以言造化矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0031",
      "sha256": "c4fa1aca5bc2b3c3a82c1b354dd90f9827afedfa7cf3fe54df76250ada7da606"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阴木乙遇辛金，茎叶自然有损。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0032",
      "sha256": "e9135527fa21cff4cfa563379c64186c91a159700908e35f86a4df3b23ab49c0"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "辛金，泥沙之金，只能损木之枝叶耳，不能害其身也。乃阴克阴之故，如乙木主有气，坐旺地，则不畏也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0033",
      "sha256": "15462a1d1df1127d09b6c870f34c9fcc19c25a03d5b8228ba0057a95b374f608"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "炎炎丙火，遇壬而赫赫无光。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0034",
      "sha256": "182783f8abd6dbd2f41d300e598cd4fc4dd85aeb1c24c4f1ae8832f614533b95"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "丙火，阳火也。取日之象，悬象在天，昭然光显。壬水，阳水，为江海。丙火遇会局(三合、三会)则有伤害。若不会局，则无害也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0035",
      "sha256": "ac691c9f2903615a10595823bc8b15ccde9cec7475dc223a508d67248927e761"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "烁烁阴丁，逢癸而明辉自暗。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0036",
      "sha256": "9acbfd87090fd59986271c14818a12bc46749643006931ff81c82322e282991c"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阴火逢阴水，丁火为烁烁星光，悬象在天，癸水在地为泉水。水火相克，主目睛、心腹之病。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0037",
      "sha256": "36c1ab4f836d86389f23280596e96b551447d6fa92a0a6a480204d812177c663"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "戊居甲位，惟赖庚方能吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0038",
      "sha256": "61b09264a913b3456819984c9beaf01b2123512e5eb1056decb9f71707a248d1"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "戊土逢甲木克，主脾胃之疾。戊，阳土，为城头之土，堤防之岸，遇甲阳木克之，则有崩溃之患。如得庚阳金，制甲木，则可救其危，言吉也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0039",
      "sha256": "f775c16b2d222c4fd0ac73ef331fdd1499977561360a750554b95501b8365877"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "己坐乙乡，知是干头有鬼。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0040",
      "sha256": "5c9daca91c548f6f2e8c9ad50e421d201015d90749d425fe287a0335373c45cf"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阴乾克阴乾，谓之鬼也。如己土日主，临卯位，乃为坐下之鬼。又行寅卯之运，又逢甲乙，相克之乡，身旺则逢官为福；身弱则遇鬼为祸，矢折或贫。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0041",
      "sha256": "71b2eb4e56b8d993db69a75d101b08c8f2487498613f55b891859505a04bbfcb"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "庚逢丙战，势自倾危，辛被丁侵，克伐成害。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0042",
      "sha256": "06ed51c29a8fca70b2aaeaec1685104972584a2c3aeb5f3d3b6a80c0b1e06919"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "庚金逢丙火克，主肺筋之疾。庚辛金，被丙丁火克，则不能为福，须得壬癸水，制丙丁火，济其均平，可以为富贵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0043",
      "sha256": "5154c7cbd5228663fae937c970d62f63ecc17c8bf333feee8ca0cb15ae24eb12"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "壬忧戊至，蹇气难通，癸怕己临，迟晦惊惶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0044",
      "sha256": "56fdd87280cce43956269bc073ce345f3a05525365c013df3dd4812aec64fd9f"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "壬癸之水，其性爱润下，如遭戊己土以滞之，则阻而不通，主不能获福。土若太多，则为贫贱。而水若太多，则为泛滥淫奔。惟水无土，则流而不息，赖土以防之止之。土止水流，全福寿。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0045",
      "sha256": "c2ede469b39b4b58ac9d5feecc66cb2e82a5b9388a7cb1e67bbcf536d2b54f8c"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "干鬼带禄旺，扶持更破。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0046",
      "sha256": "eb71480c30d80f2dd3a3aa6ed082dacf44c5b4299132e8da3460fa38d34589f4"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "身弱者，日干受克，谓之干鬼。若逢禄旺，则能扶持。如有破败，为福且少，为祸更多。主或富或贫，进退无常之命。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0047",
      "sha256": "e90072f4e9d58fb1f80ad14494c633a855d2adbf2af61c6a271f1be45127d3c6"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "支神无吉神，祸皆难免。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0048",
      "sha256": "1e9e93ec32b52220b8585775ecfc2071aa16b8edd407ba3f94794b78493a816f"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "支神，人元也。即地支藏干之神，宜有吉神相助，可以为福。若支藏相克之神，遇患祸则难免矣。如甲木生於子月，子宫藏癸水为印，则为美矣。但如年日时中有己土，旺克癸水，则谓吉神受损，祸则难免。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0049",
      "sha256": "471576fe771be6b357de699399f7ff3ec5db3292dad49436b9f9a6cfc8a9125c"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "食堂福寿崇高，皆言甲到丙乡。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0050",
      "sha256": "c40f823cb185a407464435ff2c9e027c63608a31932acb8fce6362ca7123a1c1"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "食堂主人丰肥福厚。甲到丙，为食神之地。甲木生丙火，丙乃甲之子也，甲如丙之父。甲食丙之禄，如子女奉养父，故曰甲日干逢丙，福寿崇高。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0051",
      "sha256": "bd1424cdbbeec784a0508ec9b5e4c9205587b4612f8dffc5982552511716e20e"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "朝省闻贵优升，盖为乙居丁舍。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0052",
      "sha256": "d24cae83070780ab8cebe120e3135b450a5fba78482bc2b6ce97de3da4fd549f"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "乙木生丁火，乙到丁地，亦为食神之所在，如父食子之奉养，为吉也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0053",
      "sha256": "54169ecd905f6a8bc0c5d4a3c9c3dc2431df83dc77a9d9a3f6ac59abd9795921"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "官禄并叠，丙食戊而成功。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0054",
      "sha256": "0e24f2e37b78405fcfb201f02c7f4733d05ea442bc8f2e2fedd8d3811a1622cd"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "丙火生戊土，同为食神之地，谓丙火食戊土之养，吉也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0055",
      "sha256": "67840e551975955f00692ac1d98fc5d914171f5c10df242fc6363e7a294a8672"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "谷麦盈仓，丁啖己而有旺。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0056",
      "sha256": "838607d6c79a8131b6997d1a5121afef766a26607e1170ad3fc1e054406de684"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "丁火食己土之禄，主吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0057",
      "sha256": "377d8a685be92f8b03d6003cfdca50218bc1650c7dff10e09395d8d9013eec7b"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "要得丰足，无过戊得逢庚。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0058",
      "sha256": "b38c93d8591d1f9b3f3cd82e5ad30f498ea1ef3835e5c943680163854888d065"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "戊土食庚金之禄。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0059",
      "sha256": "cbc349b5401ffb79c1cc9019764abb35ff9a599096de2817dcfc4689d3720fc2"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "欲问高迁，全赖己加辛地。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0060",
      "sha256": "6bda0e5c80c67aa0c0c7f28fa22055dc44469cad0fdd04a1754f1dedba92f1ae"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "己土食辛金之禄也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0061",
      "sha256": "256203c0bfc876c3acd59ffd40c15fb2d94c4b1624332af4bb7c74c949cf3f9c"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "满堂金玉，庚禄有壬。广置田园，辛能食癸。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0062",
      "sha256": "735c1f060e7ecb800d2c823b55188bbf691cf557f74564fdc5012cd05fdcb6ea"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "庚金食壬水之禄，辛金食癸水之禄，皆言食子之养也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0063",
      "sha256": "d0770579bcea124e92bcef21d9ac49a5340eb3c5e874a092c025a4c68d54bb78"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "壬食甲而有旺，衆福如麻。癸向乙而生成，入食列鼎。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0064",
      "sha256": "cfd6487131d4e7267fc6b0a4c193f8fe6d6f7d8638fec531a235423f115cc6e5"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "壬水食甲木之禄，癸水食乙木之禄，皆为干干生成之禄。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0065",
      "sha256": "2ad3496e7b994f61d2990c981e7c0e17dc5b0b1e366c90905f9758510c1ee8bc"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "干支见食神，如父得子之养，必然享福安寿，而无所害也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0066",
      "sha256": "135caeca534c5ee11f01c884eae0bfeb85da2ce798fc8bee4ea792686905e519"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "五行既废，得救助以灾轻。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0067",
      "sha256": "618b2507b51679e8b72e7df83640f5126d1a2ad6b2535e5bd5cd4e0eb0f2b46b"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "四柱五行，遇休囚死绝之地，如柱中有一在长生、帝旺之方，则颇相助，有灾则轻矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0068",
      "sha256": "dfa8b5e93e42f202df080e4ef326aad407c515db12d0a5d607eace59e0e90dfd"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "四柱官印，无损坏而禄重。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0069",
      "sha256": "9e632359b9389cef730983e13e573bacb00e1f892a1edaa87e145272ac29f7e5"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "四柱干头有官星、印星，无克者，主人一生禄重，但恐遇克害之运。犯小运流年克破，主一年之不利，不为永久矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0070",
      "sha256": "2a404187691ddd411b522e583a591d5b44cce33029a1e8f8c40a7b7a2056050e"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "甲逢丁而成焰，资财累岁多朽。乙遇丙而化灰，金玉自消难聚。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0071",
      "sha256": "a6d5a46ea4d1edf05ac84f47b7503a1a1ce81f312defa541d5e33b46d477b82b"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "甲木生丁火，乙木生丙火，为伤官盗气之论。伤官者，我生之子也。为人傲气，不循规矩，能消耗父母之财物，视人不如己。伤喜官财，则荣；无财则贫。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0072",
      "sha256": "be6593e9a224854d3808934c28a32358f90dc2c10061ea3cdc387540008725e7"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "天元正败，丙见己而伤残。干禄全轻，丁值戊而衰弱。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0073",
      "sha256": "dcc94960475e1706cb84bd3578d73967f3d7c0a7cb817b1a2d01e4f3210240c1"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "丙火见己土，丁火见戊土，为火土伤官之害。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0074",
      "sha256": "f668fa2423e730866c74fada1f3fa7b8f24c35d77b3de345b1cca954f47b928d"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "戊若逢辛，须仗吉煞以扶持。己宜输庚，实赖五行之救助。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0075",
      "sha256": "c18be81864810dd99bec05db8176b53c527b0c3315373eb68d0cacb5952be1f5"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "戊土逢辛金，己土见庚金，为土金伤官。土金两见反成欢，赖财印以助之为福，忌官。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0076",
      "sha256": "629321f01c18a0f63a4aa8ad437343a8eff1eda67861126df74b823899286f44"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "庚中见癸，荡散资财。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0077",
      "sha256": "a8e75d629ac91a9f51c1bcf12b345816711f0ed783fe6af4cc5b5e57b11b98b8"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "庚金生癸水，则有荡散钱财之祸。须得土以止之，方为发福；无土止之，则为散漫。主人流荡淫欲亡家。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0078",
      "sha256": "bc89863bec075184022082176de3e15eefc80e899e727eba54da3cab9f81745f"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "辛禄遇壬，熔消福禄。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0079",
      "sha256": "ffff2e1a3357ce65c840e7a88be75909e91a0864a9f6dbecd18a09f19d47592d"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "辛金生壬水，为伤官，是为金水伤官。主人清秀好歌乐，极聪明淫佚无度。遇土止之，则福；无土止，为下格。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0080",
      "sha256": "b6f3595058ffe21d43cea4ec4be30b3251494454d705c23ca4dfe62aa3d02ed6"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "年少逢灾，壬伤乙运。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0081",
      "sha256": "55b3542497ac2d8e7e6dde94a0d670a9dbc9251916e758d66a3de8a9f7fd6a65"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "壬水生乙木，为伤官。又行伤官之运，主有灾。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0082",
      "sha256": "35ca3ba4fbb948fa672f2881ead3646119e358998dc1f3aa572c20cd7badbf9d"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "祖财随废，癸被甲侵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0083",
      "sha256": "3a1560ebf805019679a7e7da0b75b1e994a34ad58ae0c115dd3cd69cbaa93433"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "癸水生甲木，为伤官。柱中有制则吉，无制则凶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0084",
      "sha256": "595b1b030920e41c71bbfd3529af0d85f26e516d0c584721baa96b7c94ecfc28"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "衣食难求，幼岁常逢五鬼。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0085",
      "sha256": "07a862598ff3a020f051ee6ca87362ccc28c37e2aaa8e61e118696fb9bc86233"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "日干弱，见七杀，为鬼。谓之阴鬼害身，暗中不觉。若身旺者，化鬼为官，则能资身为福。遇五鬼，阴煞也，害人不浅。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0086",
      "sha256": "276f97d2c181b68e2b26dbe879fc0c73767910b4d77cbfb1a91733e84feb3a2b"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "循闷休祥，长年元值三刑。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0087",
      "sha256": "a521787a90ade4e93df8429c94bfa17efec9a24fffe35b7314d6a1281a855a9e"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "三刑者，寅巳申、戌丑未、子卯之刑。地元逢之，不利也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0088",
      "sha256": "75d8e40e57907efd1a34db00b43faaa752b0eca70e18ab7f2de947adc7d9e1be"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "祸来难免，禄本逢衰。若遇败神，兹生休咎。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0089",
      "sha256": "16d684623382b4f56b9704be5842f2b95291db6dfa065a911f7fca7fc6ad9f38"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "官为禄本，有官而无禄，则为假官，虽荣而不贵。有禄而无官，则无所施。官禄若行衰绝之地，未免不罹其祸矣。败神者，破败之神。命内逢之，主一生休咎不利。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0090",
      "sha256": "411e4d5b2659417c7c4ba2e9e96e7cda780114fcff8c9fdd80b5ab8a9be2f95e"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "况夫甲憎乙向，逢之自己多灾。乙被甲临，反与人为助。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0091",
      "sha256": "c21aa01f592351920c2d0a97478e5a0167eca4892a81f78bb131e34694e5edb2"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "甲见乙者，为败财、羊刃，主克父及妻。有家产，则兄弟争而分夺。无家产，则起祸端，手足不相顾。乙见甲为兄，为劫财、逐马、克妻、身弱助身，遇财而劫之。即阳干见阴之同一五行，为败财；阴乾见阳之同一五行，为劫财。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0092",
      "sha256": "904ee7c61f4bf280106e3115582a1113bc1a75aa2ca5f613aa0dc989c7af502f"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "壬行癸厄，丙最输丁，辛忌庚方，丁嫌暗内。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0093",
      "sha256": "b49604a4cd59b5c90ef595e75f37495c29a8f35fcd6327751f7b660bcf151450"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "此皆败财、劫财之祸也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0094",
      "sha256": "a53c09f7b94baa95d0d93bd518cd91e94d9dee16dd15f9db721060b2cde1f5fd"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "戊同己兮，多生脾胃之疾。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0095",
      "sha256": "ad750129b560596c3aeaff8cb8eec9e702009a8d8c394b4e30628c47dd0c79b1"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "戊己土，在人身为脾胃，若遇木克之；则伤脾胃之疾。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0096",
      "sha256": "51684335ed91193391d6fd3b82a007bb2596e09e55c3ccff5947434b73710012"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "己共戊兮，反有奔波之事。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0097",
      "sha256": "40da49199c0488d754aace236294bad74075c0509cb490adfb3c09c1460c5b44"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "己为弟，戊为兄，人各自立，则无伤於和气。倘若弟兄同处，必有萧墙之变，反主奔波劳苦，安得有怡然之乐。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0098",
      "sha256": "ba87f4ab4b3a5cf921ce19469aaad240462c2ce5e6ea876b9ed80801a7449d74"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "柔能制刚，多因辛与庚期，大重之余，乃是辛居庚地。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0099",
      "sha256": "3eba88bc93955b68d104ae3073215fbb5a3e3257b8d20aebba77503b3d1fec8a"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "庚阳金刚，辛阴金柔也。庚阳金，为剑锋之器，故云刚，能杀万物。辛阴金，为钗钏之质，故云柔，能为美观。阳刚而阴柔，互得相济，为福，相制为禄。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0100",
      "sha256": "8848db3f876d0c7c7f784a8d77d5b7f3244b7f71cbb3e8909847065a7b5a7f69"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "癸中隐丙，壬午遇之多伤。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0101",
      "sha256": "55532e5fe7f7dcf50d8590d4184c1c0b7902e909ae076dcb2cffff84e05ad287"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "癸以丙为财，任其所用，若遇壬午，又伤其丙。壬为癸之兄，且劫丙财，故曰多伤。午中亦有丙，况干又壬支，壬又伤支中之丙，亦劫丙财。以癸日为主，四柱有丙，又遇壬午，则主多伤。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0102",
      "sha256": "39cc9a85217882f5998dda1b0dc7d9f63d3bd05c2bd5e04562e0a5a016b0a71b"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "壬内藏丁，癸水番然自败。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0103",
      "sha256": "0e1b634d6476e23dff6f969c426da8f0af1debc1801409a05180deae8e4150fd"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "丁与壬合，有夫妻之义。壬为兄，癸为弟，如遭癸水克丁火，乃为弟夺其妻，则伤败也，反为大祸。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0104",
      "sha256": "a2181b7f57c90e43b3d630052432baa8245ecd35797881e8c5e3fd571cfd0347"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阳者若为暗损，平生惟恶轻生。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0105",
      "sha256": "d41a5e356622fb79239db73841c3386a4a04840c02e972f61ad8c959acba3fed"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阳者刚也，有果敢刚毅之能。若遭暗损，尚有自叶其身矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0106",
      "sha256": "edf8a8dfc5286f653302ee8b5b783a5ae3a10a21e1f2a1c421fc007c3209a013"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阴位即曰败神，处世尤贱抑塞。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0107",
      "sha256": "4dd2dc08d3ae9910007a49bdd5ed21bb7f35894b096b1a3e801750a8d617a1f7"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阴者，柔也。女人之质喜之。若男命纯阴，亦少刚助。处於世，亦为抑塞其志。若得五阴聚局，可以言富贵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0108",
      "sha256": "5aa6e54f37f422c3a5e9499ccc244524f31259c4dd5779a8e1acbbdb90c86ea8"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "甲见辛而化官，刚柔相济。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0109",
      "sha256": "487d2e3fbc45107d6abd1cd82661beb1f10d5568eb7b05658ac23237b87c9cf1"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "甲以辛为官，甲刚辛柔，阴阳相济，而不相克。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0110",
      "sha256": "259b25a7b2eba30ec5c6f8902cb13cb28e10e1e3cf9cee3def736ed120a96aea"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "乙见庚而为福，兄弟同乡。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0111",
      "sha256": "d75450fcc98080025b99a9c2d3bf053a67410ef723448d621a8184b80bb87fd4"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "乙见庚合，庚金克乙木，为正官，而为有福，犹兄弟同，而且和也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0112",
      "sha256": "ed74d943eb87801524e30399a954e01a21149c5d51ca1bb2d85df928d6e7363b"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "水火既济，却言丙对癸乡。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0113",
      "sha256": "6d26f7da2e36a87ecc18fc05e5dd73fdbc7a798523dbe21c9f6d27af41b2ebb6"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "癸水克丙火。丙为太阳，在天，癸水居地，上下悬隔，岂能相克？而子午相对，正得既济之象，终为吉兆。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0114",
      "sha256": "c41d59d57f896667b0be31478aa4ac3545da1e2772d4763cac9ddbba8561ccd0"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "意气相承，乃是丁归壬舍。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0115",
      "sha256": "81a65212be8a28045cce28f8b5b224797b1355e6d08dae2cdd495c0dbac0c314"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "丁与壬本相合，阳水不能克阴火也。故同舍而居，相投而乐矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0116",
      "sha256": "95b74bba73f2c654529c1568a3ae10f03a1811837216d123e68559ea2fab3c90"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "戊临乙位，得木而生成。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0117",
      "sha256": "0d5d7d5806af9305686e2f454ac1b5922c0b04648e0fc9dab78ad1542b027455"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "木赖土以养也，且得成林之象；土赖木以泄其土气，两得而生成。戊土临乙木，相生成也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0118",
      "sha256": "bc48fb401bacec2d710264dbfc7a9d0ed5bb3882be797472cf60e56ff3a381b9"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "己向甲乡，阴遇阳而可贵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0119",
      "sha256": "925e4713b228ea7262a09f0933ee3bf967e0e2f97332c40357fc6f0f37552523"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "甲阳木，己阴土，阴阳相配，甲己合，甲以己为财，以妻之财而享之，为贵也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0120",
      "sha256": "132a7e9724bcbf1cd8871d187ec3ec7f07de1455c41fc42d8d4e8a94ca9f6bbd"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "白虎通道，庚加丁临，太阴得路，辛归丙舍。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0121",
      "sha256": "892ac76e8df86128b58a32ad404432d2478b997d47e0a699ac5c0c2da5576f79"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "庚辛金为白虎，加之丁火克庚金，得配阴阳之道。以柔而济刚，无相害也。辛为太阴，遇丙合，是为正义。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0122",
      "sha256": "53bcea854594b3e3c44a37c6ff393c8f43741f2dbe917567c1ce5ef4a25979d7"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "壬於己兮，远泛洪波。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0123",
      "sha256": "e350302b32f41101081ce43a38d9983e481d5cbe00134a64a42c44d10664066a"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "壬为江海之水，己为平地之土，壬水於己阴土之上，则成洪波远泛，无以止之，须得戊阳土止之，遂塞其流。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0124",
      "sha256": "dc7d2ff6e665a47ab3fb9cf54cf5983f07e4b1e7a912b513e8ea0108c31f2f1f"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "癸喜戊兮，澄澜漂渺。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0125",
      "sha256": "3f18395538eae8caa566233e224cfeb23f831ffdb2f006cb1a84e3688a0d52cd"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "癸与戊合得其正义，为福也。无波涛之泛，故癸喜戊兮。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0126",
      "sha256": "0e806e5275e968a5f1fe392224b0045f55bbd615c74d1a0feb537a0512521848"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阳遇阴而化合，阴得阳而成器。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0127",
      "sha256": "79e010688ff17c600894941b9b123f5f1cf1611c5aa1cae9f61c0fca205792a6"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "从化，阴阳相合相得。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0128",
      "sha256": "d8c94a486209e0f549df5d2d1dcf80eb15cd58f6408fb9257bf509b6452441c4"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "又有甲己相逢，化土为福，则夫妇遐昌。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0129",
      "sha256": "4b17eeea9a264d14fda45b99a2b8846d395bf5f69f958f81462bc6fb9ec4147d"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "甲己合化土，甲日干以己土为财，犹人以身从妻之财，可以为福，得全夫妇之道。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0130",
      "sha256": "7d91f5471abb90f37d9b16ff817e787de955e75609eb97efdc2be08d830ca3b6"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "乙庚各合，成金得位，则东西类化。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0131",
      "sha256": "afd2820a4778a0c9795b976b467f87445291563bfb7299c1660ee2099b9c6949"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "乙庚合化金。得位，谓居在申酉月支、或地支申酉戌、或巳酉丑全之戌、巳月。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0132",
      "sha256": "5cddacb2b4830b6424eb825e81bee372cddd279a1426d98c2297223ea2b5cc7a"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "丙辛化水，智显则必主文章。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0133",
      "sha256": "09c648cd7d4fd44c3cf4f16d904b69b9a52a18130d6d91ee57128d6409288583"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "丙辛合化水，主智显多巧。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0134",
      "sha256": "a52bbea881c378de0ec24f3e895bc684526984a991374e8b46afa1f2d1f85f70"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "丁壬为木，聪明则近善多仁。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0135",
      "sha256": "cbc37b99ac9f3feefbf3180fe2ac1458d68389e092d5b9fec51544c1f52fc75d"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "丁壬合化木，月支寅卯，或地支亥卯未，或寅卯辰之亥、未、辰月支，可化。主聪明乐善好仁。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0136",
      "sha256": "52af7272288cdc457e64d56b4188d451f9e06ea39a70e08ab25994d5ea1e6a57"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "戊癸得化，禄位崇高，二者相逢，三才可立。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0137",
      "sha256": "55c9e521ee100f810058cf204938143c78e7f59fdefee429e74a6ecabad0c7df"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "戊癸合化火，生生不绝，化化无穷，禄位崇高。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0138",
      "sha256": "b7608291dbaac306ecbca17e55d46d2e8eb40eb10d0eb942c00fcc49f14b6bc2"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阴遇阳而化官，到旺方官崇位显。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0139",
      "sha256": "5ad0173d002a56bc7a2f5a507897bff796e285f78b9c6f1257c186d914c83864"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "言一阴一阳合化为喜神，居旺地则为贵矣，官崇位显。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0140",
      "sha256": "5f32b564b4e417285f15cddcabbec7a1f4ceb33fe259dc0d04aa131746c3d68a"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阳得阴而成配，临有气财旺妻贤。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0141",
      "sha256": "8db6f74f98bf9ed613be7bba2415cab848eea7e1f0aba7f44548de14c9e9d0b2"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阳者，男也。阴者，女也。阴阳相合，为之夫妇。若临有气，主财旺，妻贤。若遇休囚死绝，主散财伤妻。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0142",
      "sha256": "a8d974d461e01f5c23666b5d57f0a7d63446d3812402b47d1ff0705836de1b7a"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "是以平生不足，甲为壬伤，处世多迟，乙因癸克。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0143",
      "sha256": "ac1a34421775d417a7109a8f7d99b16546c8951583ada5ef56b9d79ab7d25940"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "甲木赖水生之。但甲阳木，柱梁也，无根草。壬，阳水。水多木浮，恐有漂流之失，故曰平生不足。乙阴木，有根草，只宜阳地，不宜阴处，癸为阴水，故曰处世多逆。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0144",
      "sha256": "bb62e9a4b0281dbf6bfcb4c824bc7db7982fd64268db332d15996b529affde81"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阳自败兮，丙为甲伤。阴不明兮，酉缘乙制。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0145",
      "sha256": "fbb4e0c04b97e5f112294dbfe48785bfdd0b1b61fa8a14bcc79e39e49d374389"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "此言母受制於人，则不能助子。丙火赖甲木生，以为光明照物。但如甲木受制于庚金克，则不能生火。同理，乙木受制于辛金，则不能助丁之力。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0146",
      "sha256": "d6d052e3c5e23a4e55a8ba87eff6c7c375acdfadc4d8e139dfb5cc64fc2efe20"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "上之淩下兮，戊遭丙食。卑恐欺尊兮，己伤丁炎。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0147",
      "sha256": "de6af894fbea237c631e59eb7e0dfb92e75220eacd3451011ab2d55d139678b8"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "戊逢丙，为偏印。己逢丁，亦为偏印。无制，为倒食。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0148",
      "sha256": "1678f3e3ebdb39027799ed9ad0305b9d0c4bab0c04cc46a9acfe8a12743b4b95"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "阳禄嘹唳兮，戊土晦之。辛禄卑薄兮，己阴破之。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0149",
      "sha256": "9d0c25e6d9f8f2cfb6c849597448511586727731b6b01756f8f68d49c2b21680"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "此言庚辛之金质，因戊己土多，而埋没其美质，不能显达也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0150",
      "sha256": "5df7ce0eaa76fc7786f76bd5fc0b2a9fd7188dd0a964f11f19bb8cddcbe46adb"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "失之于智，皆因庚祸於壬。丧之于权，每逢辛伤於癸。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0151",
      "sha256": "ff785fdaea55c9f943612ad4f09ccc07b664d4c8a04259b70d2eec3a25be3606"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "此言壬癸之水，因受庚辛所扰，犹人多一母，抚其一子反为害。故智权失丧，不得自专。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0152",
      "sha256": "84fc94eab826c4f71a053fab807fd30dd085af89b732b00d1eebc92c176bccaf"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "甲乙常忻戊己，乃为生丙之财。丙丁尤喜庚辛，实是生戊之福。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0153",
      "sha256": "c13abeb1e1ab70b425018f5ad985bf5fb696fbfc99ebd0bc15441883db0caf5e"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "甲乙木，以戊己土为财。丙丁火，以庚辛金为财。乃生成正理，故安享之。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0154",
      "sha256": "c1ec95501dac50e3b6296023c0e40945fefa51096e5aca9d07aec6bc981748d9"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "勾陈得地，戊归壬乡。阴土逢财，己加癸位。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0155",
      "sha256": "600da50a84a486ec84c05e27b49c54a99a9e2420dc8dcd78822ad4f39a4f17f5"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "勾陈，戊己土也，以辰戌丑未而得地。戊阳土，以壬阳水为偏财。己阴土，以癸水为偏财。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0156",
      "sha256": "5d88933b9b56718b4163b4a63ed3a51471f4364cb12b978ba4c4e7839b225901"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "庚辛寅卯，亦然而福寿。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0157",
      "sha256": "9feacb6fe41da9c99afb0fc77f531eeab33078c271d3adf8345f7796c35d5913"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "寅卯，木旺之乡。庚辛以甲乙为财，自然福寿。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0158",
      "sha256": "3a9c358a53cf3d5f0b2d6fa0526468073daa939b800fdc40181447159f20c20c"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "壬癸丙丁，喜永以无虞。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0159",
      "sha256": "32815ece3464b7cf3006cf157484f9b1f03d2e8d160ca0807035ce58b73a80c1"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "壬癸水，以丙丁火为财。亦得其自然之用，何其有不虞之患。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0160",
      "sha256": "5c71aca66a591262db373d680a6a9b250c5d8fba76d77a888550a331b80a8ee1"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "当知我害彼吉，彼害我凶。自深以直而言之，消详为可矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0161",
      "sha256": "04de66accdd3eb8684d8d2f750b18726cbac0deaaaae5549e18c777b5710b55c"
    },
    {
      "section": "一行禅师天元赋注解",
      "text": "我克之，为财地。彼克我，为煞也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c295:p0162",
      "sha256": "f6ca508e100f096f74a6b77dc406d22361dc426ae647635aa0abc9041fce7eed"
    }
  ]
}
