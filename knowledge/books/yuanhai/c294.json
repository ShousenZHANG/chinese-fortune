  "raw_path": "sources/yuanhai/c294.html",
  "raw_sha256": "ea0f91bf53e4b09cf8295c2a2d8726bdb866848291a2e21226b08220bfaa4cd9",
  "raw_kind": "cleaned_original_transcription_not_complete_http_response",
  "extraction_kind": "selected_original_html_node",
  "issues": [],
  "passages": [
    {
      "section": "金声玉振赋",
      "text": "渊海子平卷六",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0001",
      "sha256": "222a11cf776cbb806f37292c1b03f7e25c110d85b0768baf1ed10f8923622000"
    },
    {
      "section": "金声玉振赋",
      "text": "金声玉振赋",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0002",
      "sha256": "73900fa013abc79a585bad61c7791cf2dc91f0d5faea8853b8223ecf5bd87478"
    },
    {
      "section": "金声玉振赋",
      "text": "受命之不同也，有如受形。测理之难精也，过於测海。阴惨阳舒，知盈虚之有数。天高地迥，极覆载之无疆。或升之云汉兮，而非有所私。或坠之渊泉兮，而非有所恶。其气数定于太初，其培覆譬诸草木。妙诀不在於多言，至人奚事於强聒(音同郭)。且如类属从化，格判旺衰，照伏拱遥，局分明暗。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0003",
      "sha256": "637364f75af76b64b92967ad2f5f2624bd19b8ee016a7b060634fcbc5af1142f"
    },
    {
      "section": "金声玉振赋",
      "text": "见类属要旺，从化要衰。照伏二者，皆取局於明。遥拱二者，皆取局於不见之形，故谓之暗。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0004",
      "sha256": "63a319687a1ce53b8a2735038c831bed94280f33f9ed73e6672026fd3916d457"
    },
    {
      "section": "金声玉振赋",
      "text": "论用神论日主各有所宜，取地脉取天元是或一道。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0005",
      "sha256": "4b141cec4689013310e22d24261448d4826bbbe2c80eccafaa7ed779eec51273"
    },
    {
      "section": "金声玉振赋",
      "text": "此泛举谈造化者之非一端也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0006",
      "sha256": "f4691b1ad7cfe3938d52e5d9488cc64e9d468267c90d49e0708ee10d0aa6ead7"
    },
    {
      "section": "金声玉振赋",
      "text": "游心于去留舒配，决意於喜忌爱憎。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0007",
      "sha256": "f50c894ebd6e736c8472d47a7119931464519c530fb816d90f0737f42c4cdbd0"
    },
    {
      "section": "金声玉振赋",
      "text": "此约言谈造化者之无多术也，中间妙理则不能一言尽。如论用神、论日干、取地脉、取天元，喜忌爱憎，万有不同，若不去留舒配，何以成造化而分贵贱，谈性命而决生死，所以当游心评玩，决意专察也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0008",
      "sha256": "2c156f670779ded66bf68e21cc2b60bdb0fb693d81fba4177d554e57940450b2"
    },
    {
      "section": "金声玉振赋",
      "text": "亦有源浊而流清，岂无根甜而裔苦。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0009",
      "sha256": "23c492f6b4930a069fbc1ef87964f7a401ad0d422f2c0aee91f8cca630b49b8f"
    },
    {
      "section": "金声玉振赋",
      "text": "如水生於土令，其源本浊，运行西北，土化金，金化水，其流不亦清乎。若此者，先主凶，後主吉。《洪范》曰：稼穑作甘，炎上作苦。木生土令行南方，根甘裔苦之谓也。虽伤官能生财，然木不南奔，何以任之。或谓此二句总喻五行命运，不专指木火，亦通，但异乎吾所闻。观珞琭子有初凶後吉、始吉终凶则是譬喻，此则直言其理耳。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0010",
      "sha256": "3f3f7a06c1dd3c4333a8000f39aee4bdecea23c0e9c458dafe97ccb529d3a89c"
    },
    {
      "section": "金声玉振赋",
      "text": "鸳鸯比翼，见江湖必遂平生。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0011",
      "sha256": "d52510541e38efd5c4fcbba593c2a20958a7f6a432bd320402c997a57b122c99"
    },
    {
      "section": "金声玉振赋",
      "text": "如丙戌、辛丑、丁巳、壬寅，丙辛合、丁壬合、寅戌合、丑巳合，若鸳鸯之比翼联飞也。有壬水在柱而又丙辛化水，是江湖之家，可以遂其栖迟之性矣。或曰：鸳鸯比翼，只取其两两相合，即德合双鸯格也，江湖字不必拘。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0012",
      "sha256": "26c89dbea5bbc60c0149cae97618931bd0090ca6c63b47760d4113fa2eae8e3b"
    },
    {
      "section": "金声玉振赋",
      "text": "蝴蝶双飞，逢园囿方为得所。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0013",
      "sha256": "d0bedccd389cf946bdf187d73ba8c8dacf781c0b7220e3280f92dcc0c4d1aed2"
    },
    {
      "section": "金声玉振赋",
      "text": "如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0014",
      "sha256": "b27f740b14fe3f5b2b622ce486a5e756d80850ff47c34a0dc365016b4737cd9a"
    },
    {
      "section": "金声玉振赋",
      "text": "辛未 戊戌 辛未 戊戌，未为木库，戊戌纳音又为平地木，乃园囿之所，故合格而贵，若无一点木气，岂非虚名虚利之人乎。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0015",
      "sha256": "95870e8fe5888d144a83d20a842fc201b06e11442b2d19c4bed7819700652af5"
    },
    {
      "section": "金声玉振赋",
      "text": "采精金于青沙黄碛(音同气)，别利器於错节盘根。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0016",
      "sha256": "e801c87002ece5d5bef063a3eef0a6a07fcac05000590075abf62f732bc03a65"
    },
    {
      "section": "金声玉振赋",
      "text": "甲午日见己巳时，乙未日见戊寅时，盖甲午、乙未本是沙中金，而戊寅则青沙，己巳乃黄碛也。甲乙生卯月木旺之时，柱带壬申、癸酉剑锋之金，正合此格，余金则非。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0017",
      "sha256": "505236706a21f0af95b728de5cb972eb0f1b5a17707aee8a5f315b8ccca4bb36"
    },
    {
      "section": "金声玉振赋",
      "text": "我生者岂若生我者之为安，克我者曾如我克者之为显。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0018",
      "sha256": "39e12cd1e8563253800a7a18fe3ca397a3b92f8431bf6c5ebb92a1b0fafc07b5"
    },
    {
      "section": "金声玉振赋",
      "text": "此言伤官不及印绶，用煞不如用财也。盖伤官七煞虽或大贵，然多有得其祸者，弗若纯用财印为享自然之福也。或谓用财似止于富，不曰财旺生官耶，故用财者制人，用官煞者制於人。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0019",
      "sha256": "f4306f4ec78ca3237c5fe4e1ee95d198c26cb5873227c7be16d13b6989babe2d"
    },
    {
      "section": "金声玉振赋",
      "text": "如逢既济未济，休疑冲并休疑无依。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0020",
      "sha256": "966065c3b5dfdc54aeb336dde8cd0885ee52cc05a23d708480fc33c2fee86bf3"
    },
    {
      "section": "金声玉振赋",
      "text": "如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0021",
      "sha256": "b27f740b14fe3f5b2b622ce486a5e756d80850ff47c34a0dc365016b4737cd9a"
    },
    {
      "section": "金声玉振赋",
      "text": "壬子 丙午 壬子 丙午，既济之格也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0022",
      "sha256": "615c939754a001f7d42d6b25bd5209052e6c19bf5d2a702a5b528815a50ef438"
    },
    {
      "section": "金声玉振赋",
      "text": "丁卯 丙午 丙戌 甲午，未济之格也。二者皆大贵。如以俗眼观之，则前一命嫌於冲并，後一命嫌於无依矣。或以未济以火在上，水在下，柱中太旺为解，即聚精会神之格也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0023",
      "sha256": "8784d20372a83fe960e9413aa9279ef336d2cfce3e1d1bae03d36ccf12c0a934"
    },
    {
      "section": "金声玉振赋",
      "text": "内有三正三偏，不必生扶不必透露。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0024",
      "sha256": "a9bfffe4f332c8c6ed99b9643885ba7fbd82cebf96c86dbf2fc0aff6eb9aa4e4"
    },
    {
      "section": "金声玉振赋",
      "text": "六壬生四月，巳中戊为偏官，丙为偏财，长生金为偏印，故谓之三偏。癸生巳月，则为正官、正财、正印，乃三正也。水虽绝巳，金长生则水不终绝，是以不必生扶也。翕(音同细)聚则气专，发散，是以不必透露也。或以生扶指财官印言，若日干衰弱则不可不生扶耳。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0025",
      "sha256": "13d4fbb36ad82ab5a218770b191a4de5f316a73f33ff2a36dd205c8a8d435a58"
    },
    {
      "section": "金声玉振赋",
      "text": "奔道途而丧生，盖因秀气繁乱。坐囹圄以亡命，只为比肩争斗。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0026",
      "sha256": "b586c837eb93ec23972bd7f2897beff20181321de506525ca2cf5a5f8fcb11ff"
    },
    {
      "section": "金声玉振赋",
      "text": "如一甲三寅、一丙三戌、一辛三丙，禄库官星太多，无秀气也。如三壬一亥、三庚一丑、三己一甲，秀气不胜其分夺也。余仿此。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0027",
      "sha256": "789e156ebc70c62af1d790876cc61dfada52091fd5ad50e237da16ef1f793b45"
    },
    {
      "section": "金声玉振赋",
      "text": "刃重官轻，业屠沽於市井。马疲印破，弄刀笔於公堂。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0028",
      "sha256": "f9dafa59578f31a59591c569935278f55bc3f0308974b291f7b5d40874e83fa5"
    },
    {
      "section": "金声玉振赋",
      "text": "官星带刃本贵，官煞失时而刃用事兹，其所以贱也。凡遇此格，断为屠沽无疑。如寅午戌马居申，有刑冲破害则马疲。甲木以壬癸为印，无庚辛金生之，而有戊己破坏，乃吏胥之徒也。或云，马指财言，疲，病也。财临病地，谓之马疲。考珞琭子马疲注，王廷光以前说为是。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0029",
      "sha256": "9cdd4623e1689ba545ab8196cf130fcd1fcd26d56bf6d530d8388ee1208b7dff"
    },
    {
      "section": "金声玉振赋",
      "text": "三奇再犯辰戌，作斫削裁缝之匠。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0030",
      "sha256": "69dee23e70b08c6032f66477509e90a9d3b7f5e4ecddef438d55f4add621ae13"
    },
    {
      "section": "金声玉振赋",
      "text": "地三奇甲戊庚，天三奇乙丙丁，人三奇辛壬癸。干得三奇，地支有辰戌相冲，乃贵反为贱之造，遇此者不作木匠营生，即为裁缝度日矣。遇寅辰则不然。或戌有合，辰有合，各分二局，则水火既济，亦不然也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0031",
      "sha256": "62dd0bd9c9ff5a1f0ce8e4358e00a52608e268b599327bc47f06e575103034c0"
    },
    {
      "section": "金声玉振赋",
      "text": "四柱尽归禄位，为眉寿景福之人。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0032",
      "sha256": "a2bf14244e25b0ba1425b18dbff8e6a432e8782aedc5f3591b86febd4da3ec34"
    },
    {
      "section": "金声玉振赋",
      "text": "如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0033",
      "sha256": "b27f740b14fe3f5b2b622ce486a5e756d80850ff47c34a0dc365016b4737cd9a"
    },
    {
      "section": "金声玉振赋",
      "text": "丙寅 甲午 乙巳 己卯，丙禄居巳，甲禄居寅，乙禄居卯，己禄居午，天干各有所归，此人一生富而且寿，即《消息赋》享福五行归禄，眉寿八字均停之意。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0034",
      "sha256": "31ce6052b5f3a0e21f8d4ec1cca4fb3f75a724df23069a40ba5e1ac4d7747b90"
    },
    {
      "section": "金声玉振赋",
      "text": "木衰火旺复行西，天年夭折。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0035",
      "sha256": "9231682a06b01fea9d0d5c84dd8235ec24cdc8ceffb1a8f89138fbddeec2afd3"
    },
    {
      "section": "金声玉振赋",
      "text": "如甲午日生四五月，木不南奔，又见金砍伐，宜夭折也，行东北运则否。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0036",
      "sha256": "22380df3d80dd88813207e414580f1e26b4a838c7b26a93392e8d5a14836818e"
    },
    {
      "section": "金声玉振赋",
      "text": "水冷金寒兼拱北，身世浮沈。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0037",
      "sha256": "d6dd948b10df84cda8af934577f09fbff22aefd14ec53d32e512b87e07a3d563"
    },
    {
      "section": "金声玉振赋",
      "text": "金水伤官，只宜东南运行吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0038",
      "sha256": "603436c40dd965ff29f82e12062988ffda6796e4eea3a61934fdfe609ff20fe8"
    },
    {
      "section": "金声玉振赋",
      "text": "甲春乙秋，偏宜官煞重叠。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0039",
      "sha256": "afe6e832d57437e8975fbc8110aa3f7ba488f830ea4cdc525aee4b3e0700f0ab"
    },
    {
      "section": "金声玉振赋",
      "text": "甲生春木旺，赖金斫削方成器。乙生秋，或化或煞，皆吉，是以宜多煞。假若甲生秋而重受克，必主大凶，乙生春而煞多，亦不宜。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0040",
      "sha256": "26e483f0097d8a3aba65d96d377085c2683f6be5138c05a7e46b2065bd0180fc"
    },
    {
      "section": "金声玉振赋",
      "text": "丙火卯月，难资印绶生扶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0041",
      "sha256": "e5257550a091d82e9d9fce93771c554d389e5715feceb963b853ca6c2ca360ac"
    },
    {
      "section": "金声玉振赋",
      "text": "湿木不生无焰火，理固然也，乙卯、癸卯尤其，丁卯庶几。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0042",
      "sha256": "be86e19f230049344991459214727e1ed290a4d9e1fbc130fd7c1576daa9b0e8"
    },
    {
      "section": "金声玉振赋",
      "text": "水繁而不制，病生於膀胱。金繁而不化，疾在於喉舌。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0043",
      "sha256": "9ac6248555aec041b5ba225a06118c7a5f17f763d339fd90a587e2bdae0c9c45"
    },
    {
      "section": "金声玉振赋",
      "text": "水属精，金属声。水失堤防而无土制，则其人淫，水多太泛也。金太坚刚而无火化，则其人哑，金实无声也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0044",
      "sha256": "acb89c8c5fb6da83034bf2298b3054409c455f1b7f49a99822bb85af1c9fe128"
    },
    {
      "section": "金声玉振赋",
      "text": "财官双美，透露极荣。一云：遇印极荣。火木通明，见土则贵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0045",
      "sha256": "cee89ac4b8f1224d7af1fd02f2083fad2b723710c6d2ab6bf33118feb6989cee"
    },
    {
      "section": "金声玉振赋",
      "text": "财官双美，是辰戌丑未月生或壬午、癸巳等日，固宜财官透天为妙。木火通明，须春生最吉，土所以宿火培木，故须见之方贵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0046",
      "sha256": "3e9e25e09abeea144f494236f4782811774dc9e3c833c84b4c203995ee755279"
    },
    {
      "section": "金声玉振赋",
      "text": "壬趋艮甲趋乾，须以财印助福。子遥巳丑遥巳，亦以财印相成。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0047",
      "sha256": "e03f2f585bcd5f8779e09bbc64cb85338fd8a6b5c040ac03ce3a6a7cec3e12d8"
    },
    {
      "section": "金声玉振赋",
      "text": "以上四格，皆赖财印辅佐而始大贵，不宜见官煞。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0048",
      "sha256": "4229c1427a28cd4d69a480b85c005a3069ff7c9301f089849ad0b4d5edf69c1f"
    },
    {
      "section": "金声玉振赋",
      "text": "三奇伏岁支之下，少入翰林。三奇在时位之间，晚归台阁。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0049",
      "sha256": "3301b9f618aee06bfe25d35e3bf7410ca4454dcc2b7907b2fe1f7d9760782d58"
    },
    {
      "section": "金声玉振赋",
      "text": "如六甲日主见己丑年者是，己丑中辛金、癸水、己土为财官印之三奇也。如六丁日见辛亥时，亥中壬水为官，甲木为印，又辛金乃财也，遇之岂不居极品乎。夫三奇一也，而贵有老少之分，以年先而时後，年近而时迟耳。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0050",
      "sha256": "95330aab6732a21f63bde0be0f86f5801ccddbde96ebd654109bf23fc545f34e"
    },
    {
      "section": "金声玉振赋",
      "text": "官星得令，制伏诸凶。贵人扶身，解脱百厄。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0051",
      "sha256": "bf3fa5774f46fbafb10dcae98e0399203866c0bf0076949b4594d1ce1ee38905"
    },
    {
      "section": "金声玉振赋",
      "text": "此言命中有官星贵神不忌凶神恶煞，盖邪不胜正也。须得令扶身方准赋文，若官失令受伤，贵人散漫生嗔则否。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0052",
      "sha256": "be841889533ee48f322a89f3bf0e5cc09f8e7d060d9e6acb18855e483977a672"
    },
    {
      "section": "金声玉振赋",
      "text": "煞刃两现干头，定受言责之寄。一遇刑冲岁运，恐蹈不测之危。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0053",
      "sha256": "0d7ecd5df5b56c882b20c909fc69e172a6cef9e356f3e97d009f8ca653369797"
    },
    {
      "section": "金声玉振赋",
      "text": "煞刃为权星，刑冲最忌。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0054",
      "sha256": "078796c3c71dd5cb1153b5d2cfd6c23b4a9ddc53d520b73c7df626eaa2b1f031"
    },
    {
      "section": "金声玉振赋",
      "text": "丙临于申，戊当头面贵拟王谢。辛骑羊兔，乙透出而富比陶朱。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0055",
      "sha256": "a31b129bff7e86d7d17d071599e9a9b6ab6da57e62d799ad569ccec197177774"
    },
    {
      "section": "金声玉振赋",
      "text": "贵以食神生旺言，富以财星禄库言。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0056",
      "sha256": "c625b7a258cff789a6c06f500977161b0aa6bb4907fe8cee5a940a9a6628f777"
    },
    {
      "section": "金声玉振赋",
      "text": "八月官星见子辰，合来暗煞。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0057",
      "sha256": "826fe3b57668ae7ff343937caa3c7ae306878ca84d7c58e045f55799bb9140a7"
    },
    {
      "section": "金声玉振赋",
      "text": "假如甲生酉月为正官，岁时下有子辰，则合出申金，斯为官煞混杂矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0058",
      "sha256": "4551ddf240c06bf2672ce69ee22bb4cc580783d18adb52ca58bd530130c69c81"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "三春丙火逢猴鼠，化作正官。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0059",
      "sha256": "bbb118dae9fe4bd813f695962581fabc540165122233699b7a9ad7e49218a04b"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "丙火辰土本是食神，有子申会成水局，非官而何。此二句乃不见之形。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0060",
      "sha256": "73857bb4e8e43e3e7abedb353b02fbbd037b4975e872423b3c12b0ef192c0012"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "金水固聪明，有土反成顽懦。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0061",
      "sha256": "4995ce6b4245b8a5dc10abef92cdfa0f15975ff5141ec15aed0b7e30e6582be7"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "土能浊水埋金故也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0062",
      "sha256": "53a4f924720da181592686b7de18597a7a4d840f7cce47efb737e8cd04908fbe"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "枭食虽贫夭，得财忽变亨通。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0063",
      "sha256": "bb6b6ad33bc3e0b0eba77081df7c3ba7d196bbc0ccba13f5023f9690003be131"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "食神乃财源，又为寿星，枭神破之，贫夭无疑。一行财地，逐去枭神，凶中反吉。凡入此命多依他人取富。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0064",
      "sha256": "4dc08f05f4a256e8edf01fdf9e8c63959dba4fa2ea1e29f2c9fe4eb4ea3846a0"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "六乙鼠贵，爱见食神。六阴朝阳，何妨肩劫。会神带煞入乌台，偏官带刃居宪府。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0065",
      "sha256": "6d8e99a22c1d9c752d23ca3c31071d5577e932d9a7f8f8170373d2ed8639c900"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "金神羊刃皆恶星，喜官煞制伏，人命得之为除奸去弊之象，故断居此之职。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0066",
      "sha256": "67382eca27dfef9444540392c4f60cddd30ebabd4028378192448273dbb0bc6d"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "戊土叠临寅宫，喜财而不喜印。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0067",
      "sha256": "abfc0dcf434fd9c0041ac349f2c5fbea4079c23436e2bc6c63b591d512f51cb6"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "戊寅虽坐煞，实长生地也，见火勿泥煞印，是火蒸焦土。喜财者，财生偏官，官为有气耳。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0068",
      "sha256": "5b3d9e163aa65d5ccb72fcfa7b0d09c4b4004fff275323b2e2e39325c078c1a0"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "壬水坐下阳土，透煞慎勿透官。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0069",
      "sha256": "8b704badd2883b133e761b4a1afb72f8ad2e20aefc26f96ae2d11c2f92296673"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "水固赖土止，亦恶混杂也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0070",
      "sha256": "883e8a878ee3dfe24af6df3e5b5328af7eab5b447cac6210e076085f3356e453"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "偏财见官兼食神，荣华有准。身主用神或入墓，进取无绣。木火相照，胸中万斛(音同壶)珠玑。金水相涵，笔下千篇锦绣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0071",
      "sha256": "c7c5d7c7cec78682bb9df299f7846ccfd988a3126a367d5a0d350b31918ed862"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "此格见前，重举之以明其才华之卓越。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0072",
      "sha256": "b1ba42c1ac2c40b4cda0596f73f2f97520606db04751cd9650c6bf757756d88f"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "三刑失合，破相伤躯。六害多逢，辜恩负义。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0073",
      "sha256": "9ee3cf2ff3f461840e40d729b87393bbc5444b7af9fc4f926a8fe6c2e93686c6"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "凡命三刑，若有合则不成刑，如人争斗而有和解之者，不然准免此患。带六害多者，为人则以恩为怨，忘恩负义之流也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0074",
      "sha256": "865c45d43b3a8605eace0c56162f78796b4828709c74d42ab3c8237731120e43"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "空亡却损于妻子，隔角难为乎兄弟。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0075",
      "sha256": "828d59d5559572e3586314912bc7e77a0da5d0da73a58b0be62ae6f5b460d019"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "空亡如甲子旬中无戌亥，隔角如丑寅乃隔角方位也，日时见者重。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0076",
      "sha256": "45111d233ee00f9995af83b55fd78aed7c1fa6c24038ec51d30d0d95d2b8e274"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "壬骑龙背，带刃者类乌获孟贲(音同奔)。庚坐戌支，火多者是邢侯雍子。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0077",
      "sha256": "d204e87d56bdbdc9be2bd0684ea98b86d3a82297d12da90012a633f9d6179905"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "辰中有龙，阳刚之物也，更逢羊刃，膂(音同旅)力绝人矣。经云：辰多好斗。戌为火库，庚日坐之，再经火则锻炼太过，其为无情甚矣。况其中藏娄金狗，此宿乃狡猾之物。经云：戌多好讼。邢侯雍子，在春秋时争鄛田者也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0078",
      "sha256": "f64da672765d9fa8ad148351b00b2a12ed90e9f338b5695d58d6f520dfe26914"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "满路异香，富而好礼。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0079",
      "sha256": "4b91216f05e444aaaca483c7eb9113430862a55d68b525542dff18b2c852072d"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "年月日时之天干见地支四位贵人者是也，如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0080",
      "sha256": "72700334be8046d8d88f41366be6cdb8ed97b6c152a669ed499661cd5c8a08e7"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "壬申 辛亥 己巳 丙寅，壬以巳为贵，辛以寅为贵，己以申为贵，丙以亥为贵也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0081",
      "sha256": "a30cae428b5fde0ba4b75e2a09e4b64759769fc72bda3a288d2a36d06969a424"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "一旬和气，乐以忘忧。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0082",
      "sha256": "8946c84ffa17c26aaac2f61c75fcd621a0ef1b6a07566491524f78615ee0d128"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "年月日时共出一旬，如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0083",
      "sha256": "8f9562403335a040867878f90da29bd0401bb64a86a009d330adbfbf929f1162"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "甲子 壬申 己巳 癸酉，俱出甲子旬中也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0084",
      "sha256": "fd17358676f55e5654d8d2600993dc6d960dd40ea91a0d1de8c12c37c1a2b322"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "归禄爱财星，见官则损寿。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0085",
      "sha256": "34dd1a5d22f3d47f2e2c2089e985e635b4df0e0b437c4c9374aa60f51ce85ec4"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "财为养命之源，归禄之格，身旺爱财，直忌官星，窃财气故也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0086",
      "sha256": "a7b69bfb282d9193932dfae481c5caf21e76130390ab904d3290023a9edc7b1d"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "正官得时令，有印不如财。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0087",
      "sha256": "17898ecbfbafa0ef1cd15d37f8cb9a59d6cb7c4e7fbad99cbe289bbecbaec1e6"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "官印固妙两全，苟无财星，官失其生意，印亦何用。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0088",
      "sha256": "aba5a095cf4d8eb210e43033d6858e17c567566ed682bca7736063c42540b761"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "从革复出乎三奇，血食迄千年而未艾。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0089",
      "sha256": "1ee82017e04617b87892612298c25e864f79dbc15318c4a06d05c83841f0d92a"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "日干庚辛，地支巳酉丑或申酉戌全者，乃从革之象。庚日干头再有甲戊，辛日干头再有壬癸，其人死当庙食於百世矣。何以言之，夫金之为用也刚而其为质也固，刚者义气之发，固者可久之道。人之秉义者，生为忠臣，死必为明神矣。此理可与达士论之。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0090",
      "sha256": "3110271877244f90fbcc80acc924a501719be7511f3684111a87c495e9bd914c"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "曲直兼资乎印绶，仁声播九有以无穷。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0091",
      "sha256": "42e780fa2f703c7f751b426eaaf876655bf55630933e0d19a232b8c1e515b8b5"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "曲直者，木象也。甲乙日主倘见地支寅卯辰或亥卯未全者是，更逢印绶之相生，其人必有仁心仁闻矣。以理推之，仁者天地生物之心，於时为春，於五行为木，是木者，有生意之物，而仁者实好生之德，更逢印绥，则生生而不息矣。得之者，泽被群生，恩沾黎庶，故曰：仁声播九有以无穷。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0092",
      "sha256": "6ac2539ac510655d59b080029921f97c0ff5088a7cc699526d16fcc40105f727"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "地天泰，故斯人挺生。云雷屯，则经纶显设。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0093",
      "sha256": "e1f7615fb2ce14cf41a409b84accd365d02360da83e099ed8911d7cc55d1b94b"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "此指上两格之人，其生也，既有所自而不虚生，其出也，必有所为而不苟出也。或云：地天泰乃戊申见辛亥，云雷屯乃壬子见己卯，即妙选地天交泰、雷雨迎春二格．",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0094",
      "sha256": "f7917799ca955a4d473ca34156cdef556d24d4ccc18ed83cac5beacc974295ea"
    },
    {
      "section": "金声玉振赋 / 三春丙火",
      "text": "是知术数无穷，实则不遗至理。言辞难悉，吾特举其一隅。显微阐幽，遵彼往哲，引伸触类，存乎後人。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c294:p0095",
      "sha256": "a11955307fdd45118c803c0cef5985bf65507573004c4eb54e83ecce3760c716"
    }
  ]
}
