  "issues": [],
  "passages": [
    {
      "section": "偏财诗诀",
      "text": "渊海子平卷五",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c221:p0001",
      "sha256": "d284d3c59105f6347a605b7d9c7a48dc5eebdc667d0b53daee688840ad6bd8a9"
    },
    {
      "section": "偏财诗诀",
      "text": "偏财诗诀",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c221:p0002",
      "sha256": "d2d1c61dcb9e43af520ba3d58bfe4430de3bc2930aeb91261dd8f56c4cc6fcab"
    },
    {
      "section": "偏财诗诀",
      "text": "偏财身旺是英豪，羊刃无侵福禄多，结实有情宜慷慨，若还身弱慢徒劳。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c221:p0003",
      "sha256": "b962b756f7296bc6255c024913810e13dedf582ee48c34f4aad9a9fb470f22ca"
    },
    {
      "section": "偏财诗诀",
      "text": "月偏财是衆人财，最忌干支兄弟来，身强财旺皆为福，若带官来足妙哉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c221:p0004",
      "sha256": "ea36b3100f19d7d733c52ef6c18dd9ba7e13589230241cee43c77c2f4d3e89cf"
    },
    {
      "section": "偏财诗诀",
      "text": "若是偏财带正官，劫星须露福相干，不宜劫运重来并，此处方知祸百端。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c221:p0005",
      "sha256": "ac01d99227cec6e0ee6684941a3dec78cbbbe3f8b81b2fdee3b920ae7ca603d1"
    },
    {
      "section": "偏财诗诀",
      "text": "若见偏财遇劫星，田园破尽苦还贫，伤妻损妾多遭辱，食不相资困在陈。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c221:p0006",
      "sha256": "a18e44b9bd80f039f03e2411dfc26c6fb654dbecd2b14e868ca03ee42c740b29"
    },
    {
      "section": "偏财诗诀",
      "text": "偏财身旺要官星，运入官乡发利名，姊妹弟兄分夺去，功名不遂祸遂生。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c221:p0007",
      "sha256": "2120dab8acac7c6d74043245de8338acc3c4948d760af6d08fd6aabadf012da5"
    },
    {
      "section": "偏财诗诀",
      "text": "补：",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c221:p0008",
      "sha256": "ad592f8b264aaeddf8801e317f934c68fd9278174ad0fac30c18e20ba79ba084"
    },
    {
      "section": "偏财诗诀",
      "text": "偏财格遇最难明，日旺却宜高路行，一世因财人谤讪，财多身弱惹灾生。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c221:p0009",
      "sha256": "c95c39ad136d05aa280976a68005702fde8483b67bca94bbc4e3872143abf7c6"
    },
    {
      "section": "偏财诗诀",
      "text": "偏财非是自己财，最怕比肩同位来，劫败不逢日主健，家资当发孟尝财。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c221:p0010",
      "sha256": "af693a94b1278e5577465a1fe99c4349caa4be9c6fde5cf513abe79523ebc898"
    },
    {
      "section": "偏财诗诀",
      "text": "偏财偏位发他乡，慷慨风流性要强，别立家园三二处，因名因利自家忙。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c221:p0011",
      "sha256": "5c978dae612f1a56fe53e9c24f2e8fa7540fc1ec669809530f1b3e3f84477275"
    },
    {
      "section": "偏财诗诀",
      "text": "偏财别立在他乡，宠妾嫌妻更堪伤，多欲多情妻妾衆，更喜村酒野花香。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c221:p0012",
      "sha256": "f5e1a8cbd70f65b780e2557629200b6dd902fe741a89fb04483baf87fd88295c"
    },
    {
      "section": "偏财诗诀",
      "text": "眉批：偏财主外方财，忌兄弟姐妹分夺其财食，若身旺财旺极其富矣。“陈”，国名，孔子过坼，匡人困之绝粮七日不食。逢官看财，财为官之禄，须得官以享之。凡弱，劫财羊刃如印，乙日又见甲乙或行甲乙运。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 94,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c221:p0013",
      "sha256": "bf3acd23d9318346b6d7ef3461747f5ea19f464c09af77ddbde77c59b42922e3"
    }
  ]
}
