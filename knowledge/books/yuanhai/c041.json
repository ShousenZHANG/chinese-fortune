    },
    {
      "section": "论拱禄",
      "text": "假如戊辰生人见丙午，丙午生人见戊辰；",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c041:p0003",
      "sha256": "507df9282c60d5081d63552288d5fbf7113d2b8070252ef21b26973c944f7e0d"
    },
    {
      "section": "论拱禄",
      "text": "丁巳生人见己未，己未生人见丁巳。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c041:p0004",
      "sha256": "e3a6163c077f5bd81cd4764c14e76ae10d5c7e8f05b49a4d512a6842d0f25a33"
    },
    {
      "section": "论拱禄",
      "text": "前後相拱，只此四位，其余不是。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c041:p0005",
      "sha256": "c8c01260de8df5a987b57100b3e7a9eea136224f47a027ce6db41a3aeb4d980a"
    },
    {
      "section": "论拱禄",
      "text": "眉批：戊丙禄在巳，辰午虚拱巳禄，忌见填实，只要虚为贵。",
      "layer": "historical_commentary",
      "commentary_spans": [
