{
  "book_id": "yuanhai",
  "chapter_id": "c180",
  "title": "寸金搜髓论(搜髓歌)",
  "source_url": "https://luckclub.cn/bazi/001/180/",
  "revision": "sha256:bfcc82a2a753941307e09beb5bab956a04be38e2831a296acc180f22b95c26fa",
  "source_timestamp": "2026-09-06T04:10:59.929360+00:00",
  "layer": "historical_work_transcription",
  "facsimile_status": "not_checked",
  "transcription_status": "acquired_not_collated",
  "raw_path": "sources/yuanhai/c180.html",
  "raw_sha256": "bfcc82a2a753941307e09beb5bab956a04be38e2831a296acc180f22b95c26fa",
  "raw_kind": "cleaned_original_transcription_not_complete_http_response",
  "extraction_kind": "selected_original_html_node",
  "issues": [],
  "passages": [
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "寸金搜髓论 (搜髓歌)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0001",
      "sha256": "3dc0d5f22183dcee860f8ef305dc2c120e47298442576d619ee1ff76794792f7"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "造化先须看日主，後把提纲分次第。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0002",
      "sha256": "fb6a80479a1e8b01a8b23a12f0e6cad96a31719db66641e82650811df0237b64"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "四柱专一论财官，身旺财官多富贵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0003",
      "sha256": "8f8911ce18e0020561cf4c1caebeef13fc2f1eef8883e343f57f673b16c90096"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "若还身旺财官损，只是朝求暮讨儿。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0004",
      "sha256": "e382fcc672d82916908b65a5c68605c9ee12bcbcf08d8f92789173e75603b2c1"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "财官旺时日主旺，紫袍金带有何疑。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0005",
      "sha256": "1099f9ce9e5b5c624564d86b934f1536a23c1f3e6b0f607a13e155c4635ccfac"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "财官旺而日主弱，运行身旺最为奇。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0006",
      "sha256": "7dc55e55d43254e118129efc06307210dd75c603d9441a96f7a414f360e7b071"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "日主旺而财官弱，运入财官利名驰。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0007",
      "sha256": "cecd0a55aab0f0ae0f339226c9942418538207b22d6276eac6522c44c5f9a182"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "日主坐下有财官，月令相逢贵不难。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0008",
      "sha256": "3b9c8a4011473808ec82f587bfc2e1356e0f631749928fc4ef66ea2ba6ea3581"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "总把财官为紧要，早年富贵禄高攀。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0009",
      "sha256": "86adcd65372e7e56f37497ef0edf57777221715c4f1b6ddefcd1f72867cc9c86"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "身旺无依更迁祖，不迁居死在外地。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0010",
      "sha256": "e765d9bdf4587b75119b0d70adfc74b42fc56b56abcb4bfd2bafe595b961bdb8"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "财官微薄身太旺，太旺无依受孤寒，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0011",
      "sha256": "262ff31c9b5e45dea880ae814c2a2431505214063006b79cbd36b7b3672b8744"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "更有印来比劫助，伤妻克子可立看。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0012",
      "sha256": "360aa5c87f5dc55c2f92dd504b38e1682cf3cd1ba7370eb48a50a7b977891060"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "官煞太重身更强，一逢制伏作贤良。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0013",
      "sha256": "cbb2e00b4a597b8f9061f1e3214188afed75f2885b89d68ab229787b3cb5d218"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "煞官拱印贵不小，煊赫威名定振扬。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0014",
      "sha256": "9440cf8e082ad0e0605d2daeff3b4dcf233e26254d8ef1b10b705df26e68ccf9"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "生居九夏火土多，利逢水济贵中和，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0015",
      "sha256": "73bfeedc8f427353e75269ce803798fe8a6c6a00145a4f79285336603286b0f0"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "水火原来要既济，管教名利镇山河。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0016",
      "sha256": "699544ef14d36a2fe920d38e0131115fb55be70364102e3313359eb76b971ffa"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "火热炎炎如无水，运行水乡亦是美，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0017",
      "sha256": "f2de01aaf887921b99716aa50021fcc9752623103a46345740c775d635a1d8e7"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "水势滔滔若无土，运入土乡真可喜。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0018",
      "sha256": "13fcc56a72b096da00812c7b911b864e77781442c91460501b8361c42b383c6e"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "东方木多宜西运，西方金旺爱东行，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0019",
      "sha256": "412051d5aa4fa72dd827dc4b886f4a5322de202ba1ffebb55bb4a57ef2033349"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "五行相济成造化，人命逢之福不轻。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0020",
      "sha256": "c55b6acb879ef6071384a4b13dd619331fb93b8019c6fcabfdbb153f0465ea55"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "三丘五墓怕见重，骨肉参商损六亲。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0021",
      "sha256": "4b8f37508822419909545c58565be3d584a4fca32511569ef89f07102445fb2b"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "提纲刑冲克父母，日时对冲妻子伤，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0022",
      "sha256": "45467071d64663fb565c82dc2129fcb5b2a45e688715a8938ff64ee77edbaad7"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "比劫伤官若再旺，不但伤妻更损儿，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0023",
      "sha256": "d893e3063ae99be3409c87078d984f6f1c30895fa16e981419f3217334c5bc29"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "纵有一子亦不孝，或是乞养总非宜。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0024",
      "sha256": "6f19e447dc987dac7e374f83b54a536658e703527db420f33b14d8916c478fcb"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "身旺比肩坐驿马，兄弟飘蓬好潇洒，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0025",
      "sha256": "490d656d75b5ae24dfeef0dd765bd80843426c256d90a9cd0c258a0c405ef64e"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "八字驿马纷交驰，身荣劳苦东西也，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0026",
      "sha256": "cf4f661d00530cb7487abce421101bf521cb30f440ff430fdb7c637d173fc493"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "倘得身闲心不定，动则风流静则愁，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0027",
      "sha256": "1a6b8825338a7241e5a84f15930050cd19e5e2de627be72aa7cce9c36990332a"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "若是财星坐驿马，妻贤无处不悠悠。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0028",
      "sha256": "b29d22cd365db5aea06e66468772e118e4be4aacba78d7c1fa78e89981095b8b"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "财星入库主聚财，谨守赀财不做人，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0029",
      "sha256": "5dc44bf816249e7cfc3432bae3cb9696f2dc0260a77f6b48c5264aa1bc0b075d"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "妻儿悭吝善待助，只怕暗藏羊刃喷，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0030",
      "sha256": "a8abd40bece8a29034ccb58ac93245546765e2fbbe6b244a81e58ff42d2da866"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "官煞重重不带财，妻能内助不和谐，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0031",
      "sha256": "38fad23ca28164e600201be64329f85aadae4327ff2f5ee370bde5a39c9574e4"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "公姑不敬全无礼，夺却夫权命所排。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0032",
      "sha256": "a82bf9ed80b25b10b7670bbbbc7d113099eb775029a462ba999adc80fc514174"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "官星若也逢生旺，更得长生旺在时，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0033",
      "sha256": "942c0e8756b9d77b19de013706554fa7455fd20e7ac75f8fffb83c3006459b16"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "子息聪明多俊秀，儿孙个个着绯衣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0034",
      "sha256": "05f568b2b3a909439e09a3b2b59b55167da947a8e62f2262547fcb6f3f1eea6b"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "日主七煞带枭食，妻主虚胎小産多，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0035",
      "sha256": "5365ce3273e34b4024750d57a7114061d5cac0124a93ac0a29c49542eebe1e43"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "经脉不调成血疾，更看行运又如何，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0036",
      "sha256": "f7b8788c11263bbefd0fbe48880fcff6f60055aa63e79eba77ee64cdb9ded4d0"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "男子枭食重重见，身弱多应疫病随，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0037",
      "sha256": "d1c370d93617abbacc86ea0d9ef9deccb509b677ad96b23874f4408417b20205"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "女人枭食非为吉，産难惊人病亦危。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0038",
      "sha256": "b1e3d1d4696eb13680d7181f02af012e3ad965708ff28d2bcfeba30d7a45b89a"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "女命官旺兼财旺，招得贤夫更好儿，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0039",
      "sha256": "994165f1d34d3084dffc09a003192eddaea807bced0783a6fff1f88beac7b13f"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "若是财官俱受损，伤夫克子有何疑，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0040",
      "sha256": "e7a05d4d05b667519265329bc7f4ad6a8bc5301d2f97b25fe103436a28ee4b48"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "印绶生身身更旺，为人刑克主贫孤，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0041",
      "sha256": "0539ef004d807907a798996246f52b2358d7e6fba6af15c3c43ab1713331bd5b"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "若得官显财又显，亦为超迈贵人扶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0042",
      "sha256": "a0eb452b9c430385faaa5487098d0861e63f7a6a05a09c4d0ac740be70812e87"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "女命若也伤官旺，坐下伤官会骂夫，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0043",
      "sha256": "2c147e5eea4f14bb936a33c5c9eaf2c4f9998b0232b76bfbb0cdf55ceb5569e9"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "朝暮喃喃口不绝，百年终是见刑枯。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0044",
      "sha256": "02fa40a37acfbb15d83148ca0fc38df402348f64ad2401004213babacac40930"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "乙巳庚午与辛来，月干带之最为美，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0045",
      "sha256": "0ba53c7d5ee4db55b8dcd21fdfd88c5702cff400fb2b294006fa7976d7506dc6"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "再看四柱又何如，定主夫贤儿亦贵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0046",
      "sha256": "c2d0ec2bee5f2979cce15fa3887d6bbcc982c728c187072aba67a9c9e106aae7"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "丙丁子丑戊己春，此日生人定不同。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0047",
      "sha256": "a0ee13c462dfcc62de84b398edd77e516b835d98398440032d14f64fc2286a77"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "甲午甲申共乙酉，坐下财官富贵荣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0048",
      "sha256": "0050f5257da42ab7118e5fd3485b3e0c41a017210ecaac58835513a4a33917b7"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "丁亥戊子并庚寅，日主逢之福不轻。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0049",
      "sha256": "e712c0d0d0ce0622e2e7ec027d71121a6ae3cc39ca3347984ce494ef50dae885"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "辛卯丙申丁酉位，财官内隐显声名。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0050",
      "sha256": "962405837af9994265ef0316af81b57281cd069a70c76c8d370cf24e39d3308e"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "己亥甲申见庚戌，印绶财官暗里藏，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0051",
      "sha256": "54766903dcd6d3fd11c19b59bafde5f7b5dc34f65e3f9c873eaf43092a0b9612"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "更得丙辰壬戌至，四柱扶印不寻常。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0052",
      "sha256": "ae81bc3cffaf556377d4183fb0ecc51528c2ce1104960334047c4b926f4f8363"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "甲子丙寅与丁卯，己巳壬辰癸巳同，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0053",
      "sha256": "aa3c17bd2fc31c29a3eacbeb806b9787f3633fa70efeedf3509884c42bc72e0e"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "若是身同强月令，虚名虚利任飘蓬。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0054",
      "sha256": "fc2e692bdb57ccf9e0c8340e92bd2944da78dc85f4b3226b9ad80504ff2c2191"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "乙亥庚申并己巳，坐下财官并无有，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0055",
      "sha256": "dedded9d735bb9961314348904ed57b433fa90308595c9252414592306bef227"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "妻宫子女带虚花，东西南北是身家。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0056",
      "sha256": "34f3bc42ec1a9c5cd7b09dbdce1d2d08ba66330f7bdab064956034f0b00b6c67"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "甲午戊戌并庚子，女克丈夫男克子，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0057",
      "sha256": "842411c91ad334d69572ca48fd0a0697a031a10356b0d59357f6bab697c24f2b"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "乙巳丙午丁未同，重重壬子主孤穷。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0058",
      "sha256": "b489b77306636e7e3bd9f47da330f663d2170eac63eaff9dc8faba13e92f7486"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "辛酉乙卯与戊午，支干同类妻不足，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0059",
      "sha256": "bc37af7eaf8241efb3f18610117298360f3bba0ae7b8e67d5f4bc55f178a3fe4"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "己未庚申及癸亥，月令更旺成祸害。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0060",
      "sha256": "aad5a66e4b7b63e72d93b137d628121302fdb2d0b45eee3d01240c9b9c9f5c1a"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "日主财官印绶全，月时符合福绵绵，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0061",
      "sha256": "fcf77c02f6285f086e350d1f9f0e18be08121a5080fe3cc95ed2939a9fbeb517"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "干支同类共身旺，克子刑妻破祖田。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0062",
      "sha256": "63515049e05e4acba755c066bb7ddb8bc5162a6e66c9313770f676087182dfb3"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "好将四柱分强弱，莫把阴阳只一言，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0063",
      "sha256": "a474542e85337ff13e7cc486de12733db88849694526b1a61a225babe4399795"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "此是五行真妙诀，不逢知者莫虚传。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0064",
      "sha256": "3a046d63b28ec810705906df9d3399be676acc4ab04d150ebe3c7935c0130944"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "身旺无依，损财伤妻，或是外家冷落，或过房入舍。身旺印旺，破财不聚，有财只好善破，或置物创屋，或闸大而仓库虚，内不足而外有余。官喜露，露则清高；财要藏，藏则丰厚。杀藏官露，恶隐善扬，人生遇此，名振乡邦。生居三冬，水冷金寒，得火相扶，莫作等闲。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0065",
      "sha256": "bd31ab70b5e418aa8455c113094f20217148d81e5a88a78e85afb3faad86e446"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "南方火炎，利入北方水运；北方水寒，利入南方火运。东方木多，宜入西方金运；西方金旺，直入东方水运。水火有既济之功，金木有成名之论。五行得其相济，威名荣振九天。三丘五行，辰戌丑未，若是重见，骨肉刑悲，父母不足，兄弟异离，亲戚情疏，更亏妻子。冲破提纲，多亏父母。或是刑克，或是离异。比劫伤官旺，伤妻更损儿。养子多不孝，乞养总非宜。惹是招非，只缘水火相克，或是目昏眼暗。且如丙子、乙巳、戊辰、庚午、辛未，日干带之，权贵之妻也，更主妻贤，亦主贵，更看四柱又如何。又如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0066",
      "sha256": "124da21977cd01a7dac1fec0c36b3ef2f5853aedc11e01502e83c27c34dea40f"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "丙子 丁丑 戊寅 己卯生人，遇此皆因前道。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0067",
      "sha256": "88f7606efed5f63927a98e1bc30815326d68f167295406623916c4c6c33fac9c"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "辛巳 壬午 甲申 乙酉俱是坐下财官，逢之富贵不愁。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0068",
      "sha256": "886c0c54fb9e0741a922c01dc72936668d11688def0225fd1edc69f49ad316a8"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "(此印净禅师传也)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c180:p0069",
      "sha256": "165f046a7c953afa3cfce2251199c2eda741e8403e089df8472b548c546eef3d"
    },
    {
      "section": "寸金搜髓论(搜髓歌)",
      "text": "眉批：“提纲”，月令，领君之命而行之，故曰月令。“四柱”，年月日时也。“身旺无依”，如五行旺相无济之理。日主为身，甲日生子寅，又亥卯未木局逢之，身旺无金制之，必为僧道之流。“三冬”，十月十一月十二月。“驿马”好出路，四方潇洒，苦无栏，主流落他方，寅申巳亥为四马之方。命中取财为妻，又为马，即以论财及妻及马统而相逢以论之。“枭神”，偏印也，乃不仁之鸟，能食母。“坐下伤官”，乃日坐，不可犯之。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 195,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c180:p0070",
      "sha256": "243e3babf23df5c2132eb227c04ffcb7e6200e7dad23d20aeefbc0c0759978a5"
    }
  ]
}
