      "section": "长生诗诀",
      "text": "渊海子平卷五",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c269:p0001",
      "sha256": "d284d3c59105f6347a605b7d9c7a48dc5eebdc667d0b53daee688840ad6bd8a9"
    },
    {
      "section": "长生诗诀",
      "text": "长生诗诀",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c269:p0002",
      "sha256": "983dd2f6ba9d113a2fe96f40f547b9c03314af4673053426bc3a95ed9bec914c"
    },
    {
      "section": "长生诗诀",
      "text": "长生管取命长荣，时日重临主性灵，更得吉神相会遇，少年及第入王庭。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c269:p0003",
      "sha256": "636139f4f024aef2adf107e68f03afef7e0afb671278adf9be799af52add68c6"
    },
    {
      "section": "长生诗诀",
      "text": "长生若也得相逢，生下须招祖业隆，父母妻儿无克陷，安然享福保初终。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c269:p0004",
      "sha256": "8a0c0c09da22d9e2f700976c92b9ac74049b9efef913bb3967e014094a55882f"
    },
    {
      "section": "长生诗诀",
      "text": "此诀虽五星中有定决生死，子平四柱亦要定生旺死绝之由。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c269:p0005",
      "sha256": "88df4f5c90f097f68d968c43ff68e9f7a1063130300a0e0e0b1d69c6d09ee6f2"
    },
    {
      "section": "长生诗诀",
      "text": "眉批：五行长逢之地，木生於亥，火生於寅，金生於巳，水生於申，如能遇之，则福。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 38,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
