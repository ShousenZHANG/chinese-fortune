  "issues": [],
  "passages": [
    {
      "section": "伤官说",
      "text": "伤官说",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0001",
      "sha256": "55dc335ad0267ce21f5b669238133d815e9924996710b2475b6cf150cf4c6c3c"
    },
    {
      "section": "伤官说",
      "text": "伤官若伤尽，却喜见官星。伤官若论财，见祸不轻来。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0002",
      "sha256": "d84ae808270c1697f1c535eeebcdb784bdc7731b91529221edef0c0b71029713"
    },
    {
      "section": "伤官说",
      "text": "伤官若用印，克杀不如刑。伤官若论财，带合有声名。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0003",
      "sha256": "0b416a3528825254b98cc861460ff2f17f0162b46b7c314b4f25d72bf72d4eaa"
    },
    {
      "section": "伤官说",
      "text": "伤官用财，不宜印乡。伤官见官，印运不妨。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0004",
      "sha256": "d78dd4523b681c797bd454f2b16f9f6f15a874dd7ae3947ef48f173f4186f5cd"
    },
    {
      "section": "伤官说",
      "text": "杂气财官，印俱不忌。两戊合一癸，得再嫁。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0005",
      "sha256": "50b9347614c5340e90ed7442895ab37981ff5754ee339b602431679cf4a9536d"
    },
    {
      "section": "伤官说",
      "text": "妻财受克，生子不育。印绶比肩，不忌财乡。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0006",
      "sha256": "adda496849e790c9004f068beabd42e33013b25db247eff7353fff618c0a050b"
    },
    {
      "section": "伤官说",
      "text": "印绶多根，身旺必贫。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0007",
      "sha256": "e012e18bbbc5c9140e6b3ec756e26a609efe45af95162cd9ff47f42d7eec8640"
    },
    {
      "section": "伤官说",
      "text": "印绶被伤克父母，官杀混杂克父母，财多身弱克父母。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0008",
      "sha256": "7bf4cc883caa4aebd7deb14ed64017b00926297252dad0d9baceb65862d97fae"
    },
    {
      "section": "伤官说",
      "text": "干与支同克妻，辛卯戊寅不怕杀多。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0009",
      "sha256": "1cfb46548b859269447e2e2cc29ac9852b8f80e7f82cf5992953f84d13c92fc7"
    },
    {
      "section": "伤官说",
      "text": "女命比肩，即姊妹贪合，多谎诈。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0010",
      "sha256": "474c567f2d6fd60c0e15210cf25c973ca35fd18456587efd6b8df616e0a85f78"
    },
    {
      "section": "伤官说",
      "text": "财有官杀不怕露，火命人最好，月支属火，干头有木提出火矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0011",
      "sha256": "7dcc68e7dd29fc41cd5902f729291b8616a12bef56e346703c9f0430efc68a99"
    },
    {
      "section": "伤官说",
      "text": "癸酉弱格，见杀必凶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0012",
      "sha256": "5f105f6be1a00e00e7a88f7b32bc50822cdf492c47086ff97005a3d50d6e6ef1"
    },
    {
      "section": "伤官说",
      "text": "官贵太盛，旺处必倾。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0013",
      "sha256": "f951571de9c0b574036a7926062a0b9f69f4405775d29e203e9976dc8482deb0"
    },
    {
      "section": "伤官说",
      "text": "土命不论胞胎，只论日时，不怕官杀混杂。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0014",
      "sha256": "0b22b836651d828b8e4a71bf1a9381c36d23bb3df1cbdbad8d335c30d30b3d4e"
    },
    {
      "section": "伤官说",
      "text": "阳干方论，阴乾不取。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0015",
      "sha256": "2ac72c0b6f52f19759e5bdac5fb96a38c4ce235907af7b89219d525a16e2b859"
    },
    {
      "section": "伤官说",
      "text": "子怕寅午火，不怕水。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0016",
      "sha256": "18a02d44cfa1bbb81acfaec8922c923a651b13afa71dc9b10efe29cac3ce92f8"
    },
    {
      "section": "伤官说",
      "text": "寅木不怕金，巳金不怕火，己土不怕木，午火不怕水。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0017",
      "sha256": "46dac135c036788793f85e190a885b7a687e35a7e5313dbf20fdc56fd8e61ac7"
    },
    {
      "section": "伤官说",
      "text": "未同申金不怕火，己土戊土不怕木，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0018",
      "sha256": "91dacb143dc63e68a971b01d393a883c8c128da6e145e649e001641cfc0480c4"
    },
    {
      "section": "伤官说",
      "text": "卯木怕酉金，辰土怕寅木，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0019",
      "sha256": "6d0316c3f261f12f58e9c94a6dcd68b02213a2c2ac97e74d1295cf04ba098e00"
    },
    {
      "section": "伤官说",
      "text": "乙日五月不怕杀，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0020",
      "sha256": "6cd54c006f9f561859d459fcb4506077d521af9a81c543b9158a3c631216d95d"
    },
    {
      "section": "伤官说",
      "text": "四柱元有病，要去病，不去病不发!",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c182:p0021",
      "sha256": "bd8f9335d12145fedd25e8cf93039d96470f1bd8fd135ee5bda5ad1c476cb586"
    },
    {
      "section": "伤官说",
      "text": "眉批：凡四柱有伤官不宜见官星，若伤尽无一点，方可见官星，则吉。印绶本怕财，若行财者，则比肩分其财而反不能伤印。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 55,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c182:p0022",
      "sha256": "e999aed916ed41fee34093caea83ebf89d3ccab95b6cea40f05cb56cfd8fb520"
    }
  ]
}
