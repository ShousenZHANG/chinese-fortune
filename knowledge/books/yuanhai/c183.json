  "raw_sha256": "64a86249c9041118b9cd1ea32063291e394bde5aaefaa821da84917479b7ae4f",
  "raw_kind": "cleaned_original_transcription_not_complete_http_response",
  "extraction_kind": "selected_original_html_node",
  "issues": [],
  "passages": [
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "心镜歌 (心镜五七赋)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0001",
      "sha256": "2fc9decde4bdfa53252d46019288bfc26041f1cf8457eb9c78bf6bb20ea8dd37"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "人生富贵皆前定，术士须详论。天上星辰有可知，此论更无差。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0002",
      "sha256": "7089135afb0e316fb06fad129c41668bfa773ee80446348562485b77fda1ada5"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "时加月建逢命位，正是福元取。寿元合处是其真，此说不虚陈。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0003",
      "sha256": "83214273b46fc171526a0a00d256ce3154c806dd66ca9e5ac146b8b8b9e688d3"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "官禄贵马见合刑，一举便成名。日逢贵地见禄马，壮岁登科甲。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0004",
      "sha256": "289bca3a5ab983524ba09bcb89369ad5fab56ac97abc7118568c9ba926c53c45"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "时日若逢禄马位，为官必清贵。五行时日无相杂，为官多显达。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0005",
      "sha256": "2a0b44e1a9225de1c1ed0048def8df1d3de2e25709786c4e090d6175b42e0911"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "羊刃重重又见杀，大贵登科甲。若逢三奇连禄马，名誉满天下。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0006",
      "sha256": "cc98c64995f2b4ca52b60b7ba3bb21e42198c2b60f5415d80b8e45474e351143"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "日坐食支又合干，九卿三公看。甲子己巳有一说，天地德合诀。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0007",
      "sha256": "27569fec1c8ac594058cbdcfba41092898d9596f7c4a61d7757cf1c1b7753f88"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "丙子癸巳与前观，官职三公卿。木若逢金主不伤，两府坐中堂。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0008",
      "sha256": "e1512b69eeae9cac4ec1d19e30276632089f2dddb35e36e65bcefe1dcbbf3fdd"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "火若逢水主将权，为将镇戎边。金若逢火主大权，方面刺史官。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0009",
      "sha256": "20412ce95e7d3ee4b1f816c6de4abfeb4dc8205dfe7a37a223de6ef37fbf12ad"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "水若逢土入官局，宜作侍从职。土若得木为正禄，八座三台福。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0010",
      "sha256": "5a32ba30dd622a1f1cba7f50bdfd4815619125fe6d2193a77ea56c004f71c0c0"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "年得月禄不为害，日贵取为主。生逢贵人值孤寡，决定为僧也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0011",
      "sha256": "2710c7499057f491769fa69c124211addda30c4aaf9debb7e2a3a98381c09843"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "空亡官禄遇贵人，淡服作高僧。五行无气守孤寡，必定作行者。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0012",
      "sha256": "bc2cdebe605f4e70276441790b32b4145422471959e0ce5a97d2f9313d07658a"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "空亡刑害又逢囚，为僧及裹头。欲知人命主有权，食神旺必全。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0013",
      "sha256": "6ec03b02a4c7030d4c4577635449e579e74adae68845d117a8844d66be8d2ae3"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "相冲羊刃并杀伤，必主上法场。的杀如逢盘足坐，恶鬼死刑狱。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0014",
      "sha256": "6b714d4366965ec6e7f6a1407a20ea6156df2878c625e397990a0db72b78b404"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "夹角相逢共岁星，徒流定分明。六害当权多夭折，少年逢刃杀。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0015",
      "sha256": "66d5bf5b5618ba856f2722f32e3c9f074007cd64d0fb35d65dbb27069854a03a"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "日逢官鬼见重刑，恶死甚分明。刃神劫杀两头居，早岁梦天衢。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0016",
      "sha256": "5520f406b72c0bf8b964e6ace0b6c1649a75e738efa4574c10801ca9b86389fc"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "禄马俱逢行绝地，劳困难逃避。月若逢时与相冲，根基定一空。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0017",
      "sha256": "bea5899fcc75fe7b8fb31ec79eb4f0d71df902e3affc866be2aee6d35d84f2ce"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "时遇官星生旺位，子孙成行序。向禄临财官更吉，贵显有家资。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0018",
      "sha256": "bbf400b62f4a5c9ea114b83a6118bdc346525bb2b714ac2c424136349b1653e6"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "日月纯官无财位，反主无官贵。卯刑子位子刑卯，癸乙相刑贵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0019",
      "sha256": "ab81a7e305c308c8b2576f2cd75eed781392c57b750188f1adfc4fa5f3569420"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "子来冲午未刑戌，甲乙逢申显。禄马俱绝又发财，人元克出来。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0020",
      "sha256": "c808daf0983338d20d928e2b187b381cb123607b98da48095e6b0e3e7bde37c5"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "得一分三缘何议，禄马飞天是。岁合时日分两头，切须仔细求。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0021",
      "sha256": "93ed332a12d29e301c5d990d2d07692be73777fe6fda9f67bc0fad4fc9a37304"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "君子若逢主奏对，常人主灾晦。心怀退悔成何事，重犯剥官位。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0022",
      "sha256": "7e8d07db676e1a2d24c0d934666b6b9faed3fb6322faeaf3e51a69671aa7126e"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "柱中有禄运逢财，金玉自天来。言前能说贵与贱，亦须看大运。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0023",
      "sha256": "3b27a2fe5ce8b326794c0d3559efb1a56add31c0f7f3fb51314b35ef29da9dfb"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "大凡行运逢禄马，发迹为官也。天月二德为救解，百灾不为害。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0024",
      "sha256": "9afb9056c5f8419cb4998148a97060292478a70a0d56c1ad640b2143edfa7a79"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "向禄临财甚稀奇，贵显主官赀。命中禄马同贵人，福禄进珠珍。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0025",
      "sha256": "8414865201a08a0924a94996f139724cce3f9719dcceb99c9169b9f74030b2d4"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "贵人君子坐刑杀，名成少年发。阴阳贵贱宜消详，熟晓在胸臆。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0026",
      "sha256": "1eea7f66267802331236673f5bf279d113742fc1bad8e5b820dc2d482f69326a"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "日时身命许多般，一诀通变看。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c183:p0027",
      "sha256": "2116a7743caf9dd85bc89f21f52d33a6e8d503bf1110df7fe6a3213b7bf2c2d0"
    },
    {
      "section": "心镜歌(心镜五七赋)",
      "text": "眉批：甲乙以金为寿元，丙丁以水为寿元，戊己以火为寿元，壬癸以木为寿元，庚辛以土为寿元。年庚四柱中，惟取其中，用空惟定，寅以丑卯拱之为例。“刑害”即子午相冲之例。有天月二德星在日时，主能获自己之福，主人年早自为、晚景昌盛，在日月者正，得之主父母余福，在年亦不验。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 130,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c183:p0028",
      "sha256": "3efc730e01a7a218dfd0bf77be5836454735468ff4af5ddebc89d89027329a96"
    }
  ]
}
