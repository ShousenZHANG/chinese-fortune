  "raw_sha256": "a8cac696866899101a06be21f348fef27ea2c7890da79dbe5cc16be3cc180f8a",
  "raw_kind": "cleaned_original_transcription_not_complete_http_response",
  "extraction_kind": "selected_original_html_node",
  "issues": [],
  "passages": [
    {
      "section": "四言独步",
      "text": "渊海子平卷四",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0001",
      "sha256": "f981a62c7da7a5ad79fbd8eff95f693bffd1820b2aa5425445b6992c612e6db0"
    },
    {
      "section": "四言独步",
      "text": "四言独步",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0002",
      "sha256": "49b256118d5400950ae3f6bc699eec60478efd9f605c87a416619f47acb275ba"
    },
    {
      "section": "四言独步",
      "text": "先天何处 後天何处 要知来处 便知去处 四柱排定 三才次分 年根为本 配合元辰",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0003",
      "sha256": "ee608495c910a4d26a5b419089d4847d79d2e93b13000205a993b6fe723584b8"
    },
    {
      "section": "四言独步",
      "text": "神煞相绊 轻重较量 先观月令 论格推详 以日为主 专论财官 分其贵贱 妙法多端",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0004",
      "sha256": "11e135957a42fdeaa71f7681f95b733bf35b82dde92ba01113ce84de3b723601"
    },
    {
      "section": "四言独步",
      "text": "独则易取 乱则难明 去留舒配 论格要精 日主高强 月提得令 用财为物 表实为正",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0005",
      "sha256": "1bb96ab973aa6ecf09d7f4aa1b9054a0028d1aaa10afbc4689287ba386569882"
    },
    {
      "section": "四言独步",
      "text": "年根为主 月令为中 日生百刻 时旺时空 干与支同 损财伤妻 身支年同 破荡祖基",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0006",
      "sha256": "39d6189648a257e8dd1c16e88700fd6fd88c849edf1cf3b3a15075749efa6819"
    },
    {
      "section": "四言独步",
      "text": "月令建禄 不住祖屋 一见财官 自然发福 用火愁水 用木愁金 轻重能分 祸福能真",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0007",
      "sha256": "97a6f49bd85076ee47dca48b0d866af82eb425e077424ce2ed5484103ff82ed7"
    },
    {
      "section": "四言独步",
      "text": "五行生旺 不怕休囚 东南西北 数尽方休 寅申巳亥 四生之局 用物身强 遇之发福",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0008",
      "sha256": "df9de9dc11e28f2bda58f733c165a39dbe782ce8393eb625011d8e65b4334e3e"
    },
    {
      "section": "四言独步",
      "text": "辰戌丑未 四库之神 人元三用 透旺为真 子午卯酉 四败之局 男犯兴衰 女犯孤独",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0009",
      "sha256": "cd4fca4eb2e1f2f1d2dd354d90131260c080ef0b4398ad96f474f0441686ec32"
    },
    {
      "section": "四言独步",
      "text": "进气退气 命物相争 进气不死 退气不生 财官临库 不冲不发 四柱支干 喜行相合",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0010",
      "sha256": "ef9ac9c8ba08e92d4955c4c33c643b7753909f9bf074c0b32b32602201a01ae9"
    },
    {
      "section": "四言独步",
      "text": "提纲有用 最怕刑冲 冲运则缓 冲用则凶 三奇透露 日主专强 寄根有力 福禄荣昌",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0011",
      "sha256": "5bacacfd86011471e605a8ddcd026f56c5c1ca7a700c80c581fb30b92c41ad5a"
    },
    {
      "section": "四言独步",
      "text": "十干化神 有影无形 无中生有 福禄难凭 十恶大败 格中大忌 若遇财官 反成富贵",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0012",
      "sha256": "3c9f3242535b6bcb73f56ee4ebc5412cb7b2fad46e2cd1926e7456349dcb98a2"
    },
    {
      "section": "四言独步",
      "text": "格格推详 以杀为重 化杀为权 何愁损用 杀不离印 印不离杀 杀印相生 功名显达",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0013",
      "sha256": "1191c306435f7fc8d9ef75b1f7ea2e3230f6fe5bcf827d3c77f12ad9375a0323"
    },
    {
      "section": "四言独步",
      "text": "官杀重逢 制伏有功 如行帝旺 遇之不凶 时杀无根 杀旺取贵 时杀多根 杀旺不利",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0014",
      "sha256": "f1e232dc530613f44aa47b2d72db13779251ff80743346c92be56282c5761467"
    },
    {
      "section": "四言独步",
      "text": "八月官星 大忌卯丁 卯丁克破 有情无情 印绶根轻 旺中显达 印绶根多 旺中不发",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0015",
      "sha256": "351424f2b11fbdb2941b78c832e6d9224c72d0756b1aedc03cd259af7604263b"
    },
    {
      "section": "四言独步",
      "text": "印绶比肩 喜行财乡 印绶无比 忌见财伤 先财後印 反成其福 先印後财 反成其辱",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0016",
      "sha256": "4ead6c5f3a55720f2ec2ebd197a26d7b197f01e65aff49132ff837247f997048"
    },
    {
      "section": "四言独步",
      "text": "财官印绶 大忌比肩 伤官七杀 反助为权 伤官用财 死宫有子 伤官无财 子宫有死",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0017",
      "sha256": "3736aee433a9052ea5752b8592ef24047ca2c018757fe819507f63a413b846a2"
    },
    {
      "section": "四言独步",
      "text": "时上偏财 怕逢兄弟 用印逢财 比肩不忌 伤官见官 格中大忌 不损用神 何愁官至",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0018",
      "sha256": "873e6b48822d61cf1f990f851d119e404f79bbff56cd51bcfb5062a968d781aa"
    },
    {
      "section": "四言独步",
      "text": "拱禄拱贵 填实则凶 提纲有用 论之不同 月令财官 遇之发福 名禄高强 比肩夺福",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0019",
      "sha256": "f72b4e7de5c61812a2b7df995d63e191455b1db55f9cf51a1f7a4ce2888b1b83"
    },
    {
      "section": "四言独步",
      "text": "日禄归时 青云得路 戊日申时 透财得禄 壬骑龙背 见戌无情 寅多则富 辰多则荣",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0020",
      "sha256": "662840207f8cfba558ccb3946e80dad6c4a47b400262e8a749f070ecae6fc605"
    },
    {
      "section": "四言独步",
      "text": "天元一气 地物相同 人命逢此 位列三公 八字连珠 支神有用 造化逢之 名利必重",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0021",
      "sha256": "c2c36e3827b4fdb3180dd059df2dc0992fb12a5d728d0f6da7ced848c07f3bad"
    },
    {
      "section": "四言独步",
      "text": "日德金神 月逢土旺 纵有轻名 祖业漂荡 金神带煞 身旺为奇 更行火地 名利当时",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0022",
      "sha256": "5faea4ead25f730fccc96679e581840f5601d1fbd7d496136e56dfcaac801f0e"
    },
    {
      "section": "四言独步",
      "text": "甲日金神 偏宜火制 己日金神 何劳火制 六甲生春 时犯金神 水乡不发 土重名真",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0023",
      "sha256": "043138ea18f61263946afe7632803b1d2027066986b712640350b1c12bddd904"
    },
    {
      "section": "四言独步",
      "text": "甲乙丑月 时带金神 月干见杀 双目不明 甲寅重寅 二巳刑煞 终身必损 遇火难发",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0024",
      "sha256": "b824635e93e9a46485264a875e928ad3c432f9a9bfe6e51056a5172506a80eed"
    },
    {
      "section": "四言独步",
      "text": "六甲寅月 透财时节 西北行程 九流艺业 乙日卯月 金神刚烈 富贵比肩 旺横死绝",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0025",
      "sha256": "e1e6b42aba4f2a572b567d771ace659fca46f79d22afcedae5280e5c1e25dbbc"
    },
    {
      "section": "四言独步",
      "text": "天干二丙 地之全寅 更行生印 死见祸临 火旺二寅 透壬坐申 艮禄多厚 见水伤身",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0026",
      "sha256": "b4543c3711cf70b1c75a4198bbaedb81e5f9e5ee6f9eb182c42b973b6b6ed802"
    },
    {
      "section": "四言独步",
      "text": "六戊重寅 月令水金 火乡有救 见土刑身 己日月戌 火神无气 多水多金 眼昏目闭",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0027",
      "sha256": "bcd5d5cd4c71a9d46ac57761a18a50175661a8353432105f9276429561e8cb1c"
    },
    {
      "section": "四言独步",
      "text": "年干会火 日时会金 己干用印 官彻名清 秋金生午 丙火透露 运至南方 血伤泉路",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0028",
      "sha256": "abf8c548aa16b8df8deb7f7c9e8a07ce577e9c154b8acd24aa695b6c33823026"
    },
    {
      "section": "四言独步",
      "text": "金旺三秋 二庚夹丙 到丑伤情 逢离顺境 庚金生午 辛金生未 透杀两停 冬生最贵",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0029",
      "sha256": "1fe78263fdf31f6641aef2e743ac04b8e80ffec5b8756c80e3fc2e6aaa49adb3"
    },
    {
      "section": "四言独步",
      "text": "辛金月辰 庚金丑库 逆数清孤 顺行豪富 辛逢卯日 年月见酉 时带朝阳 为僧道丑",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0030",
      "sha256": "3d9e0baddeb6dbd37664fdb51694f1093ae28d9fa1f039305c35e7aa0d29d643"
    },
    {
      "section": "四言独步",
      "text": "辛金亥日 月逢临戌 水运初行 须防目疾 辛金坐酉 财官用印 顺行西方 名利必振",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0031",
      "sha256": "57788f3b4a4ebd09f6b9cfccf910aca5a5b5fc6fb6e5d462b5e3617623eb3b13"
    },
    {
      "section": "四言独步",
      "text": "辛金坐巳 官印遇禄 顺行南方 贵显荣福 酉金逢离 透土何虑 无土伤身 寿元不住",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0032",
      "sha256": "a15661c7a2df29f4d898a50772ed668203cd1ae0748648ba74d06603170729e2"
    },
    {
      "section": "四言独步",
      "text": "月生四季 日生庚辛 何愁主弱 旺地成名 辛金逢火 见土成刑 阳金遇火 透土成名",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0033",
      "sha256": "2a5dd7b2ff0e400c003cc523e85d52f29d432219a61af987c82676e338591e6d"
    },
    {
      "section": "四言独步",
      "text": "壬生午位 禄马同乡 重重遇火 格局高强 壬癸多金 生於酉申 土旺则贵 水旺则贫",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0034",
      "sha256": "6e97515e43e6af47855535f3133b86f45edf26b891e0298416200069375d07cc"
    },
    {
      "section": "四言独步",
      "text": "癸向巳官 财官拘印 运至南方 利名必振 癸日巳亥 杀财透露 地合伤官 有劳无福",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0035",
      "sha256": "77a6f8f75a046cfac4ddf75017b2b4d41faa2091f48ebbd5f0b6e9257a4f0579"
    },
    {
      "section": "四言独步",
      "text": "癸日申提 卯亥岁时 年杀月劫 林下孤栖 癸日干己 阴杀重逢 无官相混 名利必通",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0036",
      "sha256": "261383316891f7ad8ea38f5cd8194691e083c9faac9bdc009071e3e30e9400ac"
    },
    {
      "section": "四言独步",
      "text": "伤官之格 女人最忌 带印带财 反为富贵 杀多有制 女人必贵 官星重犯 浊滥淫类",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0037",
      "sha256": "783c853a9e6186457febd6c072b0fca1d4f130932d86e53c95ca00f9f92c37a9"
    },
    {
      "section": "四言独步",
      "text": "官星桃花 福德堪夸 杀星桃花 朝劫暮巴 庚日申时 柱中金局 支无会合 伤官劫妻",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0038",
      "sha256": "2c41cf22cabeef3e9616e4912ed823045bd785a5b604ef869e6039e0c80f4930"
    },
    {
      "section": "四言独步",
      "text": "癸日寅提 壬日亥月 莫犯提纲 祸福难推 甲日乾提 见杀喜比 金水栽根 忌寅卯未",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0039",
      "sha256": "d33d7e21d96ba196490e88e9116131548e50cb9b8c2b5703bd5e500badde138e"
    },
    {
      "section": "四言独步",
      "text": "戊己丑月 比肩透出 叠运入局 忌逢午未 壬癸坎宫 支逢午戌 干头比肩 东行为吉",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0040",
      "sha256": "5a108ac41bd32f03ce9c51a334e179303e729be3e436656266c1a17d79cf06cb"
    },
    {
      "section": "四言独步",
      "text": "甲乙震宫 卯多须夭 逆顺运行 子申发福 庚辛巳月 金生火旺 比劫栽根 两行成象",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0041",
      "sha256": "076252ce8abfdfefa5b5081af649c98959d87732b187a16b3434c98563e14b1b"
    },
    {
      "section": "四言独步",
      "text": "丙丁酉月 比肩不忌 火入离宫 比肩一例 曲直丑月 带印多金 壬癸丑月 土厚多金",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0042",
      "sha256": "b3569ba889ae47df0f21b6da9c82a01deaf886c73c4c81cb61b920c6b4ef0e24"
    },
    {
      "section": "四言独步",
      "text": "食神生旺 胜似财官 浊之则贱 清之则垣 此法玄玄 识得神仙 学者实授 千金莫传",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c199:p0043",
      "sha256": "aa76bca65427c0348dfe6ec9f4cc3b3e3a63766a111a052772718bdd74e50548"
    },
    {
      "section": "四言独步",
      "text": "眉批：“四生之局”，彼此相生故为四生局。“子午卯酉 四败之局”，子午卯酉午未沐浴之地，与化杀之方。“提纲有用 最怕刑冲”，月干支吉，逢冲则凶。“时杀”乃时上带，或干或支，旺者皆谓之时上一位贵。“用神”，月支所用之神，如子宫取癸水为用，格中如伤癸水，则为用神受伤，若不伤癸水，则虽有伤亦不为害。“金神”，巳酉丑之例，喜火。“甲日金神 偏宜火制”，木忌金伤，宜火制金。“西北行程”，言行西北方。“时带朝阳”为丑子时也。“壬癸多金 生於酉申 土旺则贵 水旺则贫”，壬癸生於申酉，则金生水助，宜取土还贵。“杀多有制 女人必贵 官星重犯 浊滥淫类”，女人重犯官鬼为而夫也，可舒而去之，亦有不去，勿执一而期。“庚辛巳月 金生火旺 比劫栽根 两行成象”，金生火旺，走西方可助身。“曲直丑月”，曲直，甲乙木。",
