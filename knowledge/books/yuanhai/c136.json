    {
      "section": "外十八格-夹丘格(拱财格)",
      "text": "渊海子平卷二",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c136:p0001",
      "sha256": "7ff3cf914c80f6b91688ae2c54d143b1d64be1e4fc0c5f98b16611fb00d628f4"
    },
    {
      "section": "外十八格-夹丘格(拱财格)",
      "text": "外十八格 - 夹丘格(拱财格)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c136:p0002",
      "sha256": "f71a9308c368501ea03712fa1258f2ed2946799e25968f53bc6b7c7967b36285"
    },
    {
      "section": "外十八格-夹丘格(拱财格)",
      "text": "此格用日支与时支共拱其财。且如甲寅日、甲子时，虚拱丑宫己土为财库。又如丁卯日、丁巳时；甲午日、壬申时；癸酉日、癸亥时是也。要虚拱，不要填实及有牵绊，则拱不得。更要日主自旺或财旺运亦吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c136:p0003",
      "sha256": "8b57494b64e0a47b8664516281468343be02242f5558589fba752dbe252ca7b3"
    },
    {
      "section": "外十八格-夹丘格(拱财格)",
      "text": "金丞相，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c136:p0004",
      "sha256": "02ef37bc027180491e2d1d7a56ce268554df035f6b086cd74cafb025f23b7598"
    },
    {
      "section": "外十八格-夹丘格(拱财格)",
      "text": "庚戌 戊子 癸酉 癸亥，以酉亥夹戌火为财。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c136:p0005",
      "sha256": "8ab97997845edf70fac5987babaf38225f2def6d83c2c50dfb3e8517076c1c38"
    },
    {
      "section": "外十八格-夹丘格(拱财格)",
      "text": "张尚书，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c136:p0006",
      "sha256": "3337025975b1e902f513de16269d0ef0711820af375be9e11bb22b10c2c2050f"
    },
    {
      "section": "外十八格-夹丘格(拱财格)",
      "text": "丙辰 辛卯 癸酉 癸亥，酉亥夹拱戌火为财。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c136:p0007",
      "sha256": "4f8632168ae67e5fdfb0a87b5753c94fd96f7f59a9dca908b4c091fe2afd760a"
    },
    {
      "section": "外十八格-夹丘格(拱财格)",
      "text": "甲子 癸酉 癸酉 癸亥，同上",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c136:p0008",
      "sha256": "d65d02f591331a4e77d2cbf23aa6bd4b14cf24a24d55f293f7d8af9e269cc037"
    },
    {
      "section": "外十八格-夹丘格(拱财格)",
      "text": "歌曰：夹丘之格少人知，拱夹休填塞库中。不犯柱中官杀位，一生清贵显当时。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c136:p0009",
      "sha256": "a3002681d07597bcf221880972de8db67f3c6889f75f20cef60155e049040209"
    },
    {
      "section": "外十八格-夹丘格(拱财格)",
      "text": "眉批：金丞相命非夹丘，因年支戌字填实不吉。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 21,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
