    },
    {
      "section": "论天德贵人",
      "text": "正丁二坤(申)中，三壬四辛同，五乾(亥)六甲上，七癸八寅同，九丙十归乙，子巽(巳)丑庚中。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c030:p0003",
      "sha256": "7968440f41287c8094c5fc0c433b9f23ced96d64e87e925c44bd5645f40a523d"
    },
    {
      "section": "论天德贵人",
      "text": "其法以生月分见之，正月生人见丁，二月生人见申即是也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c030:p0004",
      "sha256": "a62f029b442ed0bb5a849829c46998232cf7fcdb75baef834338b5c7d68012f9"
    },
    {
      "section": "论天德贵人",
      "text": "眉批：贵人在年月，乃补及父母之荫，在日时补己之贵。",
      "layer": "historical_commentary",
      "commentary_spans": [
