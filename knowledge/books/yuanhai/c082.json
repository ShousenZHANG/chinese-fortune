  "passages": [
    {
      "section": "论正财",
      "text": "渊海子平卷二",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0001",
      "sha256": "7ff3cf914c80f6b91688ae2c54d143b1d64be1e4fc0c5f98b16611fb00d628f4"
    },
    {
      "section": "论正财",
      "text": "论正财",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0002",
      "sha256": "90c9af8184f5de8bb89c2c1dca64762932ce5bb18d533a641562bda7fe19710c"
    },
    {
      "section": "论正财",
      "text": "何谓之正财？犹如正官之意是。阴见阳财，阳见阴财。大抵正财，吾妻之财也，人之女贵财以事我，必精神康强，然後可以享用之。如吾身弱，且自萎懦而不振，虽妻财丰厚，但能自视，终不可一毫享用。故财要得时，不要财多。若财多自家日主有力，可以胜任，常化作官。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0003",
      "sha256": "74a14ab15e3aae007f0989f2dd6bee1e77798232403615cbcdc4c41892dc2efa"
    },
    {
      "section": "论正财",
      "text": "天元一气羸弱，贫薄难治，是乐於身旺，不要行克制之乡，克制者，官鬼也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0004",
      "sha256": "c81134bcdd2c83e68644457d45fbe10dfc662cfd177c787ee7dfcee2c34fa470"
    },
    {
      "section": "论正财",
      "text": "又怕所生之月令，正吾衰病之地。又四柱无父母以生之，反则又见财，谓之财多不喜。力不住财，祸患百出，虽少年经休囚之位，故不如意，事多羁绊。或中年，或末年复临父母之乡，或三合可以助我者，则勃然而兴，不可御也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0005",
      "sha256": "466f7f34546d480d156568ecde47b4f481a9ffd5001838deeda00e52787e6b13"
    },
    {
      "section": "论正财",
      "text": "如果格成从财，却喜身愈弱，财极强之运，助身反为不美。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0006",
      "sha256": "280b87e346d4c9bdad21dd07b5f49120d6acc660604bc69fe3584db0a44b7ae1"
    },
    {
      "section": "论正财",
      "text": "倘少年乘旺，老在脱局，不惟穷途凄惶，兼且是非纷起。盖财者，起争之端也。若或四柱相生，别带贵格不值空亡，又行旺运，三合财生，皆是贵命。其余福之深浅，皆随入格轻重而言之。财多生官，要须身健。财多盗气，本身自柔，年运又或伤财，必生奇祸。或带刑冲七杀，凶不可言也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0007",
      "sha256": "c1cd93bb99c701e1ba70f9887e6b50c4b6c6fac45b5c196733bdbe789fa6dad9"
    },
    {
      "section": "论正财",
      "text": "又云：正财者，喜身旺印绶，忌官星、忌倒食。忌身弱、比肩劫财。不可见官星，恐盗财之气也；喜印绶能生身，主弱故也。且如甲日用己为正财，如身弱，其祸立至。凡人命带财下生须出富家，不螟蛉必庶出，或冲父母。身旺无劫财，无官星为妙。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0008",
      "sha256": "8b8c01c75ebb813836a53710275a0755a2dc0072d2ea8796ea41f7eb93b5c4fa"
    },
    {
      "section": "论正财",
      "text": "眉批：倒食者，甲见壬之类，以壬水克甲木之食神丙火，谓之倒食。螟蛉，小虫也，赢珠负之为子，此言自身无子，抱人之子以为子也。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 60,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c082:p0009",
      "sha256": "4101719111e79d7061f0dd427e53c4c002ff5c440c016f3afd26bef1806e786b"
    },
    {
      "section": "论正财",
      "text": "若命中有官星得地，运行喜财多生官；如有财星得地，运行忌见官星，恐克其身，怕身弱也。大抵财不论偏正，皆喜印绶，必能发福。如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0010",
      "sha256": "2680e2d64c5290ca4f4a6a339a8128cc5a65fb05d303650e89f2362b6133790e"
    },
    {
      "section": "论正财",
      "text": "辛丑 丁酉 丁巳 丁未，此命丁日身坐财之地，又见巳酉丑金局，故主财旺。盖丁得木库居未，生丁火，故身旺，能任其财。运行东南方，宜乎巨富。丁用壬官，用庚金为财生壬官，身入旺乡，必能发福。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0011",
      "sha256": "9fe49b3bf534400bf95ae4fc9cb8c57ca33adc2aa5feef0468f8af5887bab011"
    },
    {
      "section": "论正财",
      "text": "凡用财不见官星为妙。又如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0012",
      "sha256": "ba5935295d4991643b96e00fce6bfd41388fffa77a9efa1e47a09988b2086f0b"
    },
    {
      "section": "论正财",
      "text": "庚申 乙酉 丙申 丙申。此命丙日见三申为财，岂不美哉。丙用癸官，用辛为财，见三申一酉为财，故旺。盖嫌日弱，火病申死酉，乃为无气，运行酉方金乡，身弱太甚，财旺生鬼，败克其身，故不能胜其财，所以贫也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0013",
      "sha256": "70c906d4ed6bd869fa32cd328d9ed45a5d6e188649024ad3eac89a81a589f21f"
    },
    {
      "section": "论正财",
      "text": "眉批：七月庚金正旺，以丙日生乃偏财旺极。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 20,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c082:p0014",
      "sha256": "0885f6c0994cf3a138699aecfc09dc8d8c7569919c5ca82274fbdd3d88e43ce7"
    },
    {
      "section": "论正财",
      "text": "又如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0015",
      "sha256": "c951f6e073df0f6f75948385d95b70851d93e358f263ca7a3be7980eb4ced16b"
    },
    {
      "section": "论正财",
      "text": "乙卯 癸未 辛酉 戊子。此命辛日坐酉，年乙坐卯，身与财俱旺，又得癸未食神，戊子印绶助之，宜乎巨富贵也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0016",
      "sha256": "be9350a8a112cf776fbe7e7a0a927e0cbd814d08e0e80b8449c5b96fd79f4148"
    },
    {
      "section": "论正财",
      "text": "眉批：此言年上偏财自身坐禄，时上印生旺，所以为福。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 25,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c082:p0017",
      "sha256": "5d07b11fba187931b43f18b1b22aa7a2fa0d4f6f431b424c5c469b2fda2e797f"
    },
    {
      "section": "论正财",
      "text": "又如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0018",
      "sha256": "c951f6e073df0f6f75948385d95b70851d93e358f263ca7a3be7980eb4ced16b"
    },
    {
      "section": "论正财",
      "text": "戊子 丁巳 甲辰 丙寅。此命甲日生於四月下旬，并透出丙丁火生其月中之戊土，时又归禄於寅，故财旺矣，然甲木身亦旺。早年行戊午、己未运，运通。行辛酉运，乃见官星则凶。壬戌运有壬克丙，伤官食神之中，失官去财，死丧合家。值五十九岁入癸亥身旺运，稍可安逸。六十五岁逢壬辰年死矣。初运伤官见财，格取戊土为财，所以戊午、己未二运大旺，生土故财厚矣。及至庚申、辛酉，西方见官，故凡事费力。虽癸亥为甲木之印绶，然亦忌水冲火，亥中又有壬水，壬辰透出壬水，运中命中原有之辰，死无疑矣。凡伤官见财格忌见官星，只喜见财，若财格要见。大忌壬水克火，则火不能生甲木之土财也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c082:p0019",
      "sha256": "6b032c758ff644d2d528b7f241ecc8f5ec1a21eafe79dd02819e0822d783b0ce"
    },
    {
      "section": "论正财",
      "text": "眉批：论财喜见伤官，伤官又能生财，有化化之妙矣。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 24,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c082:p0020",
      "sha256": "bb84118f79af08b2b8f69945b1945094254a129e06b6386d28a73073fb7cd851"
    },
    {
      "section": "论正财",
      "text": "眉批：甲见己为正财，乙见戊为正财，丙见辛为正财，丁见庚为正财，戊见癸为正财，己见壬为正财，庚见乙为正财，辛见甲为正财，壬见丁为正财，癸见丙为正财。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 73,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c082:p0021",
      "sha256": "bcaa4d020c37fcc74e5d611ba94b198ea43ed6718806d1b016f73d7c718e41f4"
    }
  ]
}
