    {
      "section": "论日德",
      "text": "论日德",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c093:p0002",
      "sha256": "c86554af97d0afda36dbec55d2b968d6ed0cf0520ab133c26272c74864897e5b"
    },
    {
      "section": "论日德",
      "text": "日德有五：甲寅、戊辰、丙辰、庚辰、壬戌日是也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c093:p0003",
      "sha256": "71853d9be9f157cf180bfc02eaa954b6fca06cb823ec5be3f11260afeb4b2ff9"
    },
    {
      "section": "论日德",
      "text": "其福要多而忌刑冲，无破害，恶官星，憎财旺加临会合，怕空亡而忌魁罡，此数者乃格之大忌也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c093:p0004",
      "sha256": "6cac72034cdf03cfb0b3dd4dbfc3b23dd7069ae5f9f2934326e36f5a5d896711"
    },
    {
      "section": "论日德",
      "text": "大抵日德主人性格慈善。日德俱多福必丰厚，运行身旺，大是奇绝。若有财官加临，别寻他格，方能免非横之祸。若旺气已衰，运至魁罡，其死必矣。或未发福，运至魁罡，休囚即好，防生祸患。一脱於此，必能再发，终力微矣，不可不知也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c093:p0005",
      "sha256": "673f30b82b39efd8d7bcba203cdbfde8ea21e3a9313e81d9e5bf767fc065071f"
    },
    {
      "section": "论日德",
      "text": "眉批：此格忌刑冲破害，有损福泽。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 16,
          "layer": "historical_commentary",
