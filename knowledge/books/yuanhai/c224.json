  "raw_kind": "cleaned_original_transcription_not_complete_http_response",
  "extraction_kind": "selected_original_html_node",
  "issues": [],
  "passages": [
    {
      "section": "羊刃诗诀(劫财)",
      "text": "渊海子平卷五",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0001",
      "sha256": "d284d3c59105f6347a605b7d9c7a48dc5eebdc667d0b53daee688840ad6bd8a9"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "羊刃诗诀 (劫财)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0002",
      "sha256": "ab29239295d45e21d1292f0b7ecabefde8d02278b288e9e0321f8cb86f780700"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "羊刃存时莫看凶，身轻反助却为福，单嫌岁月重相见，莫把生时作怒宫。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0003",
      "sha256": "f653294b0d052276ef9811240aa1c727147b13896eb4aadfc092d8845386b8c5"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "马逢丙戊鼠逢壬，喜见官星七杀临，刑害无妨冲败惧，怕逢财地祸非轻。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0004",
      "sha256": "67cea9a48476dce0a98a3d196156f69011196adc7df2ff91f6f1b06117732d5b"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "壬子休来见午宫，午宫又怕子来冲，丙日坐午休重见，会合身宫事有凶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0005",
      "sha256": "4e5c71b77cd5d438161d9abc217d86071f2407d9bb09f96b053685f1f83259f2"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "日刃还如羊刃同，官星七杀喜交逢，岁君若也无伤劫，支上相冲立武功。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0006",
      "sha256": "004d5c0c6e4cc8f98e4aecdc52112c5778fb00f66683526982d74d20b66d536d"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "阳刃嫌冲合岁君，流年遇此主灾迍，三刑七杀如交遇，必定阎王再引徵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0007",
      "sha256": "96ba9b0c7aa20c7d8696a81d44cb42026b323f0f44f97d85e0c71ad433ad070e"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "时逢羊刃喜偏官，若见财星祸百端，岁运相冲并相合，勃然灾祸又临门。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0008",
      "sha256": "d41a14d977616226fa21846aeae634814130ae10231679758c2b34fd2db82c8a"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "羊刃重逢合有伤，生人心性气高强，刑冲太重多凶厄，有制方为保吉昌。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0009",
      "sha256": "f4419b87a51c4b2b31d15f7d2ff7ff70d583c8f2cee1d594f9da1386e205155c"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "羊刃之辰怕见官，刑冲破害祸千端，大嫌财旺居三合，断指伤残体不完。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0010",
      "sha256": "a23b242e823c3b6447c7889e886853936077423ffaf647b34a65b889e6648245"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "补：",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0011",
      "sha256": "ad592f8b264aaeddf8801e317f934c68fd9278174ad0fac30c18e20ba79ba084"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "刃逢七杀慕官乡，惟怕刑冲禄不昌，会合更逢财旺运，应防灾害致身殃。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0012",
      "sha256": "5de7f1dbf1134e25876332eb2cea9beadcbb689bc63b97f095a8ff929a852ef5"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "比肩阳刃格非常，要见官星与杀乡，元辰若无官杀制，再行比劫祸难当。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0013",
      "sha256": "435ebd8b1dc426493bc3db90d8507a1f7715fe7e84399cbc5ed73823c781b460"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "劫财阳刃不堪亲，四柱无财一世贫，出姓归宗还俗客，不然残疾亦伤身。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0014",
      "sha256": "bdf2b91e707917f43f2c3fd690822a7ba0aeccbc934805eecfd481c0a1b89c08"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "日干旺盛於年月，身旺专禄财官绝，那堪劫刃又相逢，百般机巧翻成拙。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0015",
      "sha256": "bf2889173849cbabc50dc5dfcf50cc2586a006b437e7bf818b085cc97c3dff42"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "日干旺甚无依倚，却喜岁运逢财地，元命有财见财发，无财见财寿夭折。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0016",
      "sha256": "48cbfdaaa7d7a8e05573090a250843f6ae8da5b135d1b5da7a43fb2b42e7149e"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "财星轻弱刃刚强，身旺之乡大不祥，凤寡鸾孤寒夜怨，等闲妻克两三场。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0017",
      "sha256": "27eb486926a65e02ed09b8e335a4f91a58ec0560a3b91f8705c490394e2f928f"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "阳神元旺日干强，四柱无财被克伤，重犯空亡华盖位，缁袍冠冕拜虚皇。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0018",
      "sha256": "4967829eb14af396453feb930f3125b6de7aac4963e450c7937f14e1980f6361"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "刃逢七杀运官乡，破害刑冲贵异常，切忌合逢财旺地，必遭灾祸反刑伤。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0019",
      "sha256": "87fe0ed1e713265c245c0993eedd41f1fc6b4cffb25f0fa5fb75e5aaf18d9c5b"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "日干阳刃宜逢杀，运转财官贵必迁，刑害俱全为吉地，财神会合是灾年。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0020",
      "sha256": "507ad1475c0ce806d80ffd3efcb8d50710f9b17856ddc7a570e9f6a6e4dafc84"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "春木夏火逢时旺，秋金冬水一般同，不宜阳刃天干露，岁运相逢事事凶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0021",
      "sha256": "ee4592d907b8cac6590448ff7a778fd829c0b0b23ed64f08d47f0588ddf228a6"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "丙生午月是刃根，运到江湖利名真，官旺喜行寅午戍，无官却要申子辰。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0022",
      "sha256": "7c0739313bf903b31d24536989f9798681bbe071d100426e777eb8efb6c05fe7"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "庚金酉月重生旺，除非火炼器方成，东南行运财名发，西北相逢祸便迎。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0023",
      "sha256": "952a0f0e068343088ba7bad595252bb5e9cd430f31af199b251b0fbcb3dc364a"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "壬生冬旺不无忧，透印藏官利禄局，逆顺不分还富贵，伤刑还破月提休。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0024",
      "sha256": "3f8e94094d006c14d6d31627ddd3cfd2db8aa2b6a9ed8b8befd65d3c6f94a257"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "水旺又生亥子宫，水多火弱格中重，重行火土财官旺，运到西北步步凶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0025",
      "sha256": "57d5b339ce444b1c7ed9d55faf499bb3b70371bd9e11a23c193dec1f949b78b8"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "阳刃常局在禄前，性刚果毅少慈怜，不宜会合防灾至，若见财星祸必缠。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0026",
      "sha256": "7c6c9e65b3f17fbc18b506043139123dede4a428830855600189440d43cb9f29"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "有官有杀名显达，无冲无破禄荣迁，更加刑害魁罡并，发迹边疆掌重权。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0027",
      "sha256": "eee9983debc200732be0aa4e678baa7a7c2a9efded0b9bba909217fe80081797"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "眉批：羊刃，禄前一位，即兄弟也，有财主分争。丙戊禄在巳，午为羊刃。壬禄在亥子为羊刃。羊刃格怕冲，有祸不浅。丙午、戊午、壬子皆为日刃。羊刃冲合岁君，勃然祸至。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 78,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c224:p0028",
      "sha256": "8eb9b20bce27c881eb7368ad0d36fb6700711e989e907aaa142b17a319dedc6b"
    },
    {
      "section": "羊刃诗诀(劫财)",
      "text": "羊刃见财必争，又怕冲合，必主祸。羊刃喜杀怕官星。天干有合地支有刑此羊刃者，并运又合，主凶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c224:p0029",
      "sha256": "0df55ec18a94213b94b6fe79a9f58614229e4e4838539c4353850e28a6134116"
    }
  ]
}
