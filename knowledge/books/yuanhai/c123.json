      "text": "外十八格 - 炎上格",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c123:p0002",
      "sha256": "4e32391cdb3ea4b4d59f2cc1ebc41b55222da456dd4f5ee5d5b96069aa681736"
