      "sha256": "baf2ee7ed15b3a937f005f939d0b141491484b6cc43f44fb8da6a2ce8ace07e2"
    },
    {
      "section": "外十八格-六壬趋艮格",
      "text": "且如壬水日主，多见寅字，则用寅中甲木，暗邀己土为壬日之官星。丙火邀辛金为壬日印绶，怕午字、申字冲之，忌财官填实。喜身旺地，岁运同。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c119:p0003",
      "sha256": "2d5a4d6fe54838aabdb2fdc01df8db2572456d40275ec89d97ef23561d9a06ed"
    },
    {
      "section": "外十八格-六壬趋艮格",
      "text": "寅为艮土之方，故曰趋艮。谓壬禄在亥，寅与亥合，又谓之合禄，亦忌破害。运行申冲坏寅字，不吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c119:p0004",
      "sha256": "b5c4a4ee18ebc695ed282e6a0a5c7d89286b3664d59802f47a9585e6282f895c"
    },
    {
      "section": "外十八格-六壬趋艮格",
      "text": "眉批：",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 3,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
