{
  "book_id": "yuanhai",
  "chapter_id": "c188",
  "title": "幽微赋",
  "source_url": "https://luckclub.cn/bazi/001/188/",
  "revision": "sha256:924dfb164fa8ac087672dd07549a315b20be1f7ec08df5c3c5f1b5cae7676f8f",
  "source_timestamp": "2026-09-06T04:11:01.198904+00:00",
  "layer": "historical_work_transcription",
  "facsimile_status": "not_checked",
