  "raw_path": "sources/yuanhai/c188.html",
  "raw_sha256": "924dfb164fa8ac087672dd07549a315b20be1f7ec08df5c3c5f1b5cae7676f8f",
  "raw_kind": "cleaned_original_transcription_not_complete_http_response",
  "extraction_kind": "selected_original_html_node",
  "issues": [],
  "passages": [
    {
      "section": "幽微赋",
      "text": "幽微赋",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0001",
      "sha256": "28f19e05ad4cc58d229de400683b9487c076a868ff0064f6d47f14df39fb95d9"
    },
    {
      "section": "幽微赋",
      "text": "天地阴阳二气，降於春夏秋冬，各生其时，有用者则吉，无用者则凶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0002",
      "sha256": "2b52eceb8e8b23934a1c7a8d02660cbb648be71f5a9f3bc238f3e83afe92b38f"
    },
    {
      "section": "幽微赋",
      "text": "是以泄天机之妙理，谈大道之玄微，天既生人，人各有命。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0003",
      "sha256": "62264920823f36cf877f50347ce9e1b945dba6ceb764ad7bd204d5ac792bd615"
    },
    {
      "section": "幽微赋",
      "text": "所以早年富贵，八字运限咸和；中主孤单，五行逢死绝败。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0004",
      "sha256": "3a0e8e992bcb39a9fddbbf5a83213292ff5f76c3121cfc8f3e65618b5eb83148"
    },
    {
      "section": "幽微赋",
      "text": "过房入舍，年月冲分。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0005",
      "sha256": "fe56eeffa1030354f7ca1844d45f6b2000e39843f88183a6a3a150fbb57978a9"
    },
    {
      "section": "幽微赋",
      "text": "随母从夫，偏财空而印旺。早岁父亡，偏财临死绝杀宫；幼岁母离，只为财多印死。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0006",
      "sha256": "4030a5863b97f5232a69e5044018061d397493ff2fe52eef7dea231d77336563"
    },
    {
      "section": "幽微赋",
      "text": "比肩多而兄弟无情，羊刃多而妻宫有损。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0007",
      "sha256": "c52519cdb93625f151d31dbf8cf1e8b9c215fae1171e23f31899c884c5acd8c5"
    },
    {
      "section": "幽微赋",
      "text": "官逢死气之方，子招难得；若见伤官太盛，子亦难留。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0008",
      "sha256": "30969ad035ad965137365a0a6c069288bba81d80d5bc2440363a9bd3a1524e7e"
    },
    {
      "section": "幽微赋",
      "text": "如遇冲破提纲，定主离于祖业，再见空亡，三番四废。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0009",
      "sha256": "aa7b490dd2ee3525598e364691dd5a5df5720973ff442d302aec38466f57126f"
    },
    {
      "section": "幽微赋",
      "text": "印绶逢生，母当贤贵；偏财归禄，父必峥嵘。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0010",
      "sha256": "d4cf0844279bea5be0e1c5020cad9deeb668d439dc11a0a5b61e3447ce25dc80"
    },
    {
      "section": "幽微赋",
      "text": "官星临禄旺之乡，子当荣显。七杀遇长生之位，女招贵夫。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0011",
      "sha256": "b4866dab3643a0bd83a1a829c1cd9c86637a1f9571393e0a33db1f3c1b3cd6c3"
    },
    {
      "section": "幽微赋",
      "text": "自身借宫所生，必是依人过活。妻星失令，半路抛离，若乃借宫所生，亦是他人义女。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0012",
      "sha256": "e929ada5ef6a5950db0e64278581df0e62cb051fd183520ce6dc160a10a4d791"
    },
    {
      "section": "幽微赋",
      "text": "酒色倡狂，只是桃花带杀。慈祥敏慧，天月二德聚来。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0013",
      "sha256": "f8590bebbec915bb277089e459107e7dddd444292771300b6c9586e4774362ba"
    },
    {
      "section": "幽微赋",
      "text": "印绶旺而子少息稀，正官旺而女多男少。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0014",
      "sha256": "d1a7cf0cee1f028a1c853fb9b46c3858565af2e648ea2574294c9b2b76eb14bb"
    },
    {
      "section": "幽微赋",
      "text": "枭神兴早年折夭，食神旺老寿弥高。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0015",
      "sha256": "00ea8a15162ddb6024b354afca1192f4ebb51f714c167d78fcce88e971f47759"
    },
    {
      "section": "幽微赋",
      "text": "偏财逢败，父主风流。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0016",
      "sha256": "ef1e5a2339a49afdaf5f1b36dc55d0d8942cf07c93ede84408200ac42ee35e8d"
    },
    {
      "section": "幽微赋",
      "text": "子曜若临，破家荡産。自身逢败，早岁兴衰。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0017",
      "sha256": "f5c9f6a8bb88a7273910717e203acb9489b9d65b435c878fd71e692683aa8a74"
    },
    {
      "section": "幽微赋",
      "text": "妻入墓不得妻财，父临库父当先死。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0018",
      "sha256": "27fb615da15d59ca57f5045ac2889e196a6c43de4649971978df94b0fab7fd63"
    },
    {
      "section": "幽微赋",
      "text": "比肩逢禄，兄弟名高。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0019",
      "sha256": "76c4d033a9ff99899e7efffd7f4c8510011cc8aedb09d46ed9bc4f60d2ae94c1"
    },
    {
      "section": "幽微赋",
      "text": "食神多而好饮食，正官旺而受沾滋。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0020",
      "sha256": "27528b00094e05dbe2947f0e155bb0d2b9a016b1b24c78c83f6969e1e74c85ae"
    },
    {
      "section": "幽微赋",
      "text": "身临沐浴之年，恐愁水厄。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0021",
      "sha256": "1c6b5c18934ab4f1c47054708a525ec169ab83866c512a54f3b1f42c4cfa63dc"
    },
    {
      "section": "幽微赋",
      "text": "(眉批：自身败，在沐浴之地。)",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 15,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c188:p0022",
      "sha256": "a2eef05dbf1d0489e18d473f1e8236dfb56608d052256c01fe61fa8b7db73350"
    },
    {
      "section": "幽微赋",
      "text": "生入战克之年，必逢火灾。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0023",
      "sha256": "77e727301560e9f281c1149f698582db2ad2a641a83c02ac4641b0dc90d2ae5f"
    },
    {
      "section": "幽微赋",
      "text": "女带桃花坐杀，定主淫奔。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0024",
      "sha256": "8eb9533ace4abd940e416eeef056e9b594bbdada977f77188b6ab213ae25f597"
    },
    {
      "section": "幽微赋",
      "text": "伤多而印绶被克，母当淫荡。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0025",
      "sha256": "17912b6d0c807baf1a40a9d1e0a82ef1684136ec88651098b1d8cf2f8f6fffb0"
    },
    {
      "section": "幽微赋",
      "text": "年月冲者，难为祖业。日时冲者，妻子招迟。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0026",
      "sha256": "7e722cfe117b55c0e7bbecb58c20f86b0c368171786efbfea78ff768f2cd2e66"
    },
    {
      "section": "幽微赋",
      "text": "若见天元刑战，父母难靠。如遇地支所生，凶中成吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0027",
      "sha256": "83dc9dca9e927ee9c540b696cc332a5d9dd2bf151ceffb5cda19444df5ee3400"
    },
    {
      "section": "幽微赋",
      "text": "日主弱水火相战，而招是非。甲木衰逢金旺，而无仁无义。(木主仁金主义，故曰仁义俱无。) 此乃男命之玄机。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0028",
      "sha256": "d13eacd9fa5c25cb6f031142cf5ee86f8ef97bda74f8607dd44900227ee4c8a1"
    },
    {
      "section": "幽微赋",
      "text": "略说女人之奥妙，纯粹在於八字。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0029",
      "sha256": "b8f221b07517117685e2c43ff9e49ac380ddb80bce58047b897b46d7ed135394"
    },
    {
      "section": "幽微赋",
      "text": "纯有富贵者，一官生旺。四柱休囚，必为贵者。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0030",
      "sha256": "6797b63212ddaa97e9752ead4897c4b2b1c660e056b12e10ab26880a3bad143e"
    },
    {
      "section": "幽微赋",
      "text": "浊淫者五行冲旺，娼淫者官杀交差。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0031",
      "sha256": "7892ce3ad35a480c3646333c687258e109e3a168770d7306dd1a1804dc450b87"
    },
    {
      "section": "幽微赋",
      "text": "命主多合，此为不良。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0032",
      "sha256": "6c7d3dc09d81be9700ecff47ca9d65cb8c9339d4d1c77c21561ce03e68f7c4fe"
    },
    {
      "section": "幽微赋",
      "text": "满柱杀多，不为克制。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0033",
      "sha256": "09daebc578a6cf512f70952794469db71c32daafe9ce84ccffe42a0e1702a264"
    },
    {
      "section": "幽微赋",
      "text": "印绶多而老无子，伤官旺而幼伤夫。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0034",
      "sha256": "4fc43d68e66091e7093f90d63f426120d9c78003ebcb7993b7cc939d338dec38"
    },
    {
      "section": "幽微赋",
      "text": "荒淫之欲，食神太过。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0035",
      "sha256": "7af50efacd43237aaedee2484974767a0b6f197d574a995bd56150f5bee58d30"
    },
    {
      "section": "幽微赋",
      "text": "四柱不见夫星，未为贞洁。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0036",
      "sha256": "4ed728eb5b09a0e2b600603e43dd6a1698a7a03736f23b8a7bfed7c47c064fdf"
    },
    {
      "section": "幽微赋",
      "text": "官星绝遇休囚，孤孀独宿。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0037",
      "sha256": "eae89dff36da43af09cdb04b4bca56d7416ded01f6755ae840765b5ee5338660"
    },
    {
      "section": "幽微赋",
      "text": "清洁源流，金猪(辛亥)相遇，木虎(甲寅)相见。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0038",
      "sha256": "031fa8092225bcb15a2861aebbe8d50dc0a818e51a0b713fd5bdc245c24a5f70"
    },
    {
      "section": "幽微赋",
      "text": "四柱三夫，土猴(戊申)重叠。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0039",
      "sha256": "328f98b25439ff273cb1fa1c32e115d71f631ce9354107bc9dc5434ad147f965"
    },
    {
      "section": "幽微赋",
      "text": "水火逢蛇(癸巳，丁巳)，夫宫早丧。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0040",
      "sha256": "c055d0cf8a3d1e02ebfbd83e3486d5090a084603f27282a480e487d7aa8534a5"
    },
    {
      "section": "幽微赋",
      "text": "食神一位逢生旺，招子须当拜圣明。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0041",
      "sha256": "2a97eae3478606c7cbff22188e9c240da6c98acc696eb00a0a619fe4bdaf4d6c"
    },
    {
      "section": "幽微赋",
      "text": "父母之宫，男命同断。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0042",
      "sha256": "9e37585d395127f89bf2ec8b4c816a4fb4117340af9b54f7008688ed20a147ec"
    },
    {
      "section": "幽微赋",
      "text": "若见此书，藏之如宝，若遇高士，对镜分明，依其此法、万无一失。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c188:p0043",
      "sha256": "697eecfd351673520f3adc3107d9b6acc1a197ea13a5b29d4934ac99359af003"
    },
    {
      "section": "幽微赋",
      "text": "眉批：年为祖业，月为提纲，月冲年则伤祖业，日冲月则伤父母及妻，日冲时必主妻子暗损。“孀”者，妇人丧夫曰孀妇。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 54,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c188:p0044",
      "sha256": "08039f9f6250c8203fc3a52dbbaf8867b0ee41f92012efbc9e14257abb5bc6e3"
    }
  ]
}
