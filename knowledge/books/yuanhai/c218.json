  "passages": [
    {
      "section": "偏官诗诀",
      "text": "渊海子平卷五",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0001",
      "sha256": "d284d3c59105f6347a605b7d9c7a48dc5eebdc667d0b53daee688840ad6bd8a9"
    },
    {
      "section": "偏官诗诀",
      "text": "偏官诗诀",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0002",
      "sha256": "f2670afe7acb4191019ce6bc0c575bc30afbe4261ae121869f4fb7ba8ce926de"
    },
    {
      "section": "偏官诗诀",
      "text": "(七杀同)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0003",
      "sha256": "cf8183ad30b05640e1a0821f482003d63a7d82f9cb244c30ae42f86dca2f46d6"
    },
    {
      "section": "偏官诗诀",
      "text": "偏官如虎怕冲多，运旺身强岂奈何，身弱虎强成祸患，身强制伏贵中和。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0004",
      "sha256": "39a744540b1e61c792a488b6d7508bb14563d60f4cbd1d2b375075060c172a36"
    },
    {
      "section": "偏官诗诀",
      "text": "偏官有制化为权，垂手登云发少年，岁运若行身旺地，功名大用福双全。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0005",
      "sha256": "bd2fb1772ba58058974ef5dbcfad099a7a08d16d229a4396d053dbf0aec16930"
    },
    {
      "section": "偏官诗诀",
      "text": "偏官不可例言凶，有制还他衣禄丰，干上食神支又合，儿孙满眼福无穷。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0006",
      "sha256": "9ccf396787b81e7922a1fbf5f3b1abb74ffa8ccf893ceaf11db6ccf953cf7d9d"
    },
    {
      "section": "偏官诗诀",
      "text": "阴癸多逢己字伤，杀星须用木来降，虽然名利升高显、怎奈平生寿不长。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0007",
      "sha256": "a1639f08c48159963cc7e19618b5bcf0e698a85c1197e7d9bd79e0c6040a571d"
    },
    {
      "section": "偏官诗诀",
      "text": "六丙生人亥子多，杀星拘印反中和，东方行去兴名利，运到西方事转磨。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0008",
      "sha256": "028f6f4a01ceab9c9f800c8df1078d8fa70c3f88b4a14c20f90a0a84f3a94968"
    },
    {
      "section": "偏官诗诀",
      "text": "春木无金不是奇，金多尤恐反遭危，柱中取得中和气，福寿康宁百事宜。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0009",
      "sha256": "cbabd81c11dad0d27f790523888f5dddaf19884ee826bd67ce60f2906fe2a601"
    },
    {
      "section": "偏官诗诀",
      "text": "偏官偏印最难明，上下相生有利名，四库坐财直向贵，等闲平步出公卿。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0010",
      "sha256": "d579f2488b2da2daa4b335de65f2ced7f4c52052600a6c5c396079ee90d188c9"
    },
    {
      "section": "偏官诗诀",
      "text": "戊己若逢见官杀，局中金水更加临，当生有火宜逢火，火退愁金怕水侵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0011",
      "sha256": "722ce5bcf1a75ba4eff3445cb0047d94861b7e6aa8ab0864f24886f64e542fb8"
    },
    {
      "section": "偏官诗诀",
      "text": "补：",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0012",
      "sha256": "ad592f8b264aaeddf8801e317f934c68fd9278174ad0fac30c18e20ba79ba084"
    },
    {
      "section": "偏官诗诀",
      "text": "身逢七杀旺提纲，只为干衰大受伤，正禄交差刑杀入，终身不免受灾殃。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0013",
      "sha256": "4adf34f0a809a74331e9cadf7c103872e56db8a5d5baf576165618274add40e6"
    },
    {
      "section": "偏官诗诀",
      "text": "七杀提纲本是愁，只因驯伏喜无忧，平生正直无邪曲，职位高封万户侯。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0014",
      "sha256": "7b36fd06b1dab2431d11496e823ae6d1a00a4712fd37bdc28fc6b543e0fb587b"
    },
    {
      "section": "偏官诗诀",
      "text": "月令偏官本杀神，有制还居一品尊，假若自身荣贵晚，也须为福及儿孙。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0015",
      "sha256": "40ae4432373e3aab2dc182bcd0fcb32665a82000b0d19d59007217b234b508f5"
    },
    {
      "section": "偏官诗诀",
      "text": "月令偏官最忌冲，伤官羊刃喜相逢，日干旺相皆为贵，制伏无过百事通。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0016",
      "sha256": "d915f3f8883c8f8342f59a6e140f08df2d61dd45b9ecf9315728dd417d4c5bdc"
    },
    {
      "section": "偏官诗诀",
      "text": "偏官有制化为权，英俊文章发少年，身旺定登台谏客，印助扶官累受宣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0017",
      "sha256": "fc03dba3b7a17da51936e343db37b3001cd5ec279f6f81cb0dd0adf1c2e32b5d"
    },
    {
      "section": "偏官诗诀",
      "text": "若逢七杀化为权，武职功名奏九天，威镇边疆功盖世，貔貅云拥尽扬威。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0018",
      "sha256": "2f32ac8f6304daeac61dce26938615874c808870209ca51c5d08f8685fe435ed"
    },
    {
      "section": "偏官诗诀",
      "text": "杀神元有制神伤，制伏身强福禄昌，如见制伏先有损，反将富贵变灾殃。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0019",
      "sha256": "c145faf155ac64ca9bd4909f29932c3d1082a0487cced955056aa50e0b6ac864"
    },
    {
      "section": "偏官诗诀",
      "text": "伤官七杀命中嫌，制伏调和可作权，日弱又无制伏者，兢兢如抱虎而眠。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0020",
      "sha256": "169d67163ed4e37b98d8ddea632e761dbe51e8c5239498cb2a84d6982b3c6048"
    },
    {
      "section": "偏官诗诀",
      "text": "身弱杀强无制神，多生灾祸不堪论，那堪更入官强地，带疾遭刑丧此身。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0021",
      "sha256": "4a328f9ecf10d8228f3e81657ba207551a08b53315fc3b0496d4faa2b6d84f82"
    },
    {
      "section": "偏官诗诀",
      "text": "偏官制伏太过时，贫儒生此更何疑，岁时若遇财旺地，杀星苏醒发权威。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c218:p0022",
      "sha256": "85a199ce450a7d958970104edf925e1c19f70205f61286bffcb6dec16531ed76"
    },
    {
      "section": "偏官诗诀",
      "text": "眉批：偏官无制为七杀，克我之人也。身强则贵，身弱则贱，此皆要身旺。食神制杀，癸水以己土为杀，以乙木克之方吉。丙以水为杀土为伤食，土制水不伤丙为和。春木乘旺，故喜杀。戊己以甲乙为官杀，忌金。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 94,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c218:p0023",
      "sha256": "befeaf62efe451376d3a07e39ed2df6c7409db5cf6748daf59b736feea4238c1"
    }
  ]
}
