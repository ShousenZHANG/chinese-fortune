      "passage_id": "yuanhai:c261:p0002",
      "sha256": "17ffcd7f3b304e5116d3132febf6d46d214860c12d1be812947676b253b41baf"
    },
    {
      "section": "克妻诗诀",
      "text": "天干透露弟兄多，财绝官衰旺太过，月令又逢身旺地，青春年少哭娇娥。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c261:p0003",
      "sha256": "eec226aa255d048ccdc8336b8ffe3eabb9e630b449ac1aeb80b0f1a77d37618b"
    },
    {
      "section": "克妻诗诀",
      "text": "当生四柱有财星，羊刃逢时定克刑，岁逢运行妻眷绝，妻宫频见损年龄。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c261:p0004",
      "sha256": "69a9ca2a40d2c9e6d59abaca20dcef6a73e23615b9d7d614aca21cc5fad21adc"
    }
  ]
