  "raw_sha256": "8aec9b6625a18b4c487e45e92c9de662929597fa74a3653ce9ed9dd2d0b7e49b",
  "raw_kind": "source_wikitext",
  "extraction_kind": "frozen_mediawiki_revision",
  "issues": [],
  "passages": [
    {
      "section": "六沖章第二十",
      "text": "子午相沖、丑未相沖、寅申相沖、卯酉相沖、辰戌相沖、巳亥相沖。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0001",
      "sha256": "bcbf27645a19f8bd235e2216682943df3b6ba9dc2542c78c6f2f0f7a94f2e4fa"
    },
    {
      "section": "六沖章第二十",
      "text": "相沖之法有六。日月沖爻者一也，卦逢六沖二也，六合卦變六沖三也，沖變六沖四也。動爻變沖五也、爻與爻沖六也。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0002",
      "sha256": "fff391fd6b96a01e5e6f7bdbcf15afd505ed9c542c1f4fb992af9aeeeae00f1a"
    },
    {
      "section": "六沖章第二十",
      "text": "沖者散也，凡占凶事宜於沖散、占吉事而不宜，必兼用神而言，用神旺𨿽沖不破，用神失陷凶而又凶，六合卦變六沖卦者，用神旺者始吉終凶，圖事難成，有始無終也。爻沖有五：爻與月沖謂月破。爻遇日沖爲暗動。休囚而遇日沖謂之日破。動爻化回頭沖。如逢仇敵。爻遇爻沖謂之相殺也。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0003",
      "sha256": "f8eb75ae791fd0dc18f842a21465bbd01dc50445b6391eb9d5d5ed6880f8be93"
    },
    {
      "section": "六沖章第二十",
      "text": "如巳月戊戌日占財得風雷益",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0004",
      "sha256": "a29ff41c5ec1acea2641cd598bb588b16d2a83d05136ce75814f5338cffc13ad"
    },
    {
      "section": "六沖章第二十",
      "text": "兄弟卯木⚊應\n子孫巳火⚊\n妻財未土⚋\n妻財辰土⚋世\n兄弟寅木⚋\n父母子水⚊",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0005",
      "sha256": "f9e9b84e7130953b0926ce20614d77c3a2cc02dfa4eeec6f35cd46fc34fa3e00"
    },
    {
      "section": "六沖章第二十",
      "text": "辰土財爻持世，因值旬空，戌日沖空塡實，本日辰得財。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0006",
      "sha256": "65a7fff3c7039dc8943dd63360712bc30555590435e344335b6818d8c0630bb3"
    },
    {
      "section": "六沖章第二十",
      "text": "又如午月丙辰日占出外經商貿易財如何得恆之豫卦",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0007",
      "sha256": "074cca55b90832cf3933c85abb33c536761bcf6637b5251afd25b4b56cfd55c7"
    },
    {
      "section": "六沖章第二十",
      "text": "妻財戌土⚋應　妻財戌土⚋\n官鬼申金⚋　　官鬼申金⚋\n子孫午火⚊　　子孫午火⚊\n官鬼酉金○世　兄弟卯木⚋\n父母亥水○　　子孫巳火⚋\n妻財丑土⚋　　妻財未土⚋",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0008",
      "sha256": "a4dad4bee612908ac5330091d1ec08900fbb54b6cf0bbf659275dd566bd5c887"
    },
    {
      "section": "六沖章第二十",
      "text": "世爻酉金化卯相沖及反復之卦，幸辰日合之，沖中逢合，又得戌土爲財，暗動生世，𨿽則反復不常，卻有財利。果此人去而復反者三次，中途發財。前曰：爻動化沖，如逢他敵，乃是化回頭之克也。此卦世爻酉金化卯沖世而不克世，又得辰日沖動戌財生世所以爲吉。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0009",
      "sha256": "2eedaec90201ab0b87b1dfcfc903bb4ffa9ac4236a5223c575a19ba9c37a4614"
    },
    {
      "section": "六沖章第二十",
      "text": "又如酉月乙未日占子久出不歸生死如何得坤卦",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0010",
      "sha256": "8d67f79fc9f5d4a677386f6073d3cb2f80a139cc581370866ddc3711efdaf13d"
    },
    {
      "section": "六沖章第二十",
      "text": "子孫酉金⚋世\n妻財亥水⚋\n兄弟丑土⚋\n官鬼卯木⚋應\n父母巳火⚋\n兄弟未土⚋",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0011",
      "sha256": "68027f0549386ce89b29bb4b0f3c8589a4b729084d03544c28c531cd5c36291d"
    },
    {
      "section": "六沖章第二十",
      "text": "世持子孫以臨月建，未日生之，𨿽是六沖之卦，此子必歸。果於子年建功卯年得意而歸，此應靜而逢沖之驗也。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0012",
      "sha256": "f684ffd0ba4abaef2ebfd1e5484b603470442c7a21568ac68a37a90f1076a318"
    },
    {
      "section": "六沖章第二十",
      "text": "又有巳月甲寅日占嚴師訓子得天地否卦變乾卦",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0013",
      "sha256": "98256b93ce8617bf370bd11faba25f073408458d38a71f114c449a6c3dcbf627"
    },
    {
      "section": "六沖章第二十",
      "text": "父母戌土⚊應　父母戌土⚊\n兄弟申金⚊　　兄弟申金⚊\n官鬼午火⚊　　官鬼午火⚊\n妻財卯木ㄨ世　父母辰土⚊\n官鬼巳火ㄨ　　妻財寅木⚊\n父母未土ㄨ　　子孫子水⚊",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0014",
      "sha256": "c5cddd1ede55f45a6d0d5f0e2debb9f065cd4faff7be352d9a4b45fd4f1014d0"
    },
    {
      "section": "六沖章第二十",
      "text": "以應爲用神，世應相合，應臨戌父，巳月生之，乃飽學之士，獨嫌卦變六沖，合而變沖，不久之兆，彼問曰：因何事而不久？予曰：子水子孫值旬空，卦中未土父動，防子孫災變，後果兩月，其子得病，辭師未久而子死矣。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0015",
      "sha256": "12545827e7222b3762d5ef63150b8bc44f8cf321408e84e53acbe65ce2004edd"
    },
    {
      "section": "六沖章第二十",
      "text": "凡得六合變六沖者，諸占先合後離、先親後疏、先濃後淡，始榮終悴，得而復失成而後敗、惟占官非，盜賊事者宜之。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0016",
      "sha256": "5db0214c11a893d09871a595f21d486158d346a2e88c9baf70c4cb7bab52ddd3"
    },
    {
      "section": "六沖章第二十",
      "text": "如申月己卯日父子七人俱蒙拿問。得巽卦變坤卦",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0017",
      "sha256": "e4be0ba2f2b88d552e6bb99b787e18a4900c4c3320abdb27ae7952d57f982e9c"
    },
    {
      "section": "六沖章第二十",
      "text": "兄弟卯木○世　官鬼酉金⚋\n子孫巳火○　　父母亥水⚋\n妻財未土⚋　　妻財丑土⚋\n官鬼酉金○應　兄弟卯木⚋\n父母亥水○　　子孫巳火⚋\n妻財丑土⚋　　妻財未土⚋",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0018",
      "sha256": "f46e752934ae86cfafd7acdd8f3272d802b2f7021ba59e99a942621dc76bb429"
    },
    {
      "section": "六沖章第二十",
      "text": "此系卦變巽木化坤土，名爲化去不克，當主無妨，只因世爻變鬼，卯木化酉金，木破金克，巳火子孫又化亥水，父子兩爻皆被其傷，六沖亂室，一家俱受刑。占法皆以六沖卦宜於官事，喜其沖散，然必看木之大小，又宜兼用神而言，此卦六沖變沖，亦可謂之官事逢沖而散。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c021:p0019",
      "sha256": "9d5c36a210d914aec581a0117eae0a9dba99cabbc83dad2879fc1a3554c455f9"
    }
  ]
}
