  "raw_path": "sources/zengshan/c026.wiki",
  "raw_sha256": "10c6f672b4b68ea46217d8f053a8668034a757d5899447fda3f0934b82537fa2",
  "raw_kind": "source_wikitext",
  "extraction_kind": "frozen_mediawiki_revision",
  "issues": [],
  "passages": [
    {
      "section": "反伏章第二十五",
      "text": "卦有卦變，爻有爻變。卦變者內外動而反伏者同一卦也。如乾卦變坤卦。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0001",
      "sha256": "ac91c812849ade246cf753b701e86c14d6e7061bcd8ac9ada2dd44648f75cceb"
    },
    {
      "section": "反伏章第二十五",
      "text": "爻變者內外爻動而反伏者，非同一卦也。如升之觀是也。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0002",
      "sha256": "8a3b6c5d0513d80795474f45d14b942c6f7c34d5e642bba085956d6ab3320175"
    },
    {
      "section": "反伏章第二十五",
      "text": "又有外卦反伏而內卦不動者，如觀之坤是也。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0003",
      "sha256": "7c025002a381b6783ebc4d78d44c513cae89eb891763fb68ed2aef147f055822"
    },
    {
      "section": "反伏章第二十五",
      "text": "又有內卦反伏而外卦不動者如巽之觀是也",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0004",
      "sha256": "48a5341923a114dfa1bed37285c9abbee1fcc24be6b433aaa3118b3c7867516b"
    },
    {
      "section": "反伏章第二十五",
      "text": "內卦反伏，內則不安。外卦反伏，外則不寧。內外反伏者，內外不寧之象也。皆主成而敗，敗而成，有而卽無，無而卽有，得而失，失而得，來而去，去而來，散而聚，聚而散，動而思靜，靜而思動。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0005",
      "sha256": "ee2efd42e364224a3171c747ffc7cff978d92bd83fc5d69c0592c3edb9f67574"
    },
    {
      "section": "反伏章第二十五",
      "text": "占功名者，用爻旺相，遷而又行往他處，去而仍復來。用神失陷有或降或升，或得或失矣。占財物聚散不常，買賣經營興衰往來不定。占墳墓宅捨，欲遷不遷，或遷之而再遷，或目下就有遷移之事，占以久遠之事者目前就有變動。占天時晴而卽雨，雨而又睛。占婚姻反復難成。占疾病愈而有病。占盜賊官非，見而又見。占出行，行至中途變反，卽使到彼，一事無成。占行人外卦反伏者，用神旺相必歸，不然變他處。在外之人而占家宅者，內卦反伏，家庭人口不安。占彼此之形勢者，內卦反伏，我亂他定，外卦反伏，他亂我定。反伏卦用神旺相不變沖克者𨿽則反復，事之必成，第恐用神而化回頭之沖克者，卽是卦變大凶之象，如卯月壬申日占隨官府上任。得比之井",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0006",
      "sha256": "918a4f2d6ae1dc6a3911cba6b48e1f9792555437e9ba8a93dd2d87bdd3c67163"
    },
    {
      "section": "反伏章第二十五",
      "text": "妻財子水⚋應　妻財子水⚋\n兄弟戌土⚊　　兄弟戌土⚊\n子孫申金⚋　　子孫申金⚋\n官鬼卯木ㄨ世　子孫酉金⚊\n父母巳火ㄨ　　妻財亥水⚊\n兄弟未土⚋　　兄弟丑土⚋",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0007",
      "sha256": "39cdcc9df7717be4cba232e4a059ca478f421e3b9fc239717ca4e43cb8eb9a99"
    },
    {
      "section": "反伏章第二十五",
      "text": "斷曰：世臨官鬼值月建而旺，隨去必成，因內卦反伏，事有反復，不宜世爻絕於申日又化回頭沖克，此行不吉，不去者爲上，後有官府直接得缺，近於賊營，辭而不去，及至官府去後，忽又因他故而隨去矣，至七月城破與官府一同被害。與官府同害者，世爻與官鬼同受酉金之沖克也，不去而又去者，卦得反伏之故也。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0008",
      "sha256": "91b4942317ad99c8b15cde17d23d34b6b9ab3c2b4fa21ad8e4ca2a36941283ee"
    },
    {
      "section": "反伏章第二十五",
      "text": "又如卯月己亥日占升遷，得臨變中孚。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0009",
      "sha256": "411ac89e22938dbd970222927aa849638a89aedde53926ed33235f8f316f3aa3"
    },
    {
      "section": "反伏章第二十五",
      "text": "子孫酉金ㄨ　　官鬼卯木⚊\n妻財亥水ㄨ應　父母巳火⚊\n兄弟丑土⚋　　兄弟未土⚋\n兄弟丑土⚋　　兄弟丑土⚋\n官鬼卯木⚊世　官鬼卯木⚊\n父母巳火⚊　　父母巳火⚊",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0010",
      "sha256": "7560118dfbd16f268c37339d0497c017e86b8f4f982371fcb02aef5fdacd52d1"
    },
    {
      "section": "反伏章第二十五",
      "text": "斷曰：世臨卯木月建之官，又長生於亥日，世與官星同臨旺地，許之卽升，果於本月聞報，由江西升任山東，未及一載復任江西，應本月升者卯官而值月令升山東者，官臨卯木，復任江西者，外卦反伏，去之而復反也。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0011",
      "sha256": "0c3d0f2ee3c483b49dc2527eca113e22a5677db52fb615bb31ea76bed585a512"
    },
    {
      "section": "反伏章第二十五",
      "text": "反伏者有內外伏呤者，內外憂鬱呻吟之象。內卦動變伏吟，內則呻吟，外卦動變伏吟，外則憂鬱。占名者久困官途，淹畱任路。占利者財源耗散，無利可圖。占墳塋宅捨，欲遷而不能，守之而不利。占婚姻而不樂。占疾病呻吟。占口舌官非，事非難解。占出行總於動移。占行人在外憂鬱。占彼此之形勢者，內卦爲我，外卦爲他，內伏吟我心不遂，外伏吟他忌不安。然伏吟而較反吟者，反吟有沖有克，爻若受克，得禍不輕。伏吟之卦，用神旺相，沖開之年月，其志則伸，用神休囚，沖開之年月，憂鬱不吉。如申月癸巳占父外任平安。得到姤之恆卦：",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0012",
      "sha256": "a375cee8a4db2dfcdd317015f6818ac882e20c25d2a89a20ef09928c643f3ed4"
    },
    {
      "section": "反伏章第二十五",
      "text": "父母戌土○　　父母戌土⚋\n兄弟申金○　　兄弟申金⚋\n官鬼午火⚊應　官鬼午火⚊\n兄弟酉金⚊　　兄弟酉金⚊\n子孫亥水⚊　　子孫亥水⚊\n父母丑土⚋世　父母丑土⚋",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0013",
      "sha256": "25e9cad53fef5eafa76046de356829d0f2ad4078848f7cf8a46869ed9520c76f"
    },
    {
      "section": "反伏章第二十五",
      "text": "斷曰：巳火日辰生父母，當許在任平安，獨憂卦得伏吟，乃是不祥之象，任上必有事故，不得意以呻吟也。彼曰：開地方苗獨之變，可有妨礙否？予曰：日建生父，他事無礙。有問：何時歸來？予曰：伏吟欲歸而不能，辰年可歸，後知苗獨作亂，地方不祥，驚險異常，寅年占卦，辰年缺歸，午年又官者，占時遇巳日扶起午火之官，當日亥水克之而不盡，今午火官星值年依然旺矣。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0014",
      "sha256": "bc5981a9d882c46b75c737f57ec9c94fe47f501b0d451becf1b254873b0d27e7"
    },
    {
      "section": "反伏章第二十五",
      "text": "李我平曰：易林補遺有曰，爻有伏吟不吉，術者未聞卦有反吟最凶，占卜家誰覺？不看用神之衰旺竟以反吟爲畏途，今野鶴此論法，比之井卦，世途沖，事反伏，身受其殃。臨之中孚，世官得地，𨿽反伏，官連遷轉，教人之法，何等透澈。",
      "layer": "historical_work_transcription",
      "passage_id": "zengshan:c026:p0015",
      "sha256": "d7882ce4f3305d4cb4131a78a9e43b95cf506669efac3ff93274b078d93fa64d"
    }
  ]
}
