{
  "book_id": "ditian",
  "chapter_id": "c003",
  "title": "地支論",
  "source_url": "https://zh.wikisource.org/w/index.php?title=%E6%BB%B4%E5%A4%A9%E9%AB%93%2F03&oldid=844351",
