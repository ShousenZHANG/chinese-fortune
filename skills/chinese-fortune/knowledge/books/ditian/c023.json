  "passages": [
    {
      "section": "隱顯論",
      "text": "吉神太露，起爭奪之風，凶物深藏，成養虎之患。",
      "layer": "base_text",
      "passage_id": "ditian:c023:p0001",
      "sha256": "c173afea17c9bab22dbad18c2f331543b2c130e9b6557ba537d3577d1c89c8f2"
    },
    {
      "section": "隱顯論",
      "text": "局中所喜之神，透於天干，歲運傷之，局中所忌之神，伏於地支，歲運扶之，皆為禍患，故暗用吉神則吉，如明露忌神，制化得所者亦吉。",
      "layer": "commentary",
      "passage_id": "ditian:c023:p0002",
      "sha256": "d44daa5ffa15220bc612c8bb91f26b28c673f6def66754fc8943a7898ff9cb5c"
    }
  ]
}
