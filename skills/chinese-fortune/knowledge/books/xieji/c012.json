    {
      "section": "春牛經",
      "text": "造春牛芒神用冬至後辰日於歲徳方取水土成造用桑柘木為胎骨\n牛身高四尺象四時頭至尾樁長八尺象八節",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0030",
      "sha256": "5e5197c6f2360c85ac698b9b436d5304af39e7374b027cea4ac37fba185497f5"
    },
    {
      "section": "牛頭色視年干",
      "text": "甲乙年青色　丙丁年紅色　戊巳年黄色庚辛年白色　壬癸年黒色",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0031",
      "sha256": "c38975b54daea9a9dc5d53acce540f2c17cb428c7dd18c9f61bd362c6dbb4ddc"
    },
    {
      "section": "牛身色視年支",
      "text": "亥子年黒色　寅卯年青色　己午年紅色申酉年白色　辰戌丑未年黄色",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0032",
      "sha256": "54f2fc9303649d5335b3d3be341fdc91743d0face3a1404803b81d69a6b77de1"
    },
    {
      "section": "牛腹色視年納音",
      "text": "金年白色　　木年青色　　水年黒色\n火年紅色　　土年黄色\n牛角耳尾色視立春日干\n甲乙日青色　丙丁日紅色　戊巳日黄色庚辛日白色　壬癸日黒色",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0033",
      "sha256": "3990b4321f01bcdfd4bfac165916429573ce6cbc7faf815da31b60129d26627e"
    },
    {
      "section": "牛脛色視立春日支",
      "text": "亥子日黒色　寅卯日青色　己午日紅色申酉日白色　辰戌丑未日黄色",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0034",
      "sha256": "f04a72d8a2e1f92c65ae103ac269fbb7be58d5a7d64d7d9392dccb9fe2c17543"
    },
    {
      "section": "牛蹄色視立春日納音",
      "text": "金日白色　　木日青色　　水日黒色\n火日紅色　　土日黄色\n牛尾長一尺二寸象十二月左右繳視年隂陽\n陽年左繳　　隂年右繳\n牛口開合視年隂陽\n陽年口開　　隂年口合\n牛籠頭拘繩視立春日支干\n寅申己亥日用蔴繩　子午卯酉日用苧繩辰戌丑未日用絲繩　拘子俱用桑柘木\n甲乙日白色　丙丁日黒色　戊巳日青色庚辛日紅色　壬癸日黄色",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0035",
      "sha256": "cc0367597ed28200b6cf6f2474959276582eb88b40387b8fbfa92f176f52c7d2"
    },
    {
      "section": "牛踏板視年隂陽",
      "text": "陽年用縣門左扇　　隂年用縣門右扇\n芒神身高三尺六寸五分象三百六十五日",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0036",
      "sha256": "4621df996e54342ef3beb19814d197e2b070ff609fd272b8f0230397e7c57017"
    },
    {
      "section": "芒神老少視年支",
      "text": "寅申己亥年面如老人像",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0037",
      "sha256": "21c2d04f107d29c1f8c00b28f69b790e71fbe150f6c702c074485dd4b98657f5"
    },
    {
      "section": "子午卯酉年面如少壯像",
      "text": "辰戌丑未年面如童子像",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0038",
      "sha256": "c6bac11dd02be1d6fdfbf03617801e9351a96b3d022f781d9d95932770bf7da0"
    },
    {
      "section": "芒神衣帶色視立春日支",
      "text": "〔注文〕剋支者為衣色支生者為帶色〔/注文〕\n亥子日黄衣青腰帶　寅卯日白衣紅腰帶己午日黑衣黄腰帶　申酉日紅衣黒腰帶辰戌丑未日青衣白腰帶",
      "layer": "base_text_with_commentary",
      "passage_id": "xieji:c012:p0039",
      "sha256": "cee6743c49a38e500c8535e92f5194854a7fb3487500f36bad5c5b88355666ac"
    },
    {
      "section": "芒神髻視立春日納音",
      "text": "金日平梳兩髻在耳前",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0040",
      "sha256": "c7a778aa5255886214506e318f7802cc8405f6cdecdb9c178786687b536fbad4"
    },
    {
      "section": "木日平梳兩髻在耳後",
      "text": "水日平梳兩髻右髻在耳後左髻在耳前\n火日平梳兩髻右髻在耳前左髻在耳後",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0041",
      "sha256": "da75fe85147fa22cd241774e3a2b5d7ea9a102e5a70e89e3dfabcaf6f11af9f0"
    },
    {
      "section": "土日平梳兩髻在頂直上",
      "text": "芒神罨耳視立春時",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0042",
      "sha256": "bf5d8f63cf9cd0fefc1d6c0aabfc9f65d62a95aaf612e82b9c8db703d8a05057"
    },
    {
      "section": "子丑時全戴",
      "text": "寅時全戴揭起左邊",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0043",
      "sha256": "bf236f98326e674f10e15abd3af188d0d8fb712cd934a0953b46f20f4131d5f0"
    },
    {
      "section": "亥時全戴揭起右邊",
      "text": "卯巳未酉時用右手提",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0044",
      "sha256": "b386c6a85f3d14f2306cbe62dd39853ea9d90a3c873e53583eda6193d671f734"
    },
    {
      "section": "辰午申戌時用左手提",
      "text": "芒神行纒鞋袴視立春日納音\n金日行纒鞋袴俱全左行纒懸於腰\n木日行纒鞋袴俱全右行纒懸於腰",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0045",
      "sha256": "ea9959e3725ca3c7f56b5ae8b44e8bb44ef8c68003abd34f6651f657e786fe91"
    },
    {
      "section": "水日行纒鞋袴俱全",
      "text": "火日行纒鞋袴俱無",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0046",
      "sha256": "93af5a4c24a10eb183b18fbf59a55fcb1803909a84bada96fe0d243f9e5a80e9"
    },
    {
      "section": "土日著袴無行纒鞋子",
      "text": "芒神鞭杖用柳枝長二尺四寸象二十四氣鞭結視立春日支\n寅申巳亥日用蔴結　子午卯酉日用苧結辰戌丑未日用絲結　俱用五色醮染\n芒神忙閒立牛前後視立春距正旦前後遠近\n立春距正旦前後五日内芒神忙與牛並立立春距正旦前五日外芒神早忙立於牛前邊立春距正旦後五日外芒神晚閒立於牛後邊",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0047",
      "sha256": "d9b11ee4cb6679e03d99f43846b4c71ba211375d7362abe7040dce6858f8cea0"
    },
    {
      "section": "芒神立牛左右視年隂陽",
      "text": "陽年立於牛左　　隂年立於牛右",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0048",
      "sha256": "adfb6ff050f2fbb8a80b95faa85ec31cd4b2d46b237c4e434412145ea7b1df9c"
    },
    {
      "section": "歲時紀事",
      "text": "迎春\n先設春牛勾芒神於東郊牛頭東向立春先一日府州縣官吏綵仗鼔樂迎春於東郊祭拜勾芒神迎春牛勾芒神安置各衙門頭門内至立春本日用綵仗鞭春牛蓋即出土牛送寒氣之遺意也",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0049",
      "sha256": "a85131bdf11e73924dac2a24d6f83d39a8c643f68634a3f3c261fcf65e9b0820"
    },
    {
      "section": "龍治水",
      "text": "視元旦後第幾日得辰即為幾龍治水也",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0050",
      "sha256": "8cdfef00004d0a80cf8a91580b0f6efadcfffafd76121ed5ffc4845e70e5c427"
    },
    {
      "section": "得辛",
      "text": "視正月上旬第幾日值辛即為幾日得辛也",
      "layer": "historical_work_transcription",
      "passage_id": "xieji:c012:p0051",
      "sha256": "08a1d2eeed9f9105026399ba7c86152b40c69e14ea2a7559a7dfde85ceb4dc5d"
    },
    {
      "section": "二社",
      "text": "歴例曰二分前後近戊為社",
