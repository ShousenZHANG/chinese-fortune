{
  "book_id": "yuanhai",
  "chapter_id": "c196",
  "title": "掣要捷驰玄妙诀(此集诸家口诀)",
  "source_url": "https://luckclub.cn/bazi/001/196/",
  "revision": "sha256:767887888d10af99f83689b96f64c34da2ba21da5b4dad0ab8cdfe4d66fde8ae",
