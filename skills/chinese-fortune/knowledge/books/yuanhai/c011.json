    {
      "section": "论十二支相刑",
      "text": "寅刑巳，巳刑申，申刑寅，为恃势之刑；",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c011:p0003",
      "sha256": "4af8c1720841f946da01e3f3f8dff490d824f66a51ca89927c4f41c030e7b7d0"
    },
    {
      "section": "论十二支相刑",
      "text": "丑刑戌，戌刑未，未刑丑，为无恩之刑；",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c011:p0004",
      "sha256": "f3092ca60ea25510396fb6c1c0dd4964a7f0d3a57d2dca24dcc2f5e57f87f32d"
    },
    {
      "section": "论十二支相刑",
      "text": "子刑卯，卯刑子，为无礼之刑；",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c011:p0005",
      "sha256": "fdbb570b18a416a3d3c10b8a438da4b83eae36cb3840c14dc625e7b418834498"
    },
    {
      "section": "论十二支相刑",
      "text": "辰午酉亥，自刑之刑。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c011:p0006",
