  "issues": [],
  "passages": [
    {
      "section": "飞天禄马诗诀",
      "text": "渊海子平卷五",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0001",
      "sha256": "d284d3c59105f6347a605b7d9c7a48dc5eebdc667d0b53daee688840ad6bd8a9"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "飞天禄马诗诀",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0002",
      "sha256": "79ee424eccf011b28447f1932f35157ce3bab85225b64dae89ca848e34a977c6"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "壬庚日主重重子，倒冲禄马号飞天，如何金水多清贵，运入南方虑有迁。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0003",
      "sha256": "6e53d501a6e854ae66c9e7c51700178db0f4344a50264b5f89634f236e17f55e"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "庚壬鼠队来冲马，辛癸寻蛇要衆猪，丙日马群冲鼠禄，丁逢蛇衆见双鱼。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0004",
      "sha256": "3bcbadb11353f11e9f802943eda4a94cf2da856bf531294a4018a3dacfad78ac"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "最忌绊神兼论合，官星填实祸当途，运重岁轻消息取，用神不损上天衢。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0005",
      "sha256": "b9b0a3961b319b152a1781b1d1e5f2dbb9be8746e30c887e7454dbc3b1c96c8c"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "辛日重逢乾又乾，格中推此号飞天，格成酉戌壮身贵，巳运刑冲寿莫前。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0006",
      "sha256": "d009f8728c00bea3d90ad3534e60fbc295e40249aca576b1f96982a6e7bc53a3"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "禄马飞天识者稀，庚壬二日报君知，年时月日重逢子，无破无冲富贵奇。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0007",
      "sha256": "e1253672b127b6a17ab2e4220238dd5b396f01e41dbae0589789954b15e4dc56"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "飞天禄马贵非常，辛癸都来二字强，年月时日重见亥，无官冲绊是贤良。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0008",
      "sha256": "8476725e59117a8bd93eaf399fcce8f3d972419661a4312a20b12e3e4e42a540"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "亥逢辛癸子庚壬，禄马飞天仔细寻，岁运若逢官绝处，功名唾手遂初心。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0009",
      "sha256": "cf865f187990bb8479c19951594f4dae30ec54c97bb22c100c25ebad2f5473e9"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "日刃庚壬子字多，飞天禄马格纯和，冲官合起真为贵，填实其中又折磨。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0010",
      "sha256": "26c01441ff8d48b81910d7a85a5d2a25fd8242f52f2d79e785c0cd84186213df"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "七杀官星休要犯，丑字相逢绊若何，天地人元重见土，克其子丑不兴波。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0011",
      "sha256": "89610906175714c6bdd69574def3e32b454b9b93b1d7a12d95732ca092657ddd"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "丁日多逢巳字重，局中无水贵和同，伤官此格宜伤尽，见亥相冲数必空。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0012",
      "sha256": "fa0eb9eb199ae2c070c11d1f39b1c57bc9dfca653d257021cb2e7231c109ae2a"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "丙丁日午要多临，冲出官星贵气深，四柱若无官杀重，复行官运祸难禁。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0013",
      "sha256": "a7d34caa97fba8cd2942e346dc32e0123e519f0bab8823d71d151e1fcc479881"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "丙丁高位激江湖，岁运无官入仕途，专禄荣名皆逐意，片言投合动皇都。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0014",
      "sha256": "03c263246ac4bd704b8e38493c93b6f81ecfa3c2797cea65a1b663c563ed71c7"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "丙日须宜子午冲，午能冲子吉相逢，不须论会惟嫌未，子癸相逢再见凶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0015",
      "sha256": "331239723a045a39dbbc6dfa29ad3c92d8c3ea8a12e72372a99e71ae07f9c924"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "丁日坐巳多冲亥，壬癸休来四柱中，倘若地支申字出，必能相绊贵难同。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0016",
      "sha256": "a1c251d8c72ed894a63e245720e43400dd7373f31bb5ce6f0b07e8dbe6b89d21"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "丁巳支中曾见蛇，刑冲壬子格为佳，若有亥午兼乙卯，合官锦上又添花。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0017",
      "sha256": "b7ad81aa56de81b8f5be3cd9a663414f169aa53daa26ad2ea8aa5cdb1eece53b"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "癸日亥字为仇家，近寅绊合有争差，春秋半吉冬无用，生於夏月享荣华。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0018",
      "sha256": "31e89861a62bd92c49761357958f36848c383137951d06c592b075036a8a015a"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "眉批：以庚壬二日，用子字多冲午中丁己为官星。要四柱中有寅字，并未字或戌字，得一字可合为妙。以辛癸日用亥字冲巳中丙戊为官星，要四柱有申字，并酉字或丑字，得一字可合为妙。如",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 84,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c234:p0019",
      "sha256": "2a48ba656750f922841edf073b3849a8859f1e292100433e52c151732b52a619"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "辛酉 癸巳 丁巳 乙巳，以巳冲亥中壬水为丁之官星是也。日刃如以",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0020",
      "sha256": "d5a7afad444580e8fb500724727922df170c1c4e6b26131dcf1fbb96e3de0a0b"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "壬午 壬子 壬子 壬寅，以子冲午宫己土为官星。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0021",
      "sha256": "c9e93ff3ab06515cf29c45bdb57f6af30628edbe909c37adbbfb519d8d79352e"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "辛巳 甲午 壬午 丁巳，以巳冲亥中壬水为丁官。如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0022",
      "sha256": "d855c024c3bc334ce64e4aff1d8279c1f1de47711e1bd074270873de2d7c70e7"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "庚寅 壬午 丙戌 戊戌，以午冲子宫癸水为丙官。如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0023",
      "sha256": "2438cee12236af4ca29c7660b72065c9c2331c23c64707dd8b27813c83079b52"
    },
    {
      "section": "飞天禄马诗诀",
      "text": "丙子 庚寅 丙子 癸巳，须用午冲子为丙官，时犯癸巳，减分数。巳与申相合官，相绊不能冲害之故。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c234:p0024",
      "sha256": "17f73cb817c5bc65fbb90fbcfa074ea76d40f2d811237dcd8c9d6646ab5f19ef"
    }
  ]
}
