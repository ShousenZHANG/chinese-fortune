    },
    {
      "section": "论月德贵人",
      "text": "寅午戌丙为和，正、五、九月；",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c028:p0009",
      "sha256": "68bc76c14c6a8fb93e7b94a8c46608390a5a6c72956f587aaeaa961211d0d074"
    },
    {
      "section": "论月德贵人",
      "text": "申子辰壬为和，三、七、十一月；",
