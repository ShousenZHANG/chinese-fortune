    {
      "section": "六月建未候诗诀",
      "text": "丙丁日坐未宫逢，金水虽凶未必凶，木库火乡应富贵，再行申酉祸灾重。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c208:p0003",
      "sha256": "3fe6610f0b35db6f8c5bf3d1ae0f9dac2fe3d7702013a004aa86b228f622dc44"
    },
    {
      "section": "六月建未候诗诀",
      "text": "眉批：六月未宫，己土十八日，丁火七日，乙木五日。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 24,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c208:p0004",
      "sha256": "d5807706ab8d751b668c067f7c3f996129961b1ae33c1ec3873187e54aa55127"
    },
    {
      "section": "六月建未候诗诀",
      "text": "未月支藏木火时，不逢顺逆格高低，南方行去东方旺，酉位休愁戌亥亏。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c208:p0005",
