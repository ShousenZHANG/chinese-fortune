  "passages": [
    {
      "section": "论性情",
      "text": "论性情",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c158:p0001",
      "sha256": "cd0f8873083a8302b45afdde44342fa8f8766bc9839e82d77c95a0c55e557b4f"
    },
    {
      "section": "论性情",
      "text": "性情者，乃喜怒哀乐爱恶欲之所发，仁义礼智信之所布。父精母血而成形，皆金木水火土之关系也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c158:p0002",
      "sha256": "c7c1e8706d11bfe7876d65c60d31ec8f3faa3e08014f8a0844f439f2c49bfa44"
    },
    {
      "section": "论性情",
      "text": "且如木曰曲直，味酸主仁，恻隐之心，慈祥恺悌，济物利民，恤孤念寡，恬静清高。人物清秀体长，面色青白，故云木盛多仁。太过则折，执拗性偏。不及少仁，心生妒意。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c158:p0003",
      "sha256": "2f4c08910229e48f45cfa9e6452a6c2fcfcc48af0d4999e38c0d7628b385ceba"
    },
    {
      "section": "论性情",
      "text": "火曰炎上，味苦主礼，辞让之心，恭敬威仪，质重淳朴人物。面上尖下圆，印堂窄，鼻露房，精神闪烁，言语辞急，意速心焦，面色或青赤，坐则摇膝。太过则鞠恭聪明，性躁须赤。不及则黄瘦，奸巧妒毒，有始无终。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c158:p0004",
      "sha256": "f622c756fbb67dacc93dfe855832ab0a0eca35baf7075f9d67a0488b321e3d9b"
    },
    {
      "section": "论性情",
      "text": "金曰从革，味辛辣也，主义。羞恶之心，仗义疏财，则勇敢豪杰，知廉耻，主人中庸，骨肉相应，方面白色，眉高眼深，高鼻耳仰，声音清响，刚毅有决。太过则自无仁心，好斗贪欲。不及则多三思，少果决，悭吝，作事挫志。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c158:p0005",
      "sha256": "2cc6e887a065d4656349c01315b668a6c1475339b70dddbf63208e90fafb3d4f"
    },
    {
      "section": "论性情",
      "text": "水曰润下，味咸主智，是非之心，智足多谋，机关深远，文学聪明，诡诈飘荡，无力倾覆，阴谋好恶。不及则胆小无谋，反主人物瘦小。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c158:p0006",
      "sha256": "e9940d4a0b383ef1d9cfd01f4467c13bc46a97f3fc441b159402b4c5a6f39e7a"
    },
    {
      "section": "论性情",
      "text": "土曰稼稿勾陈，味甘主信，诚实之心，敦厚至诚，言行相顾，好敬神佛。主人背圆腰阔，鼻大口方，眉目清秀，面如墙壁，面色黄，处事不轻，度量宽厚。太过则愚朴固执如痴。不及则顔色似忧，鼻低面偏，声重浊，朴实执拗；太过则孤介硬吝，不得衆情，沈毒恨戾，失信颠倒。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c158:p0007",
      "sha256": "03063c0f320179d0ea89265398e05b2cb0610bfcc250e3373685afd00ef37bd5"
    },
    {
      "section": "论性情",
      "text": "且如日干弱则退缩怕羞，日干强则妄诞、执一自傲。以上自以轻重言之，万无一失。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c158:p0008",
      "sha256": "62ade3f222a0c2dac00a4c42b5298756b645324d36d43b055dd0111c0c55d554"
    },
    {
      "section": "论性情",
      "text": "眉批：大凡观人之性情，皆以五行金木水火土。取象如取本性，则要四柱不要相犯，若多则杂，人物不清高。受克多则疾病。若只以日主所属为主，以分形体，则其主有是也，若得当令，果然有验。若是秋木凋零，主其人有不足。其余火土金水，仿此断之。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 113,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
