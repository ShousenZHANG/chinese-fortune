    {
      "section": "内十八格-杂气财官格",
      "text": "渊海子平卷二",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0001",
      "sha256": "7ff3cf914c80f6b91688ae2c54d143b1d64be1e4fc0c5f98b16611fb00d628f4"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "内十八格 - 杂气财官格",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0002",
      "sha256": "adb419c6901d709341fe010938206ded7e561ee43e800e8101a892ce959f0647"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "辰、戌、丑、未为四季财官，印绶居杂气，干头透出格为真，用财多为尊贵，杂气自来就不纯，不逢也出始为宗，身强财旺生官禄，运见冲刑装宝珍。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0003",
      "sha256": "d07af8e9fbba3faa0285736d5f2e917eee96619d88b0875a7fe1b21a50be2c59"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "经曰：财官印绶全备，藏蓄於四季之中，辰戌丑未是也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0004",
      "sha256": "1834b1c536dd0cf38852a0d381b5725cf24b535be03038e380d0af7a63383950"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "如官露、印露、财露则不妨也。如辰宫则有乙木、癸水、戊土；戌宫则有辛金、丁火、戊土；丑宫则有癸水、辛金、己土；未宫则有乙木、丁火、己土也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0005",
      "sha256": "11240f2db55f9e15d93c2b9af354d952528c00538f0d33e26eb7f8e10426d916"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "王羲之，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0006",
      "sha256": "d53c830f6c094530470f568bc2c571b1c815b36d899c40da98a5c467bcc4e2a1"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "乙卯 癸未 壬子 辛丑(丁财、己官、辛印)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0007",
      "sha256": "77e916657b4941f4706581b69e3e84f04ee0587fb87557c30dfe3a4e51d272c8"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "李柳帝，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0008",
      "sha256": "d1406d5f88251f915234d4bfcdc95de63d738c5e87ad90372ce370460e6c5d10"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "戊子 乙丑 乙未 辛亥(癸财)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0009",
      "sha256": "c2a4751804cdf38d62d2b4619c838881ebbb018064d692d7aaae811a26b1f1ad"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "黄状元，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0010",
      "sha256": "d9133d072f7cadb1df5928e78ca565966caf09fc1de31574616baef90f3c4404"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "壬子 甲辰 己卯 壬申(壬财)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0011",
      "sha256": "ef787e069b57e76d15243ac438f2bc8a6a1d2b0f7910a176fe3a5ea07a72bdd8"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "宣参政，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0012",
      "sha256": "41eeaef9e8e91abe41aa9f326be7a32948fef37b706f52454632886e5032bd41"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "己卯 辛未 壬寅 辛亥(己官)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0013",
      "sha256": "9a16be5ddc982ecaf26b9c31a4cc2a02c48fcaf8075afa065b20565180fb72a5"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "张参政，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0014",
      "sha256": "f7fd5e53da418b4786e7f9678e487cd98800b1d7461297a8becd6db005714846"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "丙寅 戊戌 辛酉 戊子(庚官、甲财)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c099:p0015",
      "sha256": "50126ab60b1242507feae41aa7ed8788e27f8dd6027e28e819fdc5c6efe2a88f"
    },
    {
      "section": "内十八格-杂气财官格",
      "text": "眉批：辰戌丑未为四季，印绶财官居杂气，干头透出格为真，只问财多为尊贵。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 35,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
