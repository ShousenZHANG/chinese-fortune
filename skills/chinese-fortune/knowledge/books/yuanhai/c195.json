{
  "book_id": "yuanhai",
  "chapter_id": "c195",
  "title": "万金赋(明津先生骨髓歌)",
  "source_url": "https://luckclub.cn/bazi/001/195/",
  "revision": "sha256:febb30fea3cb9a1c3c0adb2163804a9e05bf28d284a9f6015249ac5385475c53",
  "source_timestamp": "2026-09-06T04:11:03.133393+00:00",
  "layer": "historical_work_transcription",
  "facsimile_status": "not_checked",
