    },
    {
      "section": "地支藏遁歌",
      "text": "子宫癸水在其中，丑癸辛金己土同，寅宫甲木兼丙戊，卯宫乙木独相逢，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c061:p0002",
      "sha256": "94264923fbf31d1e8784b3e25cad7244d9d4337658deb04b98ee06740b4af2a2"
    },
    {
      "section": "地支藏遁歌",
      "text": "辰藏乙戊三分癸，巳中庚金丙戊丛，午宫丁火拼己土，未宫乙己丁其宗，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c061:p0003",
      "sha256": "9cf30057b51f33af252bf82de0bb5fce1fa7d6330f696adc3f6dfa54907058ee"
    },
    {
      "section": "地支藏遁歌",
      "text": "申位庚金壬水戊，酉宫辛字独丰隆，戌宫辛金及丁戊，亥中壬甲是真踪。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c061:p0004",
      "sha256": "9e646065d4aeb8d0b6fcd68289b4ce3c057298ac5b72f36e6c33d3f94d7c87d1"
    }
  ]
