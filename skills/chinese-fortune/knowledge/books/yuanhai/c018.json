    {
      "section": "论年上起月例",
      "text": "甲己之年丙作首，乙庚之岁戊为头，丙辛之岁寻庚上，丁壬壬位顺行流，若言戊癸何方发，甲寅之上好追求。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c018:p0003",
      "sha256": "8e807dff9e872501eca3c4cab409fbdbac536c9ab8a928d41c92dd6cc033f54a"
    },
    {
      "section": "论年上起月例",
      "text": "其法假如甲己生，於月上起丙寅，以正月为丙寅、二月丁卯，一顺数去，至其所生之月止，一月一位顺行。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c018:p0004",
      "sha256": "e75131e378c197967050c538d89048fab3e03082e63c60065eff214051d59bb6"
    }
  ]
