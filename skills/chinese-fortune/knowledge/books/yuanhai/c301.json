  "raw_path": "sources/yuanhai/c301.html",
  "raw_sha256": "fecd759afc2f97a00c195b2f9371817d950fc33086145b35aa597b54097b9e12",
  "raw_kind": "cleaned_original_transcription_not_complete_http_response",
  "extraction_kind": "selected_original_html_node",
  "issues": [],
  "passages": [
    {
      "section": "女命大义-4",
      "text": "渊海子平卷七",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0001",
      "sha256": "6b80087542a73aa2a75d1af474ca2cda84e4b0f80256e05bc5a13ae1bac1e7f3"
    },
    {
      "section": "女命大义-4",
      "text": "女命大义-4",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0002",
      "sha256": "47aa6d2ffd103cd90dc9950c6667a5567b710f30f56004567f0afb703685f758"
    },
    {
      "section": "女命大义-4",
      "text": "五行恬淡福星临，重厚温恭必至诚，天使喽罗无半点，却交顽福重千斤。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0003",
      "sha256": "aee15e355203ab6f2d86770b2f85a812767d3cf132c397dc3fcd633caf32bdb4"
    },
    {
      "section": "女命大义-4",
      "text": "满盘印绶得夫星，运向夫行子息生，造化夫星无劫夺，兴夫旺子两宜情。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0004",
      "sha256": "522d321c19377487cce7246600c269f9a780761aa82eb7c865c4ba845d6fcb33"
    },
    {
      "section": "女命大义-4",
      "text": "印绶多主无子，运行财官子息反多。阴乾枭印重亦莫言无子，行泄克之运，亦主子多而秀。如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0005",
      "sha256": "3036fe12d56baafc9ec0cdfb4e8b4c0e1b5125e2f9e01bac8352636e016ba60c"
    },
    {
      "section": "女命大义-4",
      "text": "癸未 癸亥 乙酉 癸未，此命行南方火土运，财食之地，以财制枭，食神无损，生七子显达，夫妻偕老。一命壬午时，亦生五子，刑夫失节。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0006",
      "sha256": "77e5998c0c7b34fe1599ed2275028520cc782fab9a12e3bff21f6df8d6a3f735"
    },
    {
      "section": "女命大义-4",
      "text": "杂气格中禄最佳，干头便混也堪夸，运行财地无伤劫，嫁得才郎享福遐。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0007",
      "sha256": "edc339c07047918d16761086a91df2a6f7a3bccd220575fe3f649c516a8d3810"
    },
    {
      "section": "女命大义-4",
      "text": "甲乙丑月之例，俱藏夫星，干头不忌混杂，此以月言也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0008",
      "sha256": "232e957f3824cfc3627b15d44ead29e67ca365fcf34a03a148c13b2feb77f1a0"
    },
    {
      "section": "女命大义-4",
      "text": "壬辰壬戌坐中夫，庚戌庚寅亦自殊，壬午甲申戊寅日，妇人得此福偏俱。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0009",
      "sha256": "c5bc3cb03d6f57204eda4dbbc890b1c3a2af1d27a6a4258b912d118311cffdb8"
    },
    {
      "section": "女命大义-4",
      "text": "此数日，坐下夫星只宜一位为福，此以日言也。一命",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0010",
      "sha256": "3fa017b750f00654807b778e3c3efed74804d7411e240bb774484ddbae79fc47"
    },
    {
      "section": "女命大义-4",
      "text": "庚申 己丑 庚寅 庚辰，大富，八子，寿五十余。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0011",
      "sha256": "50a5f7b375f1b1399b43df7213e3a60a7d91be1ece4ca57567080731a1ea7441"
    },
    {
      "section": "女命大义-4",
      "text": "丙庚子午各分推，已上偏於卯未宜，乙日更堪巳酉丑，癸临己未亦当时。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0012",
      "sha256": "c8525de34a2228b758c5169f0c5abed0d3979e3da851f41f4504de94a5bdc94e"
    },
    {
      "section": "女命大义-4",
      "text": "此数日亦坐下夫星不宜破支，独见乃吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0013",
      "sha256": "b5f5c92bef54e9eec10193b420f6d51cf8794d9468b1a9aeb95d3aa42f83d9d0"
    },
    {
      "section": "女命大义-4",
      "text": "煞星独印格中清，身主清高富贵成，不有官星来混格，号封恭淑重呼名。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0014",
      "sha256": "4ba3aed051410fb576652e9d3e09e89a8c1042fe7f21f3dd44d4881535f575ef"
    },
    {
      "section": "女命大义-4",
      "text": "女命煞印最吉，如上。己卯、己未、癸丑、乙丑、乙酉、癸未、辛未、甲申、庚寅、戊寅、壬戌、壬辰、丙寅等日，不宜再混夫星为贵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0015",
      "sha256": "72c3e1a015da58ec0c836b615e9f2898ed63e99f64a8cf3674dfa79a5a9efcba"
    },
    {
      "section": "女命大义-4",
      "text": "五阴妇女要身衰，若遇刚强灾病来，岁运再行身旺地，花前风雨恨相摧。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0016",
      "sha256": "260a3ad8811870863d034c1934c350610081e465ce23059f0e35acfe9d6c9789"
    },
    {
      "section": "女命大义-4",
      "text": "五阴日宜弱，强多生灾，行建禄会旺地，柱无官煞，伤夫害子。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0017",
      "sha256": "a7f682bb1444b7d0ddab1fe48ba128c73e873b09c9217f0ec1652390e11608b4"
    },
    {
      "section": "女命大义-4",
      "text": "孤鸾日犯本无儿，一见官显得子奇，运遇旺多多姊妹，临风惆怅绿楼时。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0018",
      "sha256": "e3e2ee6d5289e84da58df4a890bd5630cf9cf8529a1cc3d1f1aa2df1f984a465"
    },
    {
      "section": "女命大义-4",
      "text": "孤鸾日柱中若见官星，反得其子，阴日更好，不可混以无儿断之。运行身旺及比肩争夺，真孤鸾。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0019",
      "sha256": "fe61b9d02988a16199b3d781a11309e33cbaf28aeeaaed3415a128ff7225badd"
    },
    {
      "section": "女命大义-4",
      "text": "夫星得地子多余，姊妹交加反是虚，财旺更逢儿位吉，伤官相见又如初。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0020",
      "sha256": "00b612af5265152e0124ff7d1335cb8859f793fa0214be0636429e8a7a5365c0"
    },
    {
      "section": "女命大义-4",
      "text": "妇人以夫为主，夫星得时必多子息。若见比肩分夺，反孤无子，故又喜财生之。再见伤官，又作初论。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0021",
      "sha256": "a4f5625bc4437a68612978c3064786d1c65b0a188384f7fa53e3115e5a765784"
    },
    {
      "section": "女命大义-4",
      "text": "一位夫星姊妹多，伤官岁运便难过，纵遇有夫也伤克，寒衾独枕奈如何。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0022",
      "sha256": "f5938777b104300233239948f29cc5eed06acc6b484fc9233c7045b4a1b00bae"
    },
    {
      "section": "女命大义-4",
      "text": "官星只一位，是怕比肩分夺，况岁运又逢伤官，其害夫也必矣。若原是伤官格，柱中不见官，无害，怕行运见官，战斗雠(音同愁)仇，克夫无疑。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0023",
      "sha256": "ec92558e28e1306fee4912bf55ef1ea91645ec617391cd6b9a413edc9ac62800"
    },
    {
      "section": "女命大义-4",
      "text": "格用伤官亦两猜，若逢食旺益夫财，财星旺处生官旺，无食无财印喜来。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0024",
      "sha256": "cade63afac713211dddaded4fa893f9d5bb87cb8fa2f6bfba957a01a87208f7f"
    },
    {
      "section": "女命大义-4",
      "text": "伤官得时者无害，但怕旺印破用，食神为用，得时尤奇，却宜见印，但不宜印多，惟中则吉。一命",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0025",
      "sha256": "3d8e9979a821724cc99bb03fcd5705880db4b5564f5d0f489904aa82dae272fd"
    },
    {
      "section": "女命大义-4",
      "text": "癸未 乙卯 庚子 庚辰，伤官用财，嫁贵夫受封，一子。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0026",
      "sha256": "e897bfc135d4b77bf4a7a32e15816db36212bd4c8ecc253cffcd13af6735f012"
    },
    {
      "section": "女命大义-4",
      "text": "妇人格局要清和，夫气休囚困苦多，运逢财官重旺相，着罗衣锦笑呵呵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0027",
      "sha256": "b39e559eb56979c2d126af0aa846f4bb93299c7f98d14d40d1d155ab83a507cf"
    },
    {
      "section": "女命大义-4",
      "text": "假如辛日生於酉月，干头虚见丙火，虽官无用，主巧而贫。再辛壬互见，克夫。若得行煞官及财运，生起火木，则吉。余照此。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0028",
      "sha256": "d1ca0596e08f7acee2493f5a6010a8a6696eb22a81edbe4ae1337a65b1eb2447"
    },
    {
      "section": "女命大义-4",
      "text": "伤官性重有权舆，比劫重逢礼不疏，印绶日寻清慎独，丁壬化合晓诗书。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0029",
      "sha256": "853960c4611a3e9c1d0623542876589bc3f141beeb3ec1b950392591daf90746"
    },
    {
      "section": "女命大义-4",
      "text": "此言伤官性情乖觉，女中丈夫也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0030",
      "sha256": "d66d54f93ea37ab84ce9d136470fdfecb8d1655f7d393ab995545c41aae5e93d"
    },
    {
      "section": "女命大义-4",
      "text": "金水相涵秀丽佳，比肩也作金水夸，丙逢壬制顔如玉，甲逢金克貌如花。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0031",
      "sha256": "c22242611f308c66ecbe99dd8f6af1a5ab584e61bb7145fb7353933f0a2202db"
    },
    {
      "section": "女命大义-4",
      "text": "金水涵秀，故多美貌，若壬克丙，甲见金一煞清独，其貌亦美，性情亦静。混杂者，淫贱，貌亦丑。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0032",
      "sha256": "08e64ec6b766d00ca44e4b08d179b7dac62a3465453198f6bfa1f0bc059be9c7"
    },
    {
      "section": "女命大义-4",
      "text": "印绶生身遇煞良，伤官财旺坐高堂，如行死绝阳肩墓，独守空闺哭子丧。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0033",
      "sha256": "f39cb6d99091f36ebd4579f6d884f2a29688603a5907800341518b4b4d434271"
    },
    {
      "section": "女命大义-4",
      "text": "煞印相生，伤官生财，皆为上格。若行财煞死绝、阳刃比肩及伤官入墓之地，伤夫克子。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0034",
      "sha256": "b3e12d7b597c385c2ece8fa0c41fa1ed70ede2a6ed00e369c3f5a2a57c194a3a"
    },
    {
      "section": "女命大义-4",
      "text": "阴阳自旺日平常，身健无依本是良，运向夫乡争竞起，改容再醮补填房。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0035",
      "sha256": "7b96af0c527751acef2599b422022d03601f5fc19c2050aadb82ba62cf971bdd"
    },
    {
      "section": "女命大义-4",
      "text": "桃花红艳两交差，频向妆台理鬓斜，若有官星藏与透，却归良室福无涯。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0036",
      "sha256": "9dfd18ce9cc06fa1120e5cdb8c69b76ace81574837f6189b69ee29bad2a2973d"
    },
    {
      "section": "女命大义-4",
      "text": "二煞不吉，妇人最忌。如见官星则有倚赖，反主有福。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0037",
      "sha256": "509a46a5d9cd2a4934e16e9c641d8ffe33f75afaf1f483d9b17516fec733e782"
    },
    {
      "section": "女命大义-4",
      "text": "桃花与煞怕同途，官见桃花却旺夫，金水相逢虽貌美，无官贵室亦多污。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0038",
      "sha256": "39c112ab37fb1c7d61a660787c51937f1fe3d5adc33249d02f8f086d9c628898"
    },
    {
      "section": "女命大义-4",
      "text": "官星桃花不害於良人，煞星桃花则多为娼妇。桃花之煞虽一，而逢官遇煞迥异，金水伤官无官煞，其志不定。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0039",
      "sha256": "8a8d351ee285585f0ab2f4ce73a23fb6b928b0b82a18c1a29984443b90f18090"
    },
    {
      "section": "女命大义-4",
      "text": "食神独旺胜诸祥，金水伤官得火康，受气不宜逢姊妹，煞星一位便为良。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0040",
      "sha256": "ca1416e100554aae8c9eaeb0e8f8a333588b57eb073cf8e0c4571dd14b55756f"
    },
    {
      "section": "女命大义-4",
      "text": "一食遇生旺，金水见火，胞胎无比肩，煞星一位得时，此数格妇命遇之皆吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0041",
      "sha256": "b98b7b8afd4bd1895581104fae482b11e301aec9e8c5ca604ce682f268dbe100"
    },
    {
      "section": "女命大义-4",
      "text": "官星得禄知夫贵，食遇临官子便贤，福位青龙格煞食，驱奴使婢夺夫权。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0042",
      "sha256": "396cce52f1429cb18ea2e3dcc1d4707699fcbe085b2a33049d50a352577694bc"
    },
    {
      "section": "女命大义-4",
      "text": "如己遇甲夫得寅月，甲食丙嗣得巳月，主夫子俱好。若煞格食格用遇禄神，带青龙福位者，主夺夫权，聪明标致。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0043",
      "sha256": "baad165c69b28613f0d56497679a97b9f282b4934fb652cae2b5873b234a84f7"
    },
    {
      "section": "女命大义-4",
      "text": "食神暗合巳夫来，食旺无淆富贵胎，透出财星分等第，枭煞合外起疑猜。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0044",
      "sha256": "05ad7b1fd04ac89c2952a881baf3191fe31798c77c803b915eeded5f8ceb23ff"
    },
    {
      "section": "女命大义-4",
      "text": "食神不宜财轻，又不宜太过，清者第一，见官次之，来煞相见不吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0045",
      "sha256": "104b6a04d69345dfcef348708f557fadcfb9eef38ed2fca108d3905245edf2c3"
    },
    {
      "section": "女命大义-4",
      "text": "乙庚夏月正金疲，运向西方夫得时，丙子不来金水好，东方遇乙贵分之。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0046",
      "sha256": "6e8fd6d620d66a747f0f8d3acc1dc17e248d34ef6eb922c458a3f6a3384d2ee2"
    },
    {
      "section": "女命大义-4",
      "text": "乙以庚为夫，夏月金失时，行西扶起为吉，见丙伤庚，见乙争合，故皆不喜。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0047",
      "sha256": "f31c1ab65f120cf4cfee683a21a203c8806d79b4c7de76375455766ad74918c0"
    },
    {
      "section": "女命大义-4",
      "text": "辛官金水月夫轻，再遇辛壬两度新，运行木火难胜福，不伤自己也伤人。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0048",
      "sha256": "663bdd1453fb8f2686f5c1d26dd7c6aa0f0fc1979d7058de2996811da4a22583"
    },
    {
      "section": "女命大义-4",
      "text": "辛干以丙为官，辛生秋冬，遇丙则轻，时又见辛壬分克，则丙愈轻，运行火木，夫虽得时，恐不胜其福，未免伤人害己。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0049",
      "sha256": "1da86803e442f0816e96d4451b601ded9f00e711b952a9380eed6aef3273956e"
    },
    {
      "section": "女命大义-4",
      "text": "己夫秋甲暗伤支，乙见干头两度期，除是东方逢木旺，击伤金木又交待。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0050",
      "sha256": "ab95161ad82f2b71e85a5bc97bb926cfe40df3b14a683b8e4bf24fd27b1ba027"
    },
    {
      "section": "女命大义-4",
      "text": "己秋月遇甲夫，支有伤官为害，再见乙未，去被从此，乃甲与己合，被乙战克，不能就官而从煞，主两度成婚。行东方木旺之地，有火驱金，虽好，亦不免伤夫再嫁，或多寡居。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0051",
      "sha256": "3e71ef90343f5f8213fd11d831536d1f315685826cc20541869770d69b3471d5"
    },
    {
      "section": "女命大义-4",
      "text": "辛未 甲午 己未 甲戌，王妃。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0052",
      "sha256": "46f652d37648c0c3ef20a76393870c21a24b35bec15c67ca45cdbce1aa8ee47b"
    },
    {
      "section": "女命大义-4",
      "text": "丙午 辛丑 己未 甲子，进士女，王妃。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0053",
      "sha256": "00b77e9f6e047ecdc72b51a7c04dab76a3f7e1d7432bbcd06e35ee4576dace36"
    },
    {
      "section": "女命大义-4",
      "text": "庚夫金水月建丁，壬丙干头两见争，富贵春风衾枕冷，伤官支上怕分情。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0054",
      "sha256": "fcd6fb07a9269d68a1549a569b2e9b41ac2a6fa68c90ae24fd97622c610b8937"
    },
    {
      "section": "女命大义-4",
      "text": "庚以丁为官，秋冬遇壬，金水得时，乃前夫被克，又从丙火，若丙戌时，其夫入墓，子时其夫被伤，虽居富贵，终是寡居，子亦少。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0055",
      "sha256": "b4f98d00418822bb33a217db0f73bba22820be73bf3d4d3673e9853a6b0296cc"
    },
    {
      "section": "女命大义-4",
      "text": "甲夫巳午及寅宫，遇丙合辛被火熔，身旺食神家富足，独眠孤枕怨春风。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0056",
      "sha256": "2f139d0c5d6a9cbc49ed4297d009043c084a047835c04de86e310d87c72d1f47"
    },
    {
      "section": "女命大义-4",
      "text": "甲日以辛为夫，辛生春夏失时，又遇丙火，难以吉论。盖妇人以夫为主，官既受害，虽财食赢余，不免伤夫。若柱无辛，见丙丁，运行见辛亦吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0057",
      "sha256": "b03af4fa337519b8d4522f7b49ed922de5319ff8b43be1b593094374e69b4381"
    },
    {
      "section": "女命大义-4",
      "text": "丙夫夏癸月藏伤，若遇庚辛酉地祥，木火透干能泄水，夫财虽旺发难长。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0058",
      "sha256": "735aa7524d261898577bae82f6e34128cba0d707416bff054bd2564aed923c3f"
    },
    {
      "section": "女命大义-4",
      "text": "丙干以癸为夫，夏月癸水休囚，内藏土为伤官，如不透戊己，得辛金佐之，运行西吉。柱有木火泄窃癸气，终是不久，不见癸用食神更吉。伤见则非。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0059",
      "sha256": "f341ce1c66a342e05a538ebaf9ad55808fa39a850bb7a49c528fcbe627512c1f"
    },
    {
      "section": "女命大义-4",
      "text": "癸水生於寅卯月，合戊经行南地宜，只恐干中明见甲，自怜衾枕与谁依。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0060",
      "sha256": "aecdf93a1900a6bcaf6d72f8a23575e1777b8486114ca347c1c23e874c4eb86d"
    },
    {
      "section": "女命大义-4",
      "text": "癸日生春，遇戊为夫，行南方及印地，不为利害。若甲透及癸分夺，便伤夫，不见戊，但见甲，行至戊运亦如之。若原无戊，用食神伤官行火地，皆吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0061",
      "sha256": "222ce89fc3592c0729cc15dd017b6946a2462d046181897bdeac3c95b5636d8a"
    },
    {
      "section": "女命大义-4",
      "text": "壬癸如生季月中，夏间土旺亦论同，不宜寅甲连相见，重犯作伤反无功。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0062",
      "sha256": "5aec0d7472e4681a2e13b3572c2919c116c511aaeba3b4316b0377a9b84258e3"
    },
    {
      "section": "女命大义-4",
      "text": "壬癸生辰戌丑未月及夏中伏，夫星得时，最吉。但不宜太过，若寅甲并见，食神重犯，作伤官论，单见甲或寅则言。一命",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0063",
      "sha256": "cccf4a853671e4a493fb335ec3e84694cfede8dbf223f7b4b2b5f287854e4d55"
    },
    {
      "section": "女命大义-4",
      "text": "庚辰 癸未 癸酉 戊午，嫁富贵俊雅之夫，生四子，受封。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0064",
      "sha256": "3c7a219c1007f3d41b7ba8a0e19bedf9637b6501330d78add9cb97e2146770eb"
    },
    {
      "section": "女命大义-4",
      "text": "甲乙秋生夫正时，煞官若混细分之，舒配去留成格吉，丁丙引强困又离。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0065",
      "sha256": "6712299f8919346e7aa5e0f5f87644fa6b5ab726b1273b49f2a99c093ff0b4f4"
    },
    {
      "section": "女命大义-4",
      "text": "甲乙用金为夫星，庚辛秋令得时，若官煞重见，分配去留，不相混杂，聪明富贵。见丁丙重，时引强地，则又伤金为害。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0066",
      "sha256": "887716533d8e852e8df17059a39f6e8a930e6bce2d2d95ecf4fb98a116bdf536"
    },
    {
      "section": "女命大义-4",
      "text": "戊己春生木正青，煞官多处便为情，支干遇合方成吉，会水重金又一评。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0067",
      "sha256": "467336e7f89e38687f1a3818f8a6c66338e1872ca00e26a9300d82d3af7defba"
    },
    {
      "section": "女命大义-4",
      "text": "戊己春生有二论，己日虽官煞混杂，有甲合为贵，戊日宜清乃贵，都利煞为用，皆怕金水多，水渗其土，金多害木，南运不忌。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0068",
      "sha256": "0738072c65a6e5bedfb1993de505a43f1eb7363aaf0e4b04a98c3da2c0a5289b"
    },
    {
      "section": "女命大义-4",
      "text": "庚辛夏月丙丁藏，不透干头便是良，只恐煞官交互见，非惟不吉也争强。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0069",
      "sha256": "4ed33b20c9afaa08d11d40e546fa79cba8e56b2b37787ad71b1d4497e1f5638d"
    },
    {
      "section": "女命大义-4",
      "text": "庚辛生己未月或寅卯戌月，俱有财官，不宜丙丁多透，煞官混杂相伤，二丙一辛争合，俱为不吉。盖金生春夏，已失之柔，再透则太过故也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0070",
      "sha256": "7218d77f2390e1081d0664cb614cbd69161734a1c6c075375c983a776bec0ec9"
    },
    {
      "section": "女命大义-4",
      "text": "丙丁冬月与秋同，独遇为奇乱则空，煞正官清居富贵，不堪混杂日临凶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0071",
      "sha256": "f44fe03d93e7a554f8b4e124e77c1960744b170642b33b0bea2e6ba8b88afbe5"
    },
    {
      "section": "女命大义-4",
      "text": "水冬旺秋相，丙丁生秋冬，夫星得地，官煞皆美。见官只论官，见煞只论煞，不宜混杂。清者富贵，乱者浊淫。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0072",
      "sha256": "ecaa7de77e356e02a7d675ef002e901ac4c703273838c3083c581d57fd2e5a70"
    },
    {
      "section": "女命大义-4",
      "text": "财旺生官格最稀，财官相遇十分奇，夫荣子贵因财旺，贞洁贤良五福宜。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0073",
      "sha256": "67c5e20bc221f8c90b165d705ea638b6f86bad4e9ba72d5a95eb118bc90a38e3"
    },
    {
      "section": "女命大义-4",
      "text": "一命",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0074",
      "sha256": "13895995c0869bdeb6eb35016ca1a814a63657b98bb84dc713ac8121bd58883e"
    },
    {
      "section": "女命大义-4",
      "text": "丁丑 癸丑 己未 甲子，嫁贵夫，三子受封而寿不永。一命",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0075",
      "sha256": "635c1d7f9b011f9da8baede97d0d22980c9d658f578a932275047a4697948d0d"
    },
    {
      "section": "女命大义-4",
      "text": "丁酉 癸丑 己巳 甲子，受封生子，与上同。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c301:p0076",
      "sha256": "aec5c9522a88b5f3e5fe6773027d3b06e7bf3a17e9d55ac7e4cc8ed87bbd3653"
    }
  ]
}
