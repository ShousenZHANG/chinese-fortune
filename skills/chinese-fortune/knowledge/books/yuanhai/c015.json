    },
    {
      "section": "论天干生旺死绝",
      "text": "眉批：",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 3,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c015:p0014",
      "sha256": "d3cd2fcbf2e6933caadea1989197a6cc660dcb68a869e05c27b78d9589db0039"
    },
    {
      "section": "论天干生旺死绝",
      "text": "长生者，言物在於发生而出，如人受父母精血延怀十月而生也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c015:p0015",
      "sha256": "df20b51e89168695c6728e7cdb82e931ff55e3645a1d6ee6f910b38452ce58da"
    },
    {
      "section": "论天干生旺死绝",
      "text": "沐浴者，乃生之初，在地正、在天弱之中，如人生出沐浴盆中，未可言吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c015:p0016",
      "sha256": "95e2447b7431fea4257e1c02b30994e0f50dbf915d6fab6cc10cfd65c7e89b43"
    },
    {
      "section": "论天干生旺死绝",
      "text": "冠带者，物之长成道，能运用，如人之顶冠束带，以召其用。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c015:p0017",
      "sha256": "1b57a6b5b235ec3953ad7a0f2544e8c309018c766724ca45a524f7790edf48aa"
    },
    {
      "section": "论天干生旺死绝",
      "text": "临官者，言物盛，如人之用谋为而有卓立也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c015:p0018",
      "sha256": "8b3c6a9748300bbd2a18d261060f12f5b88f889e88f86e6f45049d99b701bdfd"
    },
    {
      "section": "论天干生旺死绝",
      "text": "帝旺者，言物有操持可立，如人之受君禄，乘权衡任天位，精神康泰，得其所以。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c015:p0019",
      "sha256": "ac34108c10a6dc7bba5a12913a2f767497742fe9b7e01c0d542f3a6c46ed795d"
    },
    {
      "section": "论天干生旺死绝",
      "text": "衰者，言物之将老，如人之精血耗散而身体劳倦。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c015:p0020",
      "sha256": "c1671f8961bbe6f2424db25feece69497ddf8386c2c4a1e4ecea15b720ccf4bc"
    },
    {
      "section": "论天干生旺死绝",
      "text": "病者，言物之有皆好，如人之有病也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c015:p0021",
      "sha256": "5b2046f93d230b02b57a4c702b154083712e4d521facc1bb65b7e18316f475eb"
    },
    {
      "section": "论天干生旺死绝",
      "text": "胎者，言物伏於内而未明，如人之存母腹，以受气。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c015:p0022",
      "sha256": "d267cfb2262e414fcf2e7bc16030c5ebe5c0a1815a7a79f92d96f41d942a2f46"
    },
    {
      "section": "论天干生旺死绝",
      "text": "养者，言万物生长，如人之出於妇腹始为人也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c015:p0023",
      "sha256": "2226773038c81d4a58351fb50ba7709c2add53959b57f26e849417c08e0dbcc2"
    },
    {
      "section": "论天干生旺死绝",
      "text": "但指金木水火土言，以人寓其意。但逢长生、冠带、临官、帝旺为吉，但逢沐浴、衰、病为不吉也。至於死、绝，如无救助者直为凶矣。胞胎受气亦为半吉，养亦如之周而复始，其理可推。月令中干支所藏者，子平以日为主，月令之金木水火土为用神，却以用神旺衰取之。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c015:p0024",
      "sha256": "8a18f141ac158f7a113ba9422f83fb5d8a81c049c5888e3416039953a4a2e235"
    },
    {
      "section": "论天干生旺死绝",
      "text": "子月宫多取癸水，更有何日生，若初一日生至初十日生，当取壬水，十一日生至三十日生方取癸水，以断令神之用事，不可一例而取，则推合不准矣。举此一例，其余类推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c015:p0025",
      "sha256": "de57a6e363f2bfb3d7adcd2f287054fa3f4ae5df2426e610cf5cf2f05f21b8b2"
    }
  ]
}
