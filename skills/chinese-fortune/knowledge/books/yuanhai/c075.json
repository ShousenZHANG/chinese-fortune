  "passages": [
    {
      "section": "喜忌篇",
      "text": "喜忌篇 (喜者吉神也 ， 忌者恶神也)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0001",
      "sha256": "f2e9ad84fafb54bbeb0a164ad4bb920c92e2cea5134e0a30aa5ccbbfa0dffe79"
    },
    {
      "section": "喜忌篇",
      "text": "四柱排定，三才次分，专以日上天元，配合八字支干—凡看命先看四柱年月日时，次分天地人三元。干为天元，支作地元，以支中所藏金木水火土为人元。年为基本，月为提纲，日为命主，时为分野。故以日上天元配合，取其财官印绶，有无败伤争斗，论其八字也。(眉批：甲寅甲子为有气，春生为美。甲午甲申为无气，人无志，木神死绝在申地矣。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 117,
          "end": 156,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0002",
      "sha256": "03b4c06ad56bf2397585ffc2ec3693aa3d2799fe4cecca268647116ded647e19"
    },
    {
      "section": "喜忌篇",
      "text": "有见不见之形，无时不有—《碧玉歌》曰：甲官辛兮柱无有，支酉宜精究卯冲，酉合喜合巳酉丑，如无喜绝衰旺休。或三合六合贵地，虽禄马、妻财、子孙、父母、兄弟皆是有见不见之形，无时而不有也。此论生旺制克衰绝，只是支中所藏之造化也，无时不有。四季中有墓绝中余气也。五行休旺，配合生死也。刑冲克破，变化也。(眉批：正财独则易取，乱则难取。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 146,
          "end": 163,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0003",
      "sha256": "cee4e1c6d25bb28056a56ad4f1e58c546ff309081f38f424a23186ed088ab214"
    },
    {
      "section": "喜忌篇",
      "text": "神煞相伴，轻重较量—神者，贵人也。煞者，七杀也。若神杀混杂，看入节气深浅，或有去官留杀，或去杀留官，四柱或岁运亦当知轻重较量。甲以庚为杀，庚金乃休囚，身旺则轻。(眉批：甲以庚为杀，春木庚杀庚金休囚，身旺则杀轻。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 80,
          "end": 106,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0004",
      "sha256": "4475d3e31908cccd4940625b67c671adc299f572eda8158263a1b01746410dd6"
    },
    {
      "section": "喜忌篇",
      "text": "若乃时逢七杀，见之未必为凶。月制干强，其杀反为权印—此论时上一位贵格。只有一位，方可为贵，别位不要再见，始为清贵。若年月上再见之反为辛苦艰难之命。要日干生旺，不畏刑害、阳刃。为人性重，刚执不屈。若四柱中元有制伏，却要行官旺运，然后可发福。又不可专言制伏，贵在得其中，乃尽法无民之命。假如史弥远之命，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0005",
      "sha256": "42205ae0100d75dcf4e24840526070c00a05ead28a3d6e7a08a5aa531be5a32a"
    },
    {
      "section": "喜忌篇",
      "text": "甲申 丙寅 乙卯 辛巳，此用日干旺，时上偏官，月上制伏，得其中和，故为贵矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0006",
      "sha256": "8346eef0b53152279f9bc0618f6c2a2682ec4bbb30c762f867fa0654635915d9"
    },
    {
      "section": "喜忌篇",
      "text": "庚子 戊子 戊寅 甲寅，时上偏官，年上制伏，早年登第，历任尚书，乃先年巡按绣衣李如桂八字也。(眉批：六甲时遇庚午不喜官星，又年月时有辛虚名利耳。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 46,
          "end": 73,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0007",
      "sha256": "5d76e080953c42d2f36a204141be4de9ea7f3f7e8743bcd284393ff125c8701f"
    },
    {
      "section": "喜忌篇",
      "text": "财官印绶全备，藏蓄于四季之中—此论杂气财官印绶格。四季时辰戌丑未也，乃天地不正之气，为杂气也。盖辰中有乙木余气，壬癸之库墓，有戊己之土。辰戌丑未各以所藏之气而言之，此四者藏蓄杂气，为我之官星、财气、禄马、印绶也。须看四柱天元透出何字为福。次分节气浅深，若杀旺官少要制伏，喜财。若主旺相冲，要行财运库旺。大抵福聚之地不可破，如无所忌大发财。假如史太师命：",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0008",
      "sha256": "b1cb6b0dee6b27ef63eee5a8cb4705e596fb054a8519525794a2c3aab97f26bf"
    },
    {
      "section": "喜忌篇",
      "text": "丙戌 戊戌 甲午 己巳，杂气财官格，此命用辛官，己为财，戌中有辛金余气，戊己土财旺生官，所以富贵两全。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0009",
      "sha256": "93f4fc147e72ff5f510299d491af75619c6d10d4f802348e12ef83c0dbafdc69"
    },
    {
      "section": "喜忌篇",
      "text": "辛丑 壬辰 丙戌 乙未，此八字邵囱，行官印运，早年登科，仕至御史。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0010",
      "sha256": "d4b4c271467b27f5c1390183da18478477e0542d6fe265a2e3325c10d77174f4"
    },
    {
      "section": "喜忌篇",
      "text": "辛未 辛丑 庚戌 庚辰，此人虽亦辰戌丑未全，奈比劫多，又土重金埋，行酉运身旺，背逐之乡，所以刀笔，功名无成，自今鳏独。但墓库中物，自启钥以闭藏，要有刑冲破害，开启钥之物，则言发财官之贵矣。若四柱原有刑冲破害之物，再不要逢此运气，则反贵为贱。元若无财又喜行此运矣。学者直细推之。(眉批：",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 138,
          "end": 142,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": false
        }
      ],
      "layer_status": "explicit_marker_open_boundary",
      "passage_id": "yuanhai:c075:p0011",
      "sha256": "a298f48633aaad710ae42add543a0df9028f8177f2e3b7d58ddad0cbcfbb2c0e"
    },
    {
      "section": "喜忌篇",
      "text": "戊辰 壬戌 丁丑 丁未，此洪武皇帝命。)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0012",
      "sha256": "8eb1ef5f7128e425d7b60716ddf3a147ecc0ca83fcba977650b2e380ce1c046b"
    },
    {
      "section": "喜忌篇",
      "text": "官星财气长生，镇居于寅申巳亥—财官生旺于四孟，寅申巳亥乃五行长生之地。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0013",
      "sha256": "eb5b58f73788ee0ce7e668276abca0f6f49d6207736fd9e9119ec08f294733cd"
    },
    {
      "section": "喜忌篇",
      "text": "壬申 辛亥 己巳 丙寅，此命先荣后辱，己用甲为官，亥中有甲木长生，己用壬为财，申中有壬水长生，己用丙为印绶，寅中有丙火长生，此为四孟凶局。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0014",
      "sha256": "7c22d018ee92da7185b43ced16ba1dc97670d5c7d133f5604755ffdf6b134e0a"
    },
    {
      "section": "喜忌篇",
      "text": "壬寅 乙巳 癸亥 庚申，此八字初行丙午未运好，一到酉戌来，巳中丙戊财官死于酉，用神损伤，家自消乏，妻子俱丧。(眉批：碧玉歌曰印绶财官日主强名播四海。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 54,
          "end": 75,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0015",
      "sha256": "0285eb25258605854e791bf98343f71c47a91a77d5a47cb40fd7b9935823ab6e"
    },
    {
      "section": "喜忌篇",
      "text": "庚申时逢戊日，名食神专旺之方。岁月犯甲丙卯寅，此乃遇而不遇—此论专旺食神格。戊以庚为食神，其中有庚金建禄。戊土用水为财，申中有水长生，乃财旺也。戊用乙为官星，庚能合卯中乙木为戊土官贵气。若四柱透出甲丙卯寅四字，则坏了申中庚金贵气，此乃遇而不遇。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0016",
      "sha256": "1f821b7592f59dfeedbd17ce58cf70761998eea30d9b41f9b217fd2e9047833b"
    },
    {
      "section": "喜忌篇",
      "text": "己未 壬申 戊子 庚申，此谢丞相之命。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0017",
      "sha256": "955277834cf12fab01af29fe4f8911e155d1cbffefb20d57e7b2842c3009d934"
    },
    {
      "section": "喜忌篇",
      "text": "丙子 己亥 戊辰 庚申，此八字为一生员的，缘露了丙字，但中备卷三次，甲子年起贡，运行甲辰水土库于辰，用神入墓，卒于北京。(眉批：歌曰“戊日印绶食神奇，寅卯甲丙忌，寅丙是庚杀，甲乃戊之鬼，乙卯露出坏其贵，食神干旺皆为奇。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 60,
          "end": 110,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0018",
      "sha256": "a09d55d42a682db5906bdc92d37ee7691cdba45a97e5a664babd99125d40c27b"
    },
    {
      "section": "喜忌篇",
      "text": "月生日干无天财，乃印绶之名—此论印绶格，十干生我者是也。为父母、为生气，又能护我之官星，故印绶无伤官之患矣。大要生旺，忌死绝，若四柱中元有官星尤好。忌见财气，格行官运则发，若行财旺乡，贪财坏印，祸患百端，行死绝运必受其伤。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0019",
      "sha256": "54b26493f03d6c3a57ce28893b462e75f78429c3d773971b2031bce92d083e84"
    },
    {
      "section": "喜忌篇",
      "text": "丙辰 甲午 己未 丁卯，此命月生日干为印绶，系高和尚命，大运丁酉，流年壬午，当年三十岁，至元十九年三月二十四日遭极刑，故谓印生逢死绝之运，又见壬来破印也，此当年用天元，大运用地支。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0020",
      "sha256": "bc3ed7466c81a30aefd7c7edf5398c787aca58e7f56a898c6f27f1ed85dcd02d"
    },
    {
      "section": "喜忌篇",
      "text": "壬申 辛亥 乙未 己卯，此八字广东李兆龙俭事，行乙卯运，水到卯宫伤，去官。(眉批：甲乙亥壬干癸是不宜戊己见，贪财坏印则富贵×作贱，如太××喜贪民财。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 37,
          "end": 75,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0021",
      "sha256": "70f0e680b9e683ce815d7fa62933a90811a7fac7c48be67b86887849c1acd16c"
    },
    {
      "section": "喜忌篇",
      "text": "日禄居时没官星，号青云得路—此论归禄格，要四柱中无一点官星，方为此格，为青云得路。最要日干生旺，兼行食神、伤官之乡可发福。但归禄有六忌：一忌刑冲，二忌作合，三忌倒食，四忌官星，五忌日月天元同，六忌岁月天元同，犯此六者，不可一例以为贵矣。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0022",
      "sha256": "989599a2f850f73fbdcb1c7bd89fab0d9b7774144a1037c949137eea662c9c51"
    },
    {
      "section": "喜忌篇",
      "text": "甲子 丙子 癸丑 壬子，此是张都统命，乃子多为聚福归禄矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0023",
      "sha256": "d8b61d41c1866efcadd267d0f08ade9672f1945053bd083839c5a7b2f3b6276e"
    },
    {
      "section": "喜忌篇",
      "text": "甲子 丁丑 乙丑 己卯，蔡文辉八字，术士皆许读书有功名之造，后学医，行辛巳运，庚子年不禄，此非日禄归时。《独步》云：“乙木无根，生临丑月。金多转贵，火土则折。” (眉批：碧玉歌曰：辛禄居酉真为美，暗合丙为贵，柱运忌官，本身旺食伤，喜无官煞，青云得禄攀丹桂。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 81,
          "end": 129,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0024",
      "sha256": "7d89be7188cde88fae7462d36206f9cf685193fc1bc01b4e89c23d05392fa536"
    },
    {
      "section": "喜忌篇",
      "text": "阳水叠逢辰位，是壬骑龙背之乡—如壬辰日生，遇辰字多者贵，寅字多者富。盖壬以己土为官星，丁火为财星。辰日暗冲戌中之官库，所以贵也。寅字多能合午中之财，所以富也。诗曰：阳水多逢辰字乡，壬骑龙背喜非常，柱中俱有壬辰字，富贵双全在庙堂。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0025",
      "sha256": "c4d449d9049774e1420a6b1ed54fe49dcde6eda73834af1e8d3c4081b31d5186"
    },
    {
      "section": "喜忌篇",
      "text": "丙子 甲午 壬辰 甲辰，此一生员八字，术士见其早年利考，皆作壬骑龙背格，许其堪青紫。余独以财格看，谓酉戌运不善，至此果不禄，且无嗣。(眉批：《四言独步》云，壬骑龙背、见戌无情、寅多则富、辰多则荣。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 66,
          "end": 99,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0026",
      "sha256": "ab7e56a3df02afe93250d100aadc59ee476a38ca3aeaa06013fa2f95a55497b7"
    },
    {
      "section": "喜忌篇",
      "text": "阴木独遇子时，为六乙鼠贵之地—此论大惧午字冲，丙子时尤妙，谓之聚贵也。或四柱中有庚字、辛字、申字、酉字、丑字，内则有庚辛金则减分数，岁君大运亦然。如月内有官星则不用此格，若四柱中元无官星方用此格。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0027",
      "sha256": "8c230f8510e4d2581d9cb7f66383b671b2dc7a2cf7e54478d0150a970f807eb5"
    },
    {
      "section": "喜忌篇",
      "text": "丁卯 壬子 乙巳 丙子，此一禄吏八字，术士皆谓六乙鼠贵，许其功名，行申运颇得办事北京，至未运来为事罢，此只好作印看。(眉批：此言乙巳猴鼠乡，贵人有子。忌见官星，见官星则失其贵矣。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 58,
          "end": 90,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0028",
      "sha256": "3b61ed73353375863045b5c335d0ed09b68314ff0e275d60467692fb544ae2dd"
    },
    {
      "section": "喜忌篇",
      "text": "庚日全逢润下，忌壬癸巳午之方，时遇子时，其福减半—此论井栏叉格，只是庚子、庚申、庚辰合水局为贵，何也？盖庚用丁为官，子冲午。庚用木为财，而申冲寅，戌中戊土为庚之印，而辰冲之，又辰戌为财印，故以申子辰三字来冲寅午戌为财官印绶。若四柱中须用申子辰全为贵，得三庚金者尤为奇。或戊子，丙辰亦不妨。喜行东方财地，北方伤官，南方火格不为贵，故忌壬癸巳午方。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0029",
      "sha256": "ae9c65c69d35529cb8ae6702a19f9f7f8c2621ba4063846a1e28d3c31a996b5e"
    },
    {
      "section": "喜忌篇",
      "text": "庚子 庚辰 庚申 丁丑，此是王都统制命，丁卯出戎边土，得十四官诰。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0030",
      "sha256": "0b4cbf74d899b1cd88918d1c7965993f6d9ad200c4fc4a71795d6391dde636c4"
    },
    {
      "section": "喜忌篇",
      "text": "庚申 戊子 庚辰 丙戌，此一生员八字，亦候过癝，后告侍亲，惟生放发些财，而不贵。何也？所谓生江南则为橘，生江北则为柚，土产故也。(眉批：此言金生水之故，庚得申子辰水局，金又生水作润下之象，岂不为贵。若有申子合，丑刹在甲，则偏财干旺，则丙干伤庚位夺其禄。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 64,
          "end": 127,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0031",
      "sha256": "fd2c6dae58ab66969b1fcce65576321094c2f62248779ee15b5659bd709b16ee"
    },
    {
      "section": "喜忌篇",
      "text": "若逢伤官月建，如凶处未必为凶—此论伤官格。伤官之法，务要伤尽而不为祸。四柱若原有官星，伤之尤重；原无官星，伤之则轻。若三合会起伤官之杀及运行伤官之地，其祸不可言也。故伤官见官，为祸百端。若当生年有伤官七杀，为祸最重，为之福基受伤，终身不可除去。若月时见伤官之地，可发福矣。若女人命有伤官者，主克夫。若见合多为卑贱或淫滥。若无制者为师尼，合则非良妇也。若遇贵人杀者，亦作命妇而推之。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0032",
      "sha256": "87ea62d3e916953e8e8218d11adb442d8e578bc7f53ccf2b7a005cfdf5b071a0"
    },
    {
      "section": "喜忌篇",
      "text": "己卯 癸酉 戊寅 庚申，此八字一附学生，地支六冲，作戊日庚申时格不得，只好作伤官看，行南方运，常考不利，克妻无嗣，己运卒。(眉批：歌曰：“庚日生时逢子水，子水伤官岁时逢，戌巳凶中重作吉，观之中和凶以吉。” )",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 61,
          "end": 104,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0033",
      "sha256": "60d7147dc7c690c33b74796765a5645cd0f6debaabc1c6e4b4ef01765f9a9c70"
    },
    {
      "section": "喜忌篇",
      "text": "内有正倒禄飞，忌官星亦嫌羁绊—内有正倒禄飞者，乃丁巳得巳字多，冲出亥中壬水为丁官星，乃正飞天禄马格也。若辛日得亥字多，冲出巳中丙火为辛官星，乃是倒飞天禄马也。柱中有壬癸辰巳，皆是官星羁绊也，则减分数，岁运亦同。诗曰：禄马飞天识者稀，庚壬二日贵非疑，柱无羁绊官星现，平步青云到凤池。又曰：飞天禄马少人知，辛亥多逢亥位宜，不见官杀无羁绊，少年富贵拜丹樨。(眉批：假如张皇亲命，",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 175,
          "end": 186,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": false
        }
      ],
      "layer_status": "explicit_marker_open_boundary",
      "passage_id": "yuanhai:c075:p0034",
      "sha256": "3aa81fc60c9e3ef773d95a5856ee440623c2a1d507cb437041554eaa96acad9e"
    },
    {
      "section": "喜忌篇",
      "text": "丙戌 甲午 丁巳 癸卯。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0035",
      "sha256": "a26483531dc78f729ce85125db18765937f5533a30b5b58c56220208559d001d"
    },
    {
      "section": "喜忌篇",
      "text": "壬辰 辛亥 癸亥 癸亥，都堂王守仁八字，倒飞天禄马格。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0036",
      "sha256": "d05b0051218c302273f16ec44b4b6790ad29c5214f251f0e23d5e4e42f317008"
    },
    {
      "section": "喜忌篇",
      "text": "戊寅 癸亥 癸亥 癸亥，此丐者八字，露出戊字官星，斯为下矣。)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0037",
      "sha256": "517fd147afe3f4681b38953a469a6c5b3d10d79c79ddd64f93c6c191c99b46df"
    },
    {
      "section": "喜忌篇",
      "text": "六癸日时逢寅位，岁月怕戊己二方—此论刑合格。以六癸日为主星，用戊土为正气官星，喜逢寅时，用巳中戊土，癸日得官星。如庚寅刑不成，惟甲寅时是，行运与飞天禄马同。若四柱有戊字、己字，又怕庚金伤甲字，刑坏了寅字，忌申字。如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0038",
      "sha256": "8b79ce5de2b3c73d84681b586893f1db4ed6c89062d0eab302f39b300645cb28"
    },
    {
      "section": "喜忌篇",
      "text": "癸酉 辛酉 癸卯 甲寅，乃娄参政命也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0039",
      "sha256": "76654329f4a57003a48770c86a235817b8d169b86a7d10a13a53e56a86825e68"
    },
    {
      "section": "喜忌篇",
      "text": "己卯 乙亥 癸未 甲寅，此八字年上露出己字，所以功名蹭蹬，屡科不第。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0040",
      "sha256": "a079af079aa231fada1a1e68c1873e36e162b26d702e8ef4add245452afb8560"
    },
    {
      "section": "喜忌篇",
      "text": "甲子日再逢子时，畏庚辛申酉丑午—此论子遥巳格。甲用辛官，辛禄在酉，二子为甲木之印绶。子中癸水遥合巳中丙戊，合动酉位之辛为甲之官星，巳酉丑三合会起官星。喜壬癸亥子月，忌庚申辛酉，乃金来伤甲木。午字来冲子字，是羁绊则不能去遥合矣。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0041",
      "sha256": "31c1ecc468896b41ef3192524b7b46733d5307e03d09ac84c69c04bb52693bcb"
    },
    {
      "section": "喜忌篇",
      "text": "甲申 甲戌 甲子 甲子，此乃是罗御史之命，虽然是遥巳，但年上有申中庚金冲克甲，运行戊寅，寅刑巳，番成祸矣，流年乙丑则罢官。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0042",
      "sha256": "6744dbf04d0c5b061587fc12c5a9fd01edb769f03f0cd468d2cc4139dad7898f"
    },
    {
      "section": "喜忌篇",
      "text": "癸丑 己未 甲子 甲子，此八字乃一好赌博人，家业荡尽，其中畏庚辛申酉丑午，此年支正露出丑字，行东方背禄之乡，所以贫穷。(眉批：甲子日子多名，遥巳辛酉莫透露，酉能去合丑，丑能去合巳，无绊者步金阶登云路。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 59,
          "end": 101,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0043",
      "sha256": "2b46c55ff699e51b7e94a0e6fe61d312f135a3f24a1c74f75b898e89e1f3eb2c"
    },
    {
      "section": "喜忌篇",
      "text": "辛癸日多逢丑地，不喜官星；岁时逢子巳二宫，虚名虚利—此论丑遥巳格，只辛丑、癸丑二日可用。但要四柱中无一点官星方用此格。盖辛用丙官，癸用戊官，丙戊禄在巳也。丑能破巳，丙午之禄出矣。不要填实巳位，子午羁绊不能遥也。若申酉得一字为好。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0044",
      "sha256": "522c4b399843cc39263729060ee19982a6028a18c6f9c4980c0b7668296866c4"
    },
    {
      "section": "喜忌篇",
      "text": "乙丑 己丑 癸丑 癸丑，乃是叶侍郎之命。又有",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0045",
      "sha256": "b70589fec7f6eba300ed5a28af6d621efd75d3a26df0dfcfe73bdf9e7ef77876"
    },
    {
      "section": "喜忌篇",
      "text": "丁丑 癸丑 辛丑 己丑，乃王通判之命。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0046",
      "sha256": "75ead7fde14359956f40dbb4590948ab0dd8a921ea9ccdd727b35b5b305a6d18"
    },
    {
      "section": "喜忌篇",
      "text": "癸丑 乙丑 癸丑 癸亥，此八字白手发财成家，乃丑遥巳格真也。(眉批：此格要暗合官星，刑合而得，自作贵论。若四柱见了一点官星，乃只一个秀才。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 30,
          "end": 70,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0047",
      "sha256": "868a5ae02f4a42f1ede4d79bad1ed9edbd4125f2fd7c6dbb0059d08e498a8c07"
    },
    {
      "section": "喜忌篇",
      "text": "拱禄拱贵，填实则凶—此论拱禄拱贵二格，乃两位虚拱贵禄之地，四柱不可占了贵禄之宫，则填实不容物矣，只为官星荣显也。其禄贵者拱之，盛物之器皿，若空则容物，乃贵禄荣显。经曰：官崇禄显，定是夹禄之乡。又忌伤了日时，皆拱不住矣。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0048",
      "sha256": "74af017daf0bb26f676b118ebf0825b2f0cf9655d03abdabe277b83f0ba8c0af"
    },
    {
      "section": "喜忌篇",
      "text": "丁巳 丙午 甲寅 甲子，此是王郎中之命，此时日来夹丑中癸水余气，辛金库墓，巳上乘旺，乃甲木之财，官之长生，人命逢之，岂不为贵，后运行辛丑，除通判，入庚子运，庚金克甲木，又是年月冲破甲子，乃天中杀，即空亡，夹贵不住，走了贵人，一旦坏了。(眉批：拱禄不宜见真禄，拱贵不宜见真贵，只是暗中虚拱。若见真禄乃是别格，不可作此格论。",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 117,
          "end": 160,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": false
        }
      ],
      "layer_status": "explicit_marker_open_boundary",
      "passage_id": "yuanhai:c075:p0049",
      "sha256": "779c74f5c9b03353037fba60bcbf43ef4b8b6b8465e2885de63b6af92650c545"
    },
    {
      "section": "喜忌篇",
      "text": "庚戌 戊子 壬辰 壬寅，此乃戴大宝命，十一岁行庚寅中举，十九岁戊辰年中探花，行辛卯运填实卒。)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0050",
      "sha256": "9d801294ad0c11e36676d041c523859a76ac3b155ae4f771da06ca0af2b09314"
    },
    {
      "section": "喜忌篇",
      "text": "时上偏财，别宫忌见—此论时上偏财格，又名时马格，与时上偏官同。用时上天元及支内人元，只要时上一位有之，始为贵，若别位有之，便多了，难作偏财而论。要身旺，不要克破，要财运旺即发矣。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0051",
      "sha256": "3c467851bfae60bc46033f77d6cfb64e4b66864f098d650d184f69961c498e58"
    },
    {
      "section": "喜忌篇",
      "text": "丁酉 己酉 戊子 壬子，都统制命也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0052",
      "sha256": "18e0b609fb6a0fddcd8dc29e96e739cd8b9113095732fb3970a3f005869ad9fd"
    },
    {
      "section": "喜忌篇",
      "text": "丁丑 己酉 丁丑 辛亥，此八字时上偏财，月支又酉丑会局，所谓别宫忌见也，家业破尽。(眉批：假以甲日见戌时，不宜甲再至拱禄，更分财年月忌物，比若重则损六亲害妻子。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 41,
          "end": 81,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0053",
      "sha256": "82749a48b9b19157ad0476ece4a646a6be8948a30416ad1098e7ed7470931f05"
    },
    {
      "section": "喜忌篇",
      "text": "六辛日逢戊子，嫌午未位，运喜西方—此论六阴朝阳格。辛金至亥为六阴之地，而得子时，故曰：六阴尽处一阳生，故云六阴朝阳之格，乃谓阴尽还阳。辛用丙官，癸为寿星，只是要子字一位，若多不中。喜戊干，戊来合癸，动巳中暗丙，丙为辛之官星，四柱中忌见午冲破子禄。西方乃金旺之地，故喜也。东方财气，土乡次之。不要行南方火乡，北方水伤官也。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0054",
      "sha256": "fe9054e7b4eb0aa89a6c3e94d5348d50a3c4507b517b78f8d864bab364ed544c"
    },
    {
      "section": "喜忌篇",
      "text": "戊辰 庚申 辛卯 戊子，此毕甫遇命，运行西方。又如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0055",
      "sha256": "30a4fd88468e5f48f0682cf86ba74019ae65ead740013d33802ed7aaecdd2486"
    },
    {
      "section": "喜忌篇",
      "text": "己未 辛未 辛未 戊子，此王郡玉命，运地东方。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0056",
      "sha256": "c0cb8c90639dd0eedcba10fd04a957e690825ec87118fcf918378900495d906d"
    },
    {
      "section": "喜忌篇",
      "text": "甲寅 甲戌 辛卯 戊子，此一生员命，术士皆作阴朝阳格推，行东方运家破，岁考问充吏，看来还要作贪财破印而论为是。(眉批：六辛日时逢戊子，嫌丙丁巳午南运官被伤，不能朝阳。柱无火者，入朝中食俸禄。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 55,
          "end": 96,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0057",
      "sha256": "a3a2233d86a6f937887338e7662f131aa3b7f97bd3494f14aa31cf6121fef842"
    },
    {
      "section": "喜忌篇",
      "text": "五行遇月支偏官，岁月时中宜制伏。类有去官留杀，亦有去杀留宫。四柱纯杂有制，定居一品之尊。略有一位正官，官杀混杂反贱—此论偏官之格。若四柱中全无一点官星，用七杀为偏官。若有正官，此谓七杀之鬼，乃克天干也，故谓有见不见之形。全要日干生旺，故喜身旺，怕冲动羊刃，只要制伏，不要四柱见正官，有兄不显其弟之说。或岁运中、或四柱中是去官留杀何也？乃制伏是也。若官杀混杂不为清福。只此偏官七杀者，乃小人之辈，多凶暴，无忌惮，乃能劳力以养君子也。惟是不惩不戒，无术以控制之，则不能驯服而为用矣。若四柱中原无制伏，要行制伏之运。四柱中原有制伏，要行身旺之乡。若有制伏又行制伏之运，盖为尽法无民之喻。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0058",
      "sha256": "6f32000677d9ee5bb3b1c0aed0969620311a00c298e3111f27458dfd006838dc"
    },
    {
      "section": "喜忌篇",
      "text": "己未 乙亥 丙寅 辛卯，乃王章明相公之命也，乃月偏官制伏在年上，兼日坐长生之火，三合木局，丙日逢贵，所以发禄，后遭刑戮，死无棺椁，初行壬申起福运矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0059",
      "sha256": "105eb36c1f9fbabf63a208c982e4f0bf816edff13941b69f31188b87ed4bd798"
    },
    {
      "section": "喜忌篇",
      "text": "乙酉 乙酉 乙酉 乙酉，两个妇人，同此八字，一个极贵，一个极贫而有寿，何也？盖妇人之命，贵贱从夫也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0060",
      "sha256": "4f345ffe4d979ef613a2dda8ce03368f9f81876ee01de72741f7f6d5ef9747a9"
    },
    {
      "section": "喜忌篇",
      "text": "乙酉 辛巳 乙卯 辛巳，此乃朱举人命，行戊寅运，乙卯科中式，行丁丑，是巳酉丑会金局，乃杀重，壬戌年不禄。(眉批：人命若是遇七杀，时岁却遇食伤制刹反为贵。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 52,
          "end": 77,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0061",
      "sha256": "f766aa06a2305bf17aba4848d4acba3bb9cd9e2f7e2630cfa3a5051c3f81d6f0"
    },
    {
      "section": "喜忌篇",
      "text": "戊日午月，勿作刃看，时岁火多，却为印绶—此论羊刃者，非犬羊之羊，乃阴阳之阳，此禄前一位是。推阳位有刃，阴位无刃。如丙戊禄在巳，午为羊刃者。戊日得午月，午上不为刃。不为刃者，何也？乃阴火生阳土，正谓月生日干，若岁干时干又见火，乃是印绶格也。(眉批：诀曰“戊日午月号作刃，须看岁时正若逢，丙火火是戌之印，如无者富贵命。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 119,
          "end": 158,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0062",
      "sha256": "e96c4533bf89a713f72e345abedddae09edb025967bbcb86429fedcc8aeaa31e"
    },
    {
      "section": "喜忌篇",
      "text": "月令虽逢建禄，且忌会煞为凶—大凡命中以财官为贵，若四柱中有以作合，谓贪合忘官，又兼会起七杀，反为凶兆。且如甲日用酉月为官星正气，若年时子辰又会起申中庚为七刹，乃甲之鬼贼，故为凶。(眉批：诀曰：禄拱主何干夷，则慎见丙火克伤其庚，寿夭福难行。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 89,
          "end": 120,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0063",
      "sha256": "e86e86d7b70a2a62cffc11b314338b697d064dd90e2d9d0e88e3fe05aa7292ba"
    },
    {
      "section": "喜忌篇",
      "text": "官星七杀交差，却以合杀为贵—官星乃贵气之神，纯而不杂，乃为清福；杂而不纯，便坏造化。有支中合出七杀为吉兆。经云：合官星不为贵，合七杀不为凶，乃是五行赖之救助。且如甲日生人得卯时，卯中之乙能合庚字为甲之偏官，是为合杀也。若男子得之和气，与人投合，贵者。女子得之，多主心意不足，虽美丽，性乐私情，主克夫害子。如庚日生，四柱见丙为杀，则有申辰合起子为水局来救之，丙化为官则吉矣。(眉批：假如甲日见庚辛，官杀交叉，就庚是甲之杀，辛乃甲官，四柱逢乙合住庚杀为贵命。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 186,
          "end": 228,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0064",
      "sha256": "4c830c219ded3c9f03858cc8cfed4a24d6d44c377ea395f5ccc8bcac0386a876"
    },
    {
      "section": "喜忌篇",
      "text": "柱中官星太旺，天元羸弱之名—大抵人生以财官禄马为贵，取其中和之气为福厚，偏党之气为福薄。若官星太旺，天元身弱，又行官旺乡，反成其祸。且如甲乙日天元用庚辛申酉巳丑为官贵，四柱中官星既多，元有制伏则妙。本身弱须行制伏之运乃可发福。若行官旺之乡，乃造化太过，其祸害破财不可胜言，运岁亦然。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0065",
      "sha256": "6db73d077509c79a7d31989f70b1e75447c048521523061df0c2f2f7155e92c9"
    },
    {
      "section": "喜忌篇",
      "text": "辛巳 庚子 丙子 癸巳，此八字官旺行丙申，丙临申为杀重之位，甲子年十月，不禄。(眉批：",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 39,
          "end": 43,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": false
        }
      ],
      "layer_status": "explicit_marker_open_boundary",
      "passage_id": "yuanhai:c075:p0066",
      "sha256": "0c318dddca54c7049138ee2a810cb603d4993fa947f61b0f5481fc1cd9936f2f"
    },
    {
      "section": "喜忌篇",
      "text": "己未 丁卯 戊申 癸亥，官旺主弱，韩元帅命。)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0067",
      "sha256": "f0d96fb2774fb6a92ecc4db32daeddb94a387cd2e0517c374a0130e145c9668c"
    },
    {
      "section": "喜忌篇",
      "text": "日干旺甚无依，若不为僧即道—此论时旺，杀为主，本得地，乃为时旺之乡也。其人沉疴不染，老年齿牢发黑，以迈天年。如此格多出俗避位出尘，尚志慕道修禅，乃日干甚旺。且如庚日生人，月时在申，或运入西方，此庚以火为官星，火至西方而死，庚以木为财，木至西方而绝，既是财官禄马俱无，则欲步于前程，何以施殷，故无依倚，乃持身旺地，盖顺身远害之命。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0068",
      "sha256": "154f4f7d41b8dd4f0f8b8d1d6df88d3e85402f4cc28e99698d3a3b462273833b"
    },
    {
      "section": "喜忌篇",
      "text": "乙卯 丙子 丙午 癸巳，此祁真人命，日干旺于东南方运。(眉批：日干甚旺若无依，喜逢财禄食连行，官来财至多福庆，无男无女到僧尾。日干甚旺若无依，喜逢印财食运行，官见美财印发福，地若无依男为僧道女为尼。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 27,
          "end": 100,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0069",
      "sha256": "2ff7eabbecd7d61b206bd2975e3b3634b508e5e1b9faf1191b402c8d68a2195d"
    },
    {
      "section": "喜忌篇",
      "text": "印绶生月岁时，忌见财星。运入财乡，却宜退身避位—此论月生日干，乃印绶之名。印绶乃喜官星，畏财气，若天干财乡，乃坏印也。印绶者乃我气源，须根固，若行财位者宜退身避位，不然必遭降谪徒配也。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0070",
      "sha256": "aa20cc6c96578943df77c8fbb438206a4ae34134166136860e109a3a164db516"
    },
    {
      "section": "喜忌篇",
      "text": "庚戌 甲申 癸丑 丁巳，此命月中正气庚金印绶，本主杂气不合，巳中丙火为癸之财，其水见财，贪财坏印，一生蹭蹬。故曰：印绶在刑克之地，心乱身亡之故也。后大运行己丑，流年丙寅，四月破家，何故？原有伤印之财，岁运又行伤运气，庚入墓也。(眉批：月中有印绶生日，岁时怕财至，运若逢财地则家破官让。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 113,
          "end": 143,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0071",
      "sha256": "eba31f5534d509e9b82b8e4230021713b0dea9e6eef50ce742d5c1cd8dc0c2c7"
    },
    {
      "section": "喜忌篇",
      "text": "劫财羊刃，切忌时逢，岁运并临，灾殃立至—劫财乃是日上天元分争财禄，比肩是也。羊刃者，禄前一位是也。且如禄马，甲禄在寅，甲用己土为财，见卯为刃，来相侵夺己土也。假如戊午日并月时相同者，二三丁戊字者，其相侵夺癸水为财，故曰劫财。以戊禄在巳，前一辰见午，午有己土克癸水，此之谓劫财羊刃，故主破财散业，离家失祖，施恩反怨，心性卒暴，进退狐疑。偏主庶妻为正，带疾破相，性贪婪，智大心高，伤害不足。若运流年逢之，因财争竞，不然疾病，连及妻子矣。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0072",
      "sha256": "7df4fbde4c1774230155716d1554b787c40b960d0cfe2583d3b4bfb592e6c5b2"
    },
    {
      "section": "喜忌篇",
      "text": "癸未 乙卯 甲子 己巳，此岳飞将军命，此为劫财羊刃，甲以己为财，以乙为刃，见卯羊刃，劫而有损，乙卯正谓劫财阳刃，运行辛亥，流年辛酉，三十九岁死于狱中。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0073",
      "sha256": "4575a8dda8925b5c102b15f149b9971391904fe411913b5657afddba908a794b"
    },
    {
      "section": "喜忌篇",
      "text": "戊寅 乙卯 甲戌 甲子，此八字有祖业，有子息，无兄弟，父母早丧，自今正发，行己未运，甲子年，因官事破财不禄。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0074",
      "sha256": "acc5a591d285a2512120f25164dd9a7c68eddefd3253fa7ce88d9563c7045da7"
    },
    {
      "section": "喜忌篇",
      "text": "戊寅 乙卯 甲子 甲子，此八字有些祖业，有庶生克，无子息，父母早丧，丁巳运癸卯年，被兄打破疾死，何也？盖春木无金，岁运又见卯也。(眉批：劫刃，甲子生卯年月，再见乙，己土中之财被乙来劫去，岁运来并凶死而已矣。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 64,
          "end": 104,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0075",
      "sha256": "7aea4bddf15e77bd52fcf3fe748247d03c78cef8b161a4feb49817217bb75e98"
    },
    {
      "section": "喜忌篇",
      "text": "十干背禄，岁时喜见财星，运至比肩，号曰背禄逐马—财为马。禄之向也，为顺；背也，为逆。且如四甲得寅为禄，若遇巳丙为背禄。经曰：背禄主无财之论，主初明后晦，喜财星，戊己土助其身，火至亥无气，比肩见甲分财。经云：马者，在乎财位。乃甲见寅为身旺。庚申(甲寅)用土为财、土至寅病，金至寅绝，乃禄马皆不扶身。赋云：马劣财微，宜退身避位，岂不谓之守穷途而凄惶也。(眉批：如甲日用辛为正官，柱有甲木旺运，再逢旺寅，背禄逐马，主妻分散子别离。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 174,
          "end": 213,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0076",
      "sha256": "baef87bc920528de39d5dfd71ff48ddac47d7a10a60bfad91ae72d1ab2e39f9e"
    },
    {
      "section": "喜忌篇",
      "text": "五行正贵，忌刑冲克破之宫—正气官星者，提纲之要。用时上财气乃贵人也，忌刑冲克破之神填之。(眉批：财官印号三奇，五行之正气。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 44,
          "end": 62,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0077",
      "sha256": "0c131bd9b020a1ee6d2709f682d2ed28871a4850912ddb1d96d747a3fde72819"
    },
    {
      "section": "喜忌篇",
      "text": "四柱干支，喜三合六合之地—凡干支有三合六合者，乃天地阴阳万物，皆有感应相合。倘得刚柔相制两相对，所以是眷属性情，妻贵在乎大人之重，乐乎生人之禄，合财为官禄之相从，合刑为刑煞之相压也。(眉批：此合财宜于男为吉，女人大忌。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 91,
          "end": 110,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0078",
      "sha256": "9c5f10b2a841efa2c204d5a870b96c1162b1f40f942e67aef029aa7028bbcd63"
    },
    {
      "section": "喜忌篇",
      "text": "日干无气，时逢羊刃不为凶一一且如甲申日，卯时为羊刃，此是申中庚金能克卯中乙木，为财为马为妻，虽逢刃不为凶矣。日干弱喜逢刃，有印助显其刃，主福寿，无印主贫。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0079",
      "sha256": "41ff5387835296dd14e857f41b109c69f72a29221829037a627e74a38087e726"
    },
    {
      "section": "喜忌篇",
      "text": "甲午 丁卯 戊子 戊午，此八字戊土春生则弱也，喜午时为刃，以帮其身，原有禄来，行南方印运，增创大来，但官杀混杂，考降后，纳粟去作国子生终。(眉批：干弱喜逢刃，主福寿无疆。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 69,
          "end": 86,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0080",
      "sha256": "eb31c095bdfdaa6061a81602b521be91266e0f995bd2e45b3bea86bdc558998d"
    },
    {
      "section": "喜忌篇",
      "text": "官杀两停，喜者存之，憎者弃之—甲用辛酉为官星，又见庚申，何以是？又见三合之混杂。甲乙用庚辛为官贵，而有巳有丑，是官杀混杂，虽有制伏之运，或去杀用官，或去官用杀，方发福。若混杂之命，岁运更在旺乡，混官杀，其祸不可俱述也。(眉批：有制则吉，无制则凶。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 109,
          "end": 124,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0081",
      "sha256": "6c561c1d6824b88bb86fa350f3f6dfb1907b3baea8eebcef8cc210dd650b3034"
    },
    {
      "section": "喜忌篇",
      "text": "地支天干合多，亦云贪合忘官—且如甲用辛为官而有丙，见庚为杀而有乙，用庚为官而辛为杀，又有丙及支干多合。此阳官阴杀，则阴官阳杀，乃是造化之必然也。若是四柱有合是为贪合忘官。经云：合官星不为贵，合七杀不为凶，五行有救助之谓也。(眉批：诀曰“男儿多合性聪明苗而秀亦成，女人多合怪性情淫贱必遭贫。”)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 111,
          "end": 146,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0082",
      "sha256": "2244ac3d037dd1ff9ed4d995b56b85e1c14f65041e8343299df92c9b214240a5"
    },
    {
      "section": "喜忌篇",
      "text": "四柱杀旺运纯，身旺为官清贵—此七杀即偏官也，宜制伏。四柱内以杀为官。且如甲见庚为杀，而甲生于寅地，乃身旺。其寅暗包丙长生，则不畏金为杀，以杀化为官星。则甲庚各自恃旺之势，而行纯旺运，乃为极品之贵。(眉批：",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 98,
          "end": 102,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": false
        }
      ],
      "layer_status": "explicit_marker_open_boundary",
      "passage_id": "yuanhai:c075:p0083",
      "sha256": "6c5ed7b6ba8acad184cfde79a31d0847f1e96d6715fb24bda3da317a36509edb"
    },
    {
      "section": "喜忌篇",
      "text": "壬申 己酉 丙午 戊子，知县命。)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0084",
      "sha256": "228be82a157052eaba4a681cc26924c0c574d3f14d6542d5894a5b38b79dbef8"
    },
    {
      "section": "喜忌篇",
      "text": "凡见天元太弱，内有弱处复生—此论日主自坐官杀，乃为人元弱处复生，乃是胎生元命。且如甲胎在申，申中有庚金为偏官，为六合中受气相感气生胎元，得壬水长生，酉上沐浴，戌上冠带，亥上临官，如人之算日必生木也。此格只要官星旺运方可发福，不要冲克。(眉批：如甲木死午，喜壬癸，露丁己能生金，土生甲助方可发福。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 117,
          "end": 148,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0085",
      "sha256": "272a38ea86236d73d85486f1da47b03a44ffa2bc36fe27591164f320df531cf6"
    },
    {
      "section": "喜忌篇",
      "text": "中七杀全彰，身旺极贫—伤官本禄之七杀，败财本马之七杀，偏官身之七杀，四柱有之，身旺建禄不为富矣。(眉批：",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 48,
          "end": 52,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": false
        }
      ],
      "layer_status": "explicit_marker_open_boundary",
      "passage_id": "yuanhai:c075:p0086",
      "sha256": "a680c0aa6d710aa0d0f04e5334aa1472011620bd3a4fdb4b4da4baf14cb91453"
    },
    {
      "section": "喜忌篇",
      "text": "乙酉 乙酉 乙酉 乙酉，为七杀全彰。)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0087",
      "sha256": "7b085460d54950862546f1516f3c4e164c1ef3c344a327ac02551add8f9c2721"
    },
    {
      "section": "喜忌篇",
      "text": "无杀女人之命，一贵可作良人—大抵看男命与女命不同。女命不取官星，不取财星，不取贵人，不取三合六合，不要财马生旺暴败，不要干支刚强羊刃，不要比肩。乃见如此，何以知其贵贱乎？答曰：阴人者，如此一同论，若天元运动，岂能分别寒暑、四时、八节、霜露、雨雪、阴晴岂能辨哉？阴人者，全靠夫主，夫贵妻亦贵矣，夫贫妻亦贫，乃天地阴阳之理也。凡女人之命，大喜要安静清贵，旺夫旺子为妙。若绝气并刑冲破害不美，若命有夹贵者，必为贵人妻矣。(眉批：女人命只取一官为贵，其余不可重见，或合偏财禄马伤官者，皆非良妇也。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 207,
          "end": 245,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0088",
      "sha256": "076f93fb02d81d9fd8c046b12b6e17dc870a98fd4cb8283715079211c29bd2bf"
    },
    {
      "section": "喜忌篇",
      "text": "贵众合多，必是师尼娼婢—贵者官杀也。官者正夫，杀者偏夫。合者地支暗合，三合六合、心多不足，虽生美质，性乐私情，非良妇也。凡命七杀，食旺多制，做事纵多磨，然性高明才学，有差磨青衫，不结家败破。(眉批：身旺有合，华盖空亡，生长聪明，好与僧道为伍。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 95,
          "end": 122,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0089",
      "sha256": "7062835d202d9da4054db02c2bbae10e28ee33e95171c9459c50de60c650f8fe"
    },
    {
      "section": "喜忌篇",
      "text": "偏官时遇，制伏太过乃是贫儒—偏官主人性聪明，有刚强傲物。若四柱中制伏多，乃尽法无民也。中和之气为福厚，偏党为福薄。假如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0090",
      "sha256": "840ca594c43ed87594fd66273c1e8d577d393e8fbbb722dd33f4c3abc6525528"
    },
    {
      "section": "喜忌篇",
      "text": "丙午 甲午 癸亥 乙卯，此乃是钱应宾秀才命，月上偏官，所以伤残，目盲足跛，却有文章秀气，终身贫穷矣。(眉批：凡命七杀食旺多制，做事多蹭，纵然生高明才学有差讹，青衫不结家囊破。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 50,
          "end": 88,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0091",
      "sha256": "87d15c175566b562eda776c57494c60ffb3fb0bf701dac7ec672731ddc51ed12"
    },
    {
      "section": "喜忌篇",
      "text": "四柱伤官，运入官乡必破—此论伤官。四柱有官星，运入官乡，被破者轻，须要明轻重。假如癸未、癸亥、辛未、癸巳，此一都丞命，辛以丙为官，时中有丙，见癸水则破其官星矣。(眉批：四柱有伤官，再运行伤官之地则不宜矣。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 80,
          "end": 103,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c075:p0092",
      "sha256": "2ca3d85a7ed18e738a37e71e5e3619eb53e281b4923f1595578974c9ccc0f834"
    },
    {
      "section": "喜忌篇",
      "text": "五行绝处，即是胎元，生日逢之，名曰受气—胎元逢生，名曰受气。诗曰：五行绝处是胎元，生日逢之富贵全，更若支元来佑助，定然衣锦早乘轩。度理可以知幽微之妙，度性可以知生死之理。木绝在申，即受气，胎酉，则养戌，亥宫是主死中复生，气亡又伏，存才名遂。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0093",
      "sha256": "9d6a2c219cb234b5f308fc1ab676801b12bf660f95e27615c79255d32a1f33f2"
    },
    {
      "section": "喜忌篇",
      "text": "甲辰 壬申 丙子 己丑 ，丙子乃胞胎，日支会局，喜甲木生之，己土制之，一交甲戌运，甲子科中式。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0094",
      "sha256": "e0d03d155a3befca37b7d3d19fff3fc400881b7d0375006a4fda9af78791dec7"
    },
    {
      "section": "喜忌篇",
      "text": "是以阴阳罕测，不可一例而推，务要禀得中和之气。神分贵贱，略敷古圣之遗书，纵约以今贤之博览。若通此法参详，鉴命无差无误矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c075:p0095",
      "sha256": "b1825d4c2b7b42327f4c61c639ab0df6f20c05671c44115834bc962d092bd106"
    }
  ]
}
