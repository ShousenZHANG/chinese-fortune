    {
      "section": "论七杀即偏官",
      "text": "渊海子平卷二",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c080:p0001",
      "sha256": "7ff3cf914c80f6b91688ae2c54d143b1d64be1e4fc0c5f98b16611fb00d628f4"
    },
    {
      "section": "论七杀即偏官",
      "text": "论七杀即偏官",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c080:p0002",
      "sha256": "1293f9d2e760c8c54b48b515cf4c5ee71dcf76afe2dcef246d412973a647dc1c"
    },
    {
      "section": "论七杀即偏官",
      "text": "夫七杀者，亦名偏官。喜身旺合杀，喜制伏，喜羊刃；忌身弱，忌见财，忌无制。身旺有气为偏官，身弱无制为七杀。凡有此杀，不可便言凶，有正官不如有偏官，多有巨富大贵之人，身旺合杀为妙，如果以庚为七杀，喜丙丁制之，乙合之，谓之贪合忘杀。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c080:p0003",
      "sha256": "fd7d76368a0e81073e13a8c66ce9055b1487b66dd2aebe794cb4ae202a88a1a3"
    },
    {
      "section": "论七杀即偏官",
      "text": "七杀却宜制伏，亦不要制之太过，盖物极则反为祸矣。身旺又行身旺之运为福，如身弱又行身弱之乡，祸不可言。四柱中原有制伏，喜行七杀运；原无制伏，七杀出为祸。如行身旺乡，更有羊刃，贵不可言。但忌财旺，财能生杀故也。岁运临之，身旺亦多灾，身弱尤甚。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c080:p0004",
      "sha256": "825bfda6d914df77c07ad904eff91bb738a663b13ba689dc5d3920772b5d5eed"
    },
    {
      "section": "论七杀即偏官",
      "text": "甲申 、乙酉 、丁丑 、 戊寅、己卯、辛未、癸未，此七日坐杀，性急伶俐，心巧聪明。如见杀多者，主人凶夭贫薄，月见之重，时见之轻，何也？曰：七杀只一位见之，如年时再见，杀多为祸，却要制伏之乡。又要身旺，有制伏为权，最怕冲刑羊刃，大凶。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c080:p0005",
      "sha256": "4d3917a749877e04ce6fc21cce8d2371ead6dafc6f75c04b1c25d0c1f31b0002"
    },
    {
      "section": "论七杀即偏官",
      "text": "时上七杀只一位，要本身旺，如年月日时上处有制伏为福，却要行杀旺运，三合得地亦发。若无制伏，则要行制伏为福，行杀旺运无制伏，则祸。作时上七杀，却不怕羊刃，而亦不畏冲。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c080:p0006",
      "sha256": "8899bbdb2be75af86e59eed6408f1fe6894d89cd79844acb44861dae1e4a6ff0"
    },
    {
      "section": "论七杀即偏官",
      "text": "如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c080:p0007",
      "sha256": "b27f740b14fe3f5b2b622ce486a5e756d80850ff47c34a0dc365016b4737cd9a"
    },
    {
      "section": "论七杀即偏官",
      "text": "辛丑 乙未 乙卯 丙子，此命身旺，生於六月之中，岁干透辛丑为杀，喜得丙子合辛丑七杀，乃贵而有权。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c080:p0008",
      "sha256": "7737a76d720a9e4f790c76ad87c48e2fae40454f443c141485805822db2f3d19"
    },
    {
      "section": "论七杀即偏官",
      "text": "眉批：此言合杀为贵。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 10,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c080:p0009",
      "sha256": "dc47112f76fc5ce3b3da1679acbd7751f600aafc6bdab2f92d8214e9d095dc7a"
    },
    {
      "section": "论七杀即偏官",
      "text": "又如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c080:p0010",
      "sha256": "c951f6e073df0f6f75948385d95b70851d93e358f263ca7a3be7980eb4ced16b"
    },
    {
      "section": "论七杀即偏官",
      "text": "甲午 丙寅 庚子 丙子，此命身弱，见火局又见月令丙寅七杀，时又见丙子，火克庚金，金死於子，身弱杀旺，又无制伏，宜乎带病贫薄。(眉批：此言杀重身弱。)",
      "layer": "historical_work_transcription_with_commentary",
      "commentary_spans": [
        {
          "start": 62,
          "end": 74,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c080:p0011",
      "sha256": "fe90f862c65ed238d2e015af2618c86dae1d048092d2756d86efd31aa0504160"
    },
    {
      "section": "论七杀即偏官",
      "text": "如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c080:p0012",
      "sha256": "b27f740b14fe3f5b2b622ce486a5e756d80850ff47c34a0dc365016b4737cd9a"
    },
    {
      "section": "论七杀即偏官",
      "text": "丁巳 戊申 壬子 戊申，此命身旺，见二戊为七杀，引归於巳。丁与壬合，戊与癸合，金又长生於巳，戊禄在巳，乃是壬戊二字俱旺，所以贵也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c080:p0013",
      "sha256": "c4d69719d900381154782e256fb1026ab1dee8f54da64a9997e3aeef53e2b6c5"
    }
  ]
}
