  "raw_sha256": "811a8dd021c209b187c5696ae0af9d9187eb153d0de30da2dee00c79b0dcac2d",
  "raw_kind": "cleaned_original_transcription_not_complete_http_response",
  "extraction_kind": "selected_original_html_node",
  "issues": [],
  "passages": [
    {
      "section": "伤官诗诀",
      "text": "渊海子平卷五",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0001",
      "sha256": "d284d3c59105f6347a605b7d9c7a48dc5eebdc667d0b53daee688840ad6bd8a9"
    },
    {
      "section": "伤官诗诀",
      "text": "伤官诗诀",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0002",
      "sha256": "442f2fbe5b1a32e05a521f1c5fdf461dd64057b996785ea7e13ba4af182d854b"
    },
    {
      "section": "伤官诗诀",
      "text": "伤官伤尽最为奇，尤恐伤多反不宜，此格局中千变化，推寻需要用心机。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0003",
      "sha256": "09a5a20617f8fa69d8700f575c6612b964449716b1fa929b6055f157e22eb110"
    },
    {
      "section": "伤官诗诀",
      "text": "火土伤官宜伤尽，金水伤官要见官，木火见官官有旺，土金官去反成官，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0004",
      "sha256": "15057f24f661758ee240eb124dacc8ec4ab9dcc857dc9bb14d222c3f34b09af9"
    },
    {
      "section": "伤官诗诀",
      "text": "惟有水木伤官格，财官两见始为欢。伤官不可例言凶，辛日壬辰贵在中，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0005",
      "sha256": "8e24ff6daf597652e899824163ff8943db245aa9a3b4bdbbeddd86214a79e2ab"
    },
    {
      "section": "伤官诗诀",
      "text": "生在秋冬方秀气，生於四季主财丰。丙火多根土又连，或成申月或成乾，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0006",
      "sha256": "896d93e89748397a59cf6a9a414d9952cf1036bf307c8efe445f85cfb2780990"
    },
    {
      "section": "伤官诗诀",
      "text": "但行金水升名利，火土重来数不坚。伤官不可例言凶，有制还他衣禄丰，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0007",
      "sha256": "1cdda60576b88413782e7f84f8869642298fd183f2b296bdd940133624bd4b3d"
    },
    {
      "section": "伤官诗诀",
      "text": "干上食神支带合，儿孙满眼寿如松。伤官遇者本非宜，财有官无是福基，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0008",
      "sha256": "62142d98532c713768c7b12934a6b69c9994a3a99b0088d7e3a2ac661704acaa"
    },
    {
      "section": "伤官诗诀",
      "text": "时日月伤官格局，运行财旺贵无疑。伤官伤尽最为奇，若有伤官祸便随，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0009",
      "sha256": "7263d5cfab6224968bc78b4b2aecc095df142514b2dd4ccf386fed0c738f952b"
    },
    {
      "section": "伤官诗诀",
      "text": "恃己淩人心好胜，刑伤骨肉更多悲。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0010",
      "sha256": "c6a850c8746e26201e27b3e9afe736b84bbbe088cac60654880aaf6ec2ef9928"
    },
    {
      "section": "伤官诗诀",
      "text": "补：",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0011",
      "sha256": "ad592f8b264aaeddf8801e317f934c68fd9278174ad0fac30c18e20ba79ba084"
    },
    {
      "section": "伤官诗诀",
      "text": "伤官原是産业神，伤尽真为大贵人，若是伤官伤不尽，官来乘旺祸非轻。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0012",
      "sha256": "2637b0ded3d0734072a2847dee03650ba9286bf5ffffc8a47afb01d5305ac4e1"
    },
    {
      "section": "伤官诗诀",
      "text": "月令伤官在伤乡，伤轻减力尚无妨，若见刑冲并破害，定知为官不久长。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0013",
      "sha256": "e1dbe003515147361a69c9ff47af7ec1142b01e1dbb5bf848a315ce0cd6203c5"
    },
    {
      "section": "伤官诗诀",
      "text": "伤官伤尽复生财，财旺生官互换来，四柱若无官显露，便言富贵莫差疑。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0014",
      "sha256": "7464b5e1ad02c975da11677e1021ba1c602fd700dcb75757056f49fc8ea4eed2"
    },
    {
      "section": "伤官诗诀",
      "text": "年上伤官最可嫌，重则伤身寿不延，伤官伤尽生财贵，财绝逢官祸必连。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0015",
      "sha256": "4196ab7a7fcca8dd1eb65810b102d75b3957f5d4e0b191efcfe3a4473f4ed7b0"
    },
    {
      "section": "伤官诗诀",
      "text": "伤官不忌比肩逢，七杀偏官理亦同，若是无官当忌比，如逢身旺却嫌重。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0016",
      "sha256": "db2b12291a46b2e93c90bee88b6b08d57981056e943a8cac741739cb9ab988bd"
    },
    {
      "section": "伤官诗诀",
      "text": "伤官伤尽复生财，气质刚明实伟哉，纵使祖财无分有，等闲玉帛自天来。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0017",
      "sha256": "48ab8a93e061c66f0aa47142bfa682c8871c3d87bb6b10d57059e54720c7c51d"
    },
    {
      "section": "伤官诗诀",
      "text": "伤官伤尽最为奇，福禄峥嵘亦寿弥，岁运更行身旺地，逢财身旺贵无疑。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0018",
      "sha256": "ae38490e8f0a3cc5719e814d4a721d4281d8d1f1bad579400ac3c6902b7056e5"
    },
    {
      "section": "伤官诗诀",
      "text": "伤官不尽又逢官，斩绞徒流祸百端，月犯父子无全美，日犯自己主伤残。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0019",
      "sha256": "1be269ad898f0f98db9659085dfc6e04c11ecd811409d5d02d04ed3f364801b4"
    },
    {
      "section": "伤官诗诀",
      "text": "时伤子息多狼狈，须知富贵不周全，若是伤官居太岁，必招横祸逢斯年。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0020",
      "sha256": "8ac800bcb26910e8315bc485c7ccc843cc73c6296446671b6567e024b1870cc7"
    },
    {
      "section": "伤官诗诀",
      "text": "甲木伤官寅午全，火明木秀利名坚，运行最怕财官旺，见戍行来住寿元。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0021",
      "sha256": "d54ecbf0269d14f36a241de1666bdfefe6343aa37de2e26516ed1e96e6db528a"
    },
    {
      "section": "伤官诗诀",
      "text": "乙木伤官火最强，运行官杀转为良，只怕水多伤不尽，一身名利有乖张。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0022",
      "sha256": "296d07d85c7dd78c6ff1efcd7d6682de7b9749ba7e619606865b35d5ee26ab2e"
    },
    {
      "section": "伤官诗诀",
      "text": "丙火伤官燥土重，运行财旺福兴隆，如逢水运遭伤灭，世态纷纷总是空。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0023",
      "sha256": "95300d0e26bdb9957122f019375e5637b00527651dbed55ddc5c4bb4b1f90052"
    },
    {
      "section": "伤官诗诀",
      "text": "丁火伤官火又柔，主人骄傲有机谋，运逢印绶连官杀，垂手成家孰与俦。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0024",
      "sha256": "8f04ef9b9303e3c64f9037272306ef6b0b0ac806d201e887bd084d61045819fb"
    },
    {
      "section": "伤官诗诀",
      "text": "戊土伤官最爱金，柱中极畏火来侵，金衰不喜行财运，土既消磨金又沈。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0025",
      "sha256": "b717f979743381265f6eff846dbba42e054ffeef79dae54163db7cb1dd0cd4e8"
    },
    {
      "section": "伤官诗诀",
      "text": "己日伤官金最旺，强金柔土喜财乡，运逢官杀终有祸，名利兴衰不长久。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0026",
      "sha256": "f0b075d5550e1bdfd71a88a7d88d657f49cbb9a03ae627b9d14761c6797a1bce"
    },
    {
      "section": "伤官诗诀",
      "text": "庚金伤官喜见官，运逢官杀贵千般，正是顽金逢火炼，少年折桂上金銮。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0027",
      "sha256": "075b0a221e242513f21b2a201160b978f4b372a622fb1ecee4f26c193df2d2a4"
    },
    {
      "section": "伤官诗诀",
      "text": "辛金伤官申子辰，伤官伤尽喜财星，东南行运焰焰火，背禄行来仔细吟。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0028",
      "sha256": "e50431b6f85ade256557402de63be0126157ff824be749bc1e1a4716f2ad9825"
    },
    {
      "section": "伤官诗诀",
      "text": "壬水伤官怕木浮，见官见杀反为仇，再行财旺生官地，财禄无亏得到头。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0029",
      "sha256": "61c50f1481b611a838b22766338d834f6de0960cf6a31cade1a0782a8d0eb432"
    },
    {
      "section": "伤官诗诀",
      "text": "癸水伤官怕见官，最嫌戊己透天干，再行财旺生官地，世事纷劳祸百端。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0030",
      "sha256": "f01a2fb95ba249d58709f95f9c88cbe344e6e3f7e1f9ddb6eaf06c1c165598fe"
    },
    {
      "section": "伤官诗诀",
      "text": "眉批：伤官，泄气之神也，故格中多忌之，惟火土忌之最紧，金水木火惟木不忌，贵有情。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 40,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c223:p0031",
      "sha256": "7b97f33557d93c6472f899ae736a8cfc834f54889dde73104713025979407810"
    },
    {
      "section": "伤官诗诀",
      "text": "金水伤官谓之金水相涵。火土伤官，炎上气偏，格中忌之。伤官在儿女宫主无子，若有制伏主多子且有寿。伤官乃小人之情，喜财而遇官又行财运，反主富贵。若四柱无一点官星，谓之伤尽。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c223:p0032",
      "sha256": "a20420608b7cad557ccc41eeed1d3a4e89b30a90e95dadf9196c24d8c72924c7"
    }
  ]
}
