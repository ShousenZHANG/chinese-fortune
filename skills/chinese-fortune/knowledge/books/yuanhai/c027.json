      "section": "论三奇贵人",
      "text": "渊海子平卷一",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c027:p0001",
      "sha256": "a5b823f6ea5176cb26de398b4c34c75d5a8a162220ac6a0c9e33ec836fae8376"
    },
    {
      "section": "论三奇贵人",
      "text": "论三奇贵人",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c027:p0002",
      "sha256": "55fa0e58eba3eb5ba3d2793bcaaa5886c3154c9dcbf566dd2f343bc49c71d109"
    },
    {
      "section": "论三奇贵人",
      "text": "天上三奇甲戊庚，地下三奇乙丙丁，人中三奇壬癸辛。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c027:p0003",
      "sha256": "97fa60b1f6fd53754fee8d701627e053ab8d83cbeade04f30ce23036de0baa90"
    },
    {
      "section": "论三奇贵人",
      "text": "甲戊庚者，以甲为日，以戊为月，以庚为星，既有日月星，地支须得戌亥为天门，方得为奇。若无戌亥，须有日月星而无天门，则不为奇矣。而有天门，若无丑卯酉巳又不为奇。寅中有箕星好风，酉中有毕宿主雨，丑卯为风雷，则三光失明，奇不得时也。地下三奇，乙木为阴木之魁，丙火为阳火之君，丁火为阴火之精，此地有之为奇。须用乙，乙属坤土，若无则不吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c027:p0004",
      "sha256": "347f3f7ac20e86f8b170e3570a64e7f41c626d188a6c33dee9db22eb74751832"
    },
    {
      "section": "论三奇贵人",
      "text": "眉批：",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 3,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c027:p0005",
      "sha256": "d3cd2fcbf2e6933caadea1989197a6cc660dcb68a869e05c27b78d9589db0039"
    },
    {
      "section": "论三奇贵人",
      "text": "程思曰“三星要顺，倒乱者非，日为一腐三矣”。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c027:p0006",
      "sha256": "476351a6917ad7664f9a4a1b0eedcbb6568c1e4e1276be56601cdf5fcb237770"
    },
    {
      "section": "论三奇贵人",
      "text": "《壶中子》曰“三奇倒乱，吕望为王头钓专”。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c027:p0007",
      "sha256": "4aa71ec14770e22da7f4e6fc1abdef5d32577b6d606a0f950623f2f1e2520f06"
    }
  ]
