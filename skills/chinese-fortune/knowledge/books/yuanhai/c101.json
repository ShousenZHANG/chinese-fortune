      "text": "内十八格 - 时上偏财格",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c101:p0002",
      "sha256": "0b1a77babb7a6832f001f6ae2313c18b753d89e68fe03acd39e34e8acaed0992"
