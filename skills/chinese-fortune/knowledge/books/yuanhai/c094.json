  "passages": [
    {
      "section": "论日刃",
      "text": "渊海子平卷二",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c094:p0001",
      "sha256": "7ff3cf914c80f6b91688ae2c54d143b1d64be1e4fc0c5f98b16611fb00d628f4"
    },
    {
      "section": "论日刃",
      "text": "论日刃",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c094:p0002",
      "sha256": "c86d6ac22301fa5b17fb06445b302c801b810dd6555c58a9daa95783eaa0a09b"
    },
    {
      "section": "论日刃",
      "text": "日刃与羊刃同，日刃有戊午、丙午、壬子也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c094:p0003",
      "sha256": "5c9b63bd351f962b795a2b3594def18edd2f944c09517ce273dfa05ceb4667cb"
    },
    {
      "section": "论日刃",
      "text": "与阳刃同法，不喜刑冲破害，不喜会合，兼爱七杀，要行官乡便为贵命。若四柱中一来会合，必主奇祸。其人目大须长，性刚果毅，无恻隐慈惠之心，有刻薄不恤之意。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c094:p0004",
      "sha256": "fa616685c7be73b11e261f674d768036f610697f904878ce998cbad33d603327"
    },
    {
      "section": "论日刃",
      "text": "三刑自刑魁罡全，发迹疆场。如或无情或财旺，则主其凶，或有救神，要先审察。如刑害俱全，类皆得地，贵不可言也，安得不举。独羊刃以时言之，四柱不要入财乡，怕冲羊刃。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c094:p0005",
      "sha256": "80cd9ec2f7182f742edc3b5cbcae65a15e7d3ae30bf1fdeaf5d923883ad6c9d9"
    },
    {
      "section": "论日刃",
      "text": "且如戊日刃在午忌行子正财运。壬刃在子，忌行午正财运。庚刃在酉，忌行卯正财运。甲日行戊己并辰戌丑未正财运不妨，忌酉运。丙日刃在午，行申酉庚辛丑不妨，忌子运。大抵羊刃要身旺，喜有物以去之。经曰：人有鬼人，物有鬼物。逢之不安，去之为福。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c094:p0006",
      "sha256": "69c3981a9a052f6334cc60f8ebf839e4a4935b414a33fc3755da6f459a394e97"
    },
    {
      "section": "论日刃",
      "text": "且如葛参政命：",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c094:p0007",
      "sha256": "97d0976365c2573a859e5e96303152204621004921718fb3499c5ec18da2778d"
    },
    {
      "section": "论日刃",
      "text": "壬申 壬子 戊午 乙卯。戊日刃在午，喜得乙卯时，正官制伏去了，所以为福也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c094:p0008",
      "sha256": "c980f023940e3bb115e081e14d8d524d1dcf7fc4ff5d6c7355e590b78abfb015"
    },
    {
      "section": "论日刃",
      "text": "眉批：日刃主克妻，在时上克子，冲运多祸灾，遇恶杀并，必凶死。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 30,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
