  "raw_path": "sources/yuanhai/c216.html",
  "raw_sha256": "fefc63d6c5385be028a0a62392c4ff2ac660f7fa20f9a2fbba7dd574ddbe7212",
  "raw_kind": "cleaned_original_transcription_not_complete_http_response",
  "extraction_kind": "selected_original_html_node",
  "issues": [],
  "passages": [
    {
      "section": "十二支体象",
      "text": "渊海子平卷四",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0001",
      "sha256": "f981a62c7da7a5ad79fbd8eff95f693bffd1820b2aa5425445b6992c612e6db0"
    },
    {
      "section": "十二支体象",
      "text": "十二支体象",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0002",
      "sha256": "5e9d7c05a050c9d1d53cf9d489a9ac1f956c809831b5d54529ce436207a217d6"
    },
    {
      "section": "十二支体象",
      "text": "月支子水占魁名，溪涧汪洋不尽情。天道阳回行土旺，人间水暖寄金生。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0003",
      "sha256": "ca889062dd720ed8108eba9df3d669b17e36e1b95ac6a4898d16aa3b39e963c1"
    },
    {
      "section": "十二支体象",
      "text": "若逢午破应无定，纵遇卯刑还有情。柱内申辰来合局，即成江海发涛声。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0004",
      "sha256": "0badf69473be9e722f28d756db2992ee62b7b506886a536517a025fc9d49848e"
    },
    {
      "section": "十二支体象",
      "text": "眉批：十一月为一阳。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 10,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c216:p0005",
      "sha256": "3503b9e4e80c640d2181722d9ecf159354cdeb6f09f9af02987392e8fdcc0e1c"
    },
    {
      "section": "十二支体象",
      "text": "隆冬建丑怯冰霜，谁识天时转二阳。暖土诚能生万物，寒金难道只深藏。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0006",
      "sha256": "1f537a65e2d65c0a0151c2dfbe828b94ecc0fb6f73673bfef1a86630ae9b4bb6"
    },
    {
      "section": "十二支体象",
      "text": "刑冲未戌非无用，类聚鸡蛇信有方。若在日时多水木，直须行入巽离乡。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0007",
      "sha256": "44ac84157c5c9d2e76d48116c628344d60f2d4a45c7cb2be7865135f0d7ff61c"
    },
    {
      "section": "十二支体象",
      "text": "眉批：十二月为二阳，己土癸水辛金。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 17,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c216:p0008",
      "sha256": "0ebf80cf563fee94cae571dbe9a96d074337b071a81ab76a5277bfd853b09b71"
    },
    {
      "section": "十二支体象",
      "text": "艮宫之木建於春，气聚三阳火在寅。志合蛇猴三贵客，类同卯未一家人。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0009",
      "sha256": "fa465534c10ec427d7fec28a192597362d12f6b046faa7ba963621afddd4c665"
    },
    {
      "section": "十二支体象",
      "text": "超凡入圣唯逢午，破禄伤提独虑申。四柱火多嫌火地，从来燥木不南奔。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0010",
      "sha256": "98d060af5e0d633f15c66113a94fbb3f5d6841afc8beabd0ce76d508c06e74dc"
    },
    {
      "section": "十二支体象",
      "text": "眉批：正月为三阳，亥卯未木局为一家人。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 19,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c216:p0011",
      "sha256": "971cb7634ceb0f5a3c1bd8b1efcbd62f5782daa4dd49d488e2b1bde3e73ebb7a"
    },
    {
      "section": "十二支体象",
      "text": "卯木繁华秉气深，仲春难道不嫌金。庚辛叠见愁申酉，亥子重来忌癸壬。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0012",
      "sha256": "186a86737e844d9a36f884142fd93256063477e16f54e0458e99172229bb8181"
    },
    {
      "section": "十二支体象",
      "text": "祸见六冲应落叶，喜逢三合便成林。若归日时秋金重，更向西行患不禁。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0013",
      "sha256": "c9e04a229a11f24dca4a5bd77afb0cdf701e61aa1ca322c1447e22e4cb47037f"
    },
    {
      "section": "十二支体象",
      "text": "辰当三月水泥温，长养堪培万木根。虽是甲衰乙余气，纵然壬墓癸还魂。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0014",
      "sha256": "d180ac28ec469b8ecfd7ab1bb2cffc63558464a5d907fe742a939a644d08499a"
    },
    {
      "section": "十二支体象",
      "text": "直须一钥能开库，若遇三冲即破门。水木重逢西北运，只愁厚土不能存。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0015",
      "sha256": "e09956acce5594725fb4f97aa62d10d0b4996ab21f1c3d1da078caf71f360888"
    },
    {
      "section": "十二支体象",
      "text": "眉批：三月之土喜三合，不喜克削。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 16,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c216:p0016",
      "sha256": "a264bdeba5e45c9bd39c90d45bb2c5f218d1f28baa1fc57f1211c00a6b219092"
    },
    {
      "section": "十二支体象",
      "text": "巳当初夏火增光，造化流行正六阳。失令庚金生赖母，得时戊土禄随娘。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0017",
      "sha256": "6902a840a52c468bfff2571d6ada4672d6c683646fc1d6220b4c7b530af1887e"
    },
    {
      "section": "十二支体象",
      "text": "三刑传送反无害，一撞登明便有伤。行到东南生发地，烧天烈焰岂寻常。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0018",
      "sha256": "1cd6ef7eb6fba4f690727cf5dd62a24932c9780079255ca2dbd8458eb02a1326"
    },
    {
      "section": "十二支体象",
      "text": "眉批：六阳，四月也；登明，亥宫也。言巳亥犯。传送，寅刑巳也。喜东南忌西北。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 37,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c216:p0019",
      "sha256": "47d0abc5942fd64aaf2d70a5b1e67e59e738e46eeb8e5255ac6754ea00bf8127"
    },
    {
      "section": "十二支体象",
      "text": "午月炎炎火正升，六阳气续一阴生。庚金失位身无用，己土归垣禄有成。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0020",
      "sha256": "effd66933e13dafa81ba7805cfda8bc17b4e34669176d1adb009b4d6fc62a9aa"
    },
    {
      "section": "十二支体象",
      "text": "申子齐来能战克，戌寅同见越光明。东南正是身强地，西北休囚已丧形。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0021",
      "sha256": "50d987af37d9a4e797019babe66b7a2b5c31030aa2b0bfc1379c39d451a54c23"
    },
    {
      "section": "十二支体象",
      "text": "眉批：夏至後一日为阴生。申子辰合水局恐相刑克，喜寅午戌合则吉。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 31,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c216:p0022",
      "sha256": "545e55dcd9cd3cb61edb21ae6abe27aecddcff2b54f06b1226533924a9eafcc2"
    },
    {
      "section": "十二支体象",
      "text": "未月阴深火渐衰，藏官藏印不藏财。近无亥卯形难变，远带刑冲库亦开。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0023",
      "sha256": "40506df384e0c605e4ed7a8751d0b359ddf1a4975b84c02474b6e27453efe2ca"
    },
    {
      "section": "十二支体象",
      "text": "无火怕行金水去，多寒偏爱丙丁来。用神喜忌当分别，莫把圭臬作石猜。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0024",
      "sha256": "81d14ee87bdfd967b7269d66ebbbe18a0ee379632275c9ea2cb3b72476a55167"
    },
    {
      "section": "十二支体象",
      "text": "申金刚健月支逢，水土长生在此宫。巳午炉中成剑戟，子辰局里得光锋。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0025",
      "sha256": "9bcfd8a21fba58871d9a025e0b844bd5701209229aa6215750ec9235189ed3e2"
    },
    {
      "section": "十二支体象",
      "text": "木多无水终能胜。土重埋金却有凶。欲识斯神何所似，温柔珠玉不相同。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0026",
      "sha256": "09c662758fdb9b83def3ec571e909ed1ce346b9294e34f36224c97fdf1253279"
    },
    {
      "section": "十二支体象",
      "text": "眉批：庚金禄在申，水上又长生，怕金得令，忌土。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 23,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c216:p0027",
      "sha256": "f7a9c987d3311c64b57d26828393ae25e7172f7a7610a8f65e7de9f599c2dd62"
    },
    {
      "section": "十二支体象",
      "text": "八月从魁已得名，羡他金白水流清。火多东去愁寅卯，木旺南行怕丙丁。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0028",
      "sha256": "e8dcff16d7c5e057a6c80d6bfd382f1db96ad6a26036745c17f38fc0b3d20ca4"
    },
    {
      "section": "十二支体象",
      "text": "柱见水泥应有用，运临西北岂无情。假若三合能坚锐，不比顽金未炼成。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0029",
      "sha256": "b94407867421ae4c91339eb8cbaebe0068ca230bdf31333adea64aa6c9cb63bb"
    },
    {
      "section": "十二支体象",
      "text": "眉批：八月辛金旺地，丁己长生，从魁星名居酉位。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 23,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c216:p0030",
      "sha256": "6463c1f3f3e8a1cc6ed3732f3f29ed91b4c5f84bb87f6d9d28b569ffa2bbd3d7"
    },
    {
      "section": "十二支体象",
      "text": "九月河魁性最刚，漫云於此物收藏。洪炉巨火能成就，钝铁顽金赖主张。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0031",
      "sha256": "d00864534c96ed68e213775eff7e1412b3d44bf52d7dd9ce9515cbb6f02a98a2"
    },
    {
      "section": "十二支体象",
      "text": "海窟冲龙生雨露，山头合虎动文章。天罗虽是迷魂阵，火命逢之独有伤。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0032",
      "sha256": "eee4d2e572d37779777d0fd88a33e98e26136d7eaae5d52af31387cab5a93a02"
    },
    {
      "section": "十二支体象",
      "text": "眉批：何魁星名在戌位。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 11,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c216:p0033",
      "sha256": "7b30f1bf233698ccc20996ced9048fedbc717203a161074ed4ec408eb005c454"
    },
    {
      "section": "十二支体象",
      "text": "登明之位水源深，雨雪生寒值六阴。必待胜光方用土，不逢传送浪多金。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0034",
      "sha256": "5cbbd7942de99a10257c3ec35c48e8ce5dc872a6aede174715debcac2c7607b3"
    },
    {
      "section": "十二支体象",
      "text": "五湖归聚原成象，三合羁留正有心。欲识乾坤和暖处，即从艮震巽离寻。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c216:p0035",
      "sha256": "3f8aeaa17aa9af9c8650612814a9c461eaaf0dc0401c55c382b8faf17317b2c5"
    },
    {
      "section": "十二支体象",
      "text": "眉批：亥为登明也。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 9,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c216:p0036",
      "sha256": "732134628a5c67ebf2ef298be334cbc289878e306dc86a9376a40403b5bc7777"
    }
  ]
}
