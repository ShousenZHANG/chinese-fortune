  "issues": [],
  "passages": [
    {
      "section": "病药说",
      "text": "渊海子平卷六",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c282:p0001",
      "sha256": "222a11cf776cbb806f37292c1b03f7e25c110d85b0768baf1ed10f8923622000"
    },
    {
      "section": "病药说",
      "text": "病药说",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c282:p0002",
      "sha256": "9e7969c1252bbff258ed518f750dd7f1fcacbcd113101cd2c81dd3c3a4439318"
    },
    {
      "section": "病药说",
      "text": "何以为之病？原八字中原有所害之神也；何以为之药？如八字原有所害之字，而得一字以去之之谓也。如朱子所谓各因其病而药之也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c282:p0003",
      "sha256": "fd58c8758e240758552d6171f39637af308bd92686861ad998e97eb4766b1413"
    },
    {
      "section": "病药说",
      "text": "故书云：“有病方为贵，无伤不是奇；格中如去病，财禄两相随。”命书万卷，此四句为之括要。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c282:p0004",
      "sha256": "e311aae148f2392e48c9e8083b88ccd228660c550bdb6c6be9afcb1e50f5f06e"
    },
    {
      "section": "病药说",
      "text": "盖人之造化，虽贵中和，若一味中和，则安得探其消息，而论其休咎也？若今之至富至贵之人，必先“劳其筋骨，饿其体肤，空乏其身，然後动心忍性，增益其所不能”，人命之妙，其犹此乎！",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c282:p0005",
      "sha256": "9176e58e5ec962d4bb7a47ac166da483efd9d4e8eac393558affb6ba5e4f1257"
    },
    {
      "section": "病药说",
      "text": "愚尝无前未谙病药之说，屡以中和而究人之造化，十无一二有验。又以财官为论，亦俱无归趣。後始得悟病药之旨，再以财官中和参看，则尝八九而得其造化所以然之妙矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c282:p0006",
      "sha256": "1011be3bee5f973ca4035c869f812e09aa52b4790a1743bc3475ae14671a712d"
    },
    {
      "section": "病药说",
      "text": "何以言之？假如人八字中，四柱纯土，水日干则为杀重身轻；如金日干，则为土厚埋金；火日干，则为晦火无光；木日干，则为财多身弱；土日干，则为比肩太重。是则土为诸格之病，俱喜木为医药，以去其病也。如用财见比肩为病，喜见官杀为药也。如用食神伤官，以印为病，喜财为药也。或本身病重而药少，或本身病轻而药重，又宜行运，以取其中和。若病重而得药，大富大贵之人也。病轻而得药，略富略贵之入也。无病而无药，不富不贵之人也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c282:p0007",
      "sha256": "49e25362d6947dbf35df2686996eafc970e7cf1bd0d3b1b5bd9e7415009fcfa5"
    },
    {
      "section": "病药说",
      "text": "究人之命，将何以探其玄妙？如八字中先看了日干，次看了月令，且如月令支中所属是火，先看月令中此一火字起，又看年上或有火，又看月时上或有火，宜将以上各火做一处看，或为病，或非病。又或地支虽又有别物，且不必看，若再看别物，则混杂不明，故曰：从重者论。此理是看命下手法处。若以火论，又再看水看金看土，则不知命理之要也。若财官印绶有病，就要医其财官印绶也。如身主有病，就要医其身主也。如八字纯然不旺不弱，原财官印俱无损伤，日干之气，又得中和，并无起发可观，此是平常人也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c282:p0008",
      "sha256": "c11249dce079d292e01e2f3f601c957be7764a64794d72ce2091c06a0b0b421b"
    },
    {
      "section": "病药说",
      "text": "然病药之说，此是第一家紧要，得斯术者，不可不精察也，详见风验类。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c282:p0009",
      "sha256": "bf8b8f1f8867b5be562226325b884904d979be6a5dd52d1c7494b85e62da225f"
    }
  ]
}
