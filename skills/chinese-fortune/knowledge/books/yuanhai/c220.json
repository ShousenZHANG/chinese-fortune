  "issues": [],
  "passages": [
    {
      "section": "正财诗诀",
      "text": "渊海子平卷五",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0001",
      "sha256": "d284d3c59105f6347a605b7d9c7a48dc5eebdc667d0b53daee688840ad6bd8a9"
    },
    {
      "section": "正财诗诀",
      "text": "正财诗诀",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0002",
      "sha256": "fa7af80c66709d9baa0c07a1b66bcf2d1dcba08e6a0d340f2c0f66e0048c2c6e"
    },
    {
      "section": "正财诗诀",
      "text": "正财无破乃生官，身旺财旺禄位宽，身弱财多徒费力，劫财分夺祸多端。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0003",
      "sha256": "59c80cf6fff0bc55ae8ef0380170331e28edb9ab98951a579bc20d9b5947abfc"
    },
    {
      "section": "正财诗诀",
      "text": "正财得位正当权，日主高强财万千，印绶若来相济助，金珠满匣禄高迁。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0004",
      "sha256": "24891ce851cdaadbb7333d34217b62ee9cc335f9ecfab0188311992116d23c71"
    },
    {
      "section": "正财诗诀",
      "text": "正财还与月官同，最怕干支遇破冲，岁运若临财旺地，须教得富胜陶公。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0005",
      "sha256": "19167338878095c4692ae1262b597e3f114f7df079650afacec7b27ce425a853"
    },
    {
      "section": "正财诗诀",
      "text": "身弱多财力不任，生官化鬼反来侵，财多身健方为贵，若是身衰祸更临。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0006",
      "sha256": "bb6bf97c52d02b4274ce1574489ca1b9881a49773dcca1f059fb8945f0a1be39"
    },
    {
      "section": "正财诗诀",
      "text": "补：",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0007",
      "sha256": "ad592f8b264aaeddf8801e317f934c68fd9278174ad0fac30c18e20ba79ba084"
    },
    {
      "section": "正财诗诀",
      "text": "正财喜旺食丰盈，日主刚强力可胜，若是财多身自弱，平生破败事无成。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0008",
      "sha256": "2ab1792345fae73c4c7c8fd6770936231087bff7f1de8a1d900abb7774eaf19b"
    },
    {
      "section": "正财诗诀",
      "text": "正财切忌劫财神，破害刑冲不可论，岁运那堪逢刃地，命延不死也遭迍。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0009",
      "sha256": "5d16e2a27e16bb800bf30432b89a43c2d837570f9bae0dab80d34b2f5e6fc10d"
    },
    {
      "section": "正财诗诀",
      "text": "身旺无官只取财，财神冲破却为灾，身衰财旺还知夭，官盛身强福禄来。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0010",
      "sha256": "fa259ba2637efba5dc9286f5647424ca7a7ef16621b6c414436132270b1b0345"
    },
    {
      "section": "正财诗诀",
      "text": "财多全仗印扶身，乔木家声有旧名，不但妻贤儿子秀，晚年财帛累千金。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0011",
      "sha256": "c1a33e3f5787390db67fca2752e49924a6db4bbb4befc240633481f68f07d5fa"
    },
    {
      "section": "正财诗诀",
      "text": "财多如何不发财? 只因身弱少培栽，运到比肩身旺地，富贵荣华次第来。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0012",
      "sha256": "e1feed9e7a48dbb9c7f1d97e38980a3c30b204d76f35e5d0f3df702ab08ea183"
    },
    {
      "section": "正财诗诀",
      "text": "财多身弱慢劳神，户大家虚反受贫，亲友欠财常怨恨，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0013",
      "sha256": "a3a73fb7cf13b7b416c97653a0a56afe40dc7fb3fb2ccfe90461a807009577c4"
    },
    {
      "section": "正财诗诀",
      "text": "财衰身旺刃刚强，身旺之乡不太祥，凤寡鸾孤寒夜怨，房中妻哭两三场。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0014",
      "sha256": "7ec2c1cb723093bda8f5ca0aa02d80834780c505af4b7cf69a6d0e47cbc4629d"
    },
    {
      "section": "正财诗诀",
      "text": "财命相当人必耐，一世安然身康泰，纵使流年有财伤，浮灾小挠无妨害。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0015",
      "sha256": "ddfd586973d7f713495dd041bde9103e11356dc426d424e73f3bf7c9213c62a5"
    },
    {
      "section": "正财诗诀",
      "text": "财神忌透只宜藏，身旺逢之大吉昌，切忌比劫相遇值，一生名利被分张。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0016",
      "sha256": "0d29e9483fa74cfe11508dcbc22166fdea483ccdf0406f1553004334c7d86f2c"
    },
    {
      "section": "正财诗诀",
      "text": "日主无根财犯重，全凭时印助身宫，逢生必有兴家福，破印纷纷总是空。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0017",
      "sha256": "a1a5bfca4dfea918db185e5ebaefae7cb98c27bc6c6c7dbf5bf89fcaf2cdd910"
    },
    {
      "section": "正财诗诀",
      "text": "财多身旺足荣欢，身旺财多化作官，身衰财多财累己，是非不竞起争端。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0018",
      "sha256": "94b46de5044d315c56e182cef25c99d5280f3ebbb188391f3637205a8ba9c3b2"
    },
    {
      "section": "正财诗诀",
      "text": "财星气盛喜生官，身旺当为好命看，若还财盛身又弱，更逢官旺主贫寒。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c220:p0019",
      "sha256": "e3b284c3dbdeec0878321191e4eaedbe25672f6c6afc45be4d98c89b348bff79"
    },
    {
      "section": "正财诗诀",
      "text": "眉批：“正财无破”正谓之“用之为财不可劫”也。财多身弱，正为富屋贫人。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 35,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c220:p0020",
      "sha256": "4190fcac8e1d497cfe16620305dd5f67d5e2dd7ccfec0a9b4139e06683003054"
    }
  ]
}
