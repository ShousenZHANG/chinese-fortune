  "passages": [
    {
      "section": "内十八格-飞天禄马格",
      "text": "渊海子平卷二",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0001",
      "sha256": "7ff3cf914c80f6b91688ae2c54d143b1d64be1e4fc0c5f98b16611fb00d628f4"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "内十八格 - 飞天禄马格",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0002",
      "sha256": "86d33b390e0593fd635d4d78be15aa83987368614f6ce3dc5c7acd067e6d538d"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "此格以庚壬二日，用子字多冲午中丁己为官星。要四柱中有寅字，并未字或戌字，得一字可合为妙。如六庚日，六壬日以子字冲午字。庚日以子冲午中丁火为官星，若四柱中有丁字并午字，则减分数，岁君亦忌。如六壬日以子冲午中己土为官星，若四柱中有己字并午字，则减分数。岁君，大运亦须忌之。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0003",
      "sha256": "66640f8b8a0fe8d5a353c7ac6ca95973c1972633b0a0297a6b0fec8cb166cea7"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "乔丞相，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0004",
      "sha256": "3e7a8738f4241865a9a99f1499e5b43e9ea19d1111dddc7ef0b091ac57a50507"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "丙子 丁酉 庚午 丙子 (子冲午丁火)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0005",
      "sha256": "0ddc727cd835699adc77fbc9f782cb6bbe0e77d7903ea7365b3a4111c448f471"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "蔡贵妃，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0006",
      "sha256": "229261468eca3780a29e1fc9e23d7c3d8a72725f88842bc26e15114812f62b48"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "己未 丙子 庚子 丙子 (冲子为官)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0007",
      "sha256": "00471d8df7ebabaabc901d7fe3f53a78327f808cf5816e1a553f553403e6425e"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "正使，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0008",
      "sha256": "f140c388b634bbb8ee03f5f246e16ec27d95f19e2e780d1dffc1e098f8880892"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "壬子 壬子 壬子 壬寅 (以子冲午己土为官)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0009",
      "sha256": "ba178c07aaa920e4a51bf89a63f28ff99ad2a1a0e9a2ef6bad1745ef0549a178"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "气贫，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0010",
      "sha256": "1d96fafeeba0125557c98ac127f84ad216b5233f9cf6cd59fb2b388dcf411aed"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "壬子 壬子 壬子 丙午 (以子冲午中己土为官星，又不合见午时重官星，就又贫极，为乞丐之命也。)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0011",
      "sha256": "495fdda9ad12adeca0d3a43aab9e59fc16b0a6ed439ae06490908e8ac4384f41"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "眉批：诗诀，庚午日主要逢子，倒冲禄马号飞天，何如金木为情重，运入南方虚有逆。庚午鼠队来冲马，辛癸寻蛇要衆猪，丙日马群冲子午，丁逢蛇衆见双鱼。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 70,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c103:p0012",
      "sha256": "290bc47fc779d3b5b37ea3d40487e6df0616e6f544f1f51684af4e95d5df0821"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "又格",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0013",
      "sha256": "131212e4d8a60d9cd88605206920cb7aefe2cc84675009974475468b3462568e"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "以辛癸日用亥字冲巳中丙戊为官星，要四柱有申字，并酉字或丑字，得一字可合为妙。假令六癸日以亥冲巳，若四柱有戌字，则亥水不能去冲矣，岁君大运亦忌。如六辛日以亥冲巳中丙字为官星，若四柱中有丙字并巳字，则减分数，岁君大运亦忌。运连太岁轻，再见巳字有祸矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0014",
      "sha256": "3125f4ffd8225da28a499796423421788aedb112d62b50f999ed1e27c2056b33"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "梁丞相，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0015",
      "sha256": "77b913d80624db8c774a3ad987c1388712c71b92952d22f96c8ef8604a9b8e5a"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "丁未 癸卯 癸亥 癸亥(亥冲巳中戊土为官)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0016",
      "sha256": "b35447f337edd51a533e0328fc846cfdc87137e50d27eedbca2a32b00409c4ff"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "曹郎中，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0017",
      "sha256": "d5dd739535dc7f50aa46d3cff7deca6913043d10a20309283b1b9058cb8330b1"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "壬申 辛亥 癸亥 壬子(亥冲巳中戊土为官)",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0018",
      "sha256": "a6e9800895a18bb0d5146d252fa4d6bf82bb0bf133ca251f19589f2f87d9e556"
    },
    {
      "section": "内十八格-飞天禄马格",
      "text": "诗诀：辛癸之运古有言，宜逢合巳号飞天，除是天罡逢小吉，灾消福衆利自绵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c103:p0019",
      "sha256": "f898aeef95f0f8f203bd02c1c7ab2d758672963dc18e427c199f67b845f5eafe"
    }
  ]
}
