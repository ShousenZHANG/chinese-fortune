  "issues": [],
  "passages": [
    {
      "section": "女命大义-1",
      "text": "渊海子平卷七",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0001",
      "sha256": "6b80087542a73aa2a75d1af474ca2cda84e4b0f80256e05bc5a13ae1bac1e7f3"
    },
    {
      "section": "女命大义-1",
      "text": "女命大义-1",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0002",
      "sha256": "28b630ae55db6615d6cd183619acc1cce647c8160304be8e653c966bb78cb9ba"
    },
    {
      "section": "女命大义-1",
      "text": "或问：妇人何利？利在夫星，夫利其妇必利，夫困其妇必困。妇人从夫，先观夫星以定出身之贵贱，再看子星以察晚年之荣辱。官煞财得地，夫利也。食神得地，子利也。夫利则出身富贵，一生享福。子利则晚年厚养，褒宠诰封。然亦有旺夫者，以食生财，财生官故耳。反是则否。女命以克我者为夫，我生者为子，皆要得时，乘生旺之气。若旺气只聚於时，亦可用官为夫，不要见煞，用煞为夫，不要见官，一位为好。有两位，官星无煞以杂之，四柱纯煞无官以混之，仅为良妇。更得本身自胜尤佳，但旺不可太过。食为子息，引归时逢旺，再得二德扶身，乃夫贵子荣之命。不宜身旺重叠，暗藏夫神及伤官、七煞，魁罡相刑，羊刃太重，合多有情，皆主不美。岁运亦然。看有八法、八格，须细详之。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0003",
      "sha256": "9a0a57c8883b868979cc876ba04b3cbbdf1be7e035ea8cf33dd83702df95d3f6"
    },
    {
      "section": "女命大义-1",
      "text": "纯",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0004",
      "sha256": "cdd3310de70eb7b81db3dccb9c96877316fe5c2422cd349d8cc6b67f84386ef9"
    },
    {
      "section": "女命大义-1",
      "text": "纯者，一也。加纯一官星或纯一煞星，有财有印，不值刑冲，不相混杂是也。加",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0005",
      "sha256": "0d756848f43f8973f814077cacddb845822ab675c85fe14e99ede71f3ca3ecbc"
    },
    {
      "section": "女命大义-1",
      "text": "癸巳 戊午 辛酉 丙申，本身专禄，旺不从化，辛用丙官为夫星，五月火旺夫健，丙用癸为官坐贵，见戌为食，同归禄於巳。辛金生壬水为子，引入申时长生之地，天干癸戊辛丙，水火既济，地支巳午酉申，拱夹财库，所以嫁夫为官而食天禄，夫荣子贵之命。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0006",
      "sha256": "7ece8311ef6ef8d6059867473b6d50b6d19b84dd284de536e6daaa4ffb11b5b2"
    },
    {
      "section": "女命大义-1",
      "text": "癸亥 甲寅 丙戌 甲午，丙用癸为夫，临官在亥，甲为印，坐寅建禄，自身坐库，己土为子，归禄于午，居时子息之位，甲木为己土之官，四柱纯一不杂，故主贵。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0007",
      "sha256": "312425bb3e08988b4268af829a8c1e0d21adcea2ce1ffc91503e4cf291aec2c9"
    },
    {
      "section": "女命大义-1",
      "text": "和",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0008",
      "sha256": "3d7114281f5b59d9a7ab82c23fb0d9411eac84fa3b69aa9426edfad89098dda8"
    },
    {
      "section": "女命大义-1",
      "text": "和者，恬静也。如身柔弱，独有一位夫星，柱无冲破攻击之神，禀其中和之气则为和也。如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0009",
      "sha256": "d7d3415f8514fdb27e3b8c939da802305472a8b692e0a6f01e7ae7782c51b297"
    },
    {
      "section": "女命大义-1",
      "text": "壬辰 辛亥 己卯 己巳，己用甲为夫，亥乃长生之地，得天时地利，甲以辛为官，金生於巳，己以金为子，亦生於巳，谓之夫得官星，子得长生，故主益夫旺子。虽自坐卯支为煞，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0010",
      "sha256": "aca2b5cda4467d009fc6215aedfeddf022e213a0cd4e53e3d4ad31a235cc4520"
    },
    {
      "section": "女命大义-1",
      "text": "有巳中庚制，为去煞留官之论，女命之贵也。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0011",
      "sha256": "d3a7b54f566b453de01119a049de765f358a71a4bac344835f260973ffed0784"
    },
    {
      "section": "女命大义-1",
      "text": "丁丑 壬寅 丁酉 己酉，丁用壬为夫，甲为印，乃夫之食禄，丁酉日贵，生己酉之子，壬水得己土为官，主夫贵，己土得甲为官，主子贵，酉中财旺，荣夫荫子之造。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0012",
      "sha256": "9abcf5dc84736f8ad83ef2ccf82138e7216b25f4dd43b9b41b4ca7edab089236"
    },
    {
      "section": "女命大义-1",
      "text": "清",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0013",
      "sha256": "59854abf83c9333408b3406326eb81e1cb25e00aa26264f675eaa465736c3aa7"
    },
    {
      "section": "女命大义-1",
      "text": "清者，洁净之称。女命或一官一煞，不相混杂，谓之清。要夫星得时，柱有财生官，有印助身，无一点混浊之气，方为清贵。如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0014",
      "sha256": "472c809ba0a6f05808080beb1b1ad5cf0206473376d0278047e8e4edb9922e4d"
    },
    {
      "section": "女命大义-1",
      "text": "己未 壬申 乙未 甲申，乙以庚为夫，庚禄到申，以丁为子，丁旺於未，以壬为印，壬生於申，又坐下支神为乙木之财，财旺则能生官，四柱无刑冲破败。经云：财官印绶三般物，女命逢之必旺夫。故有两国之封，夫人之命。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0015",
      "sha256": "feaf23a2adb0f5cfc17f0d3c8cbcbccbc4912b910235bb7fb1f44095719a5eef"
    },
    {
      "section": "女命大义-1",
      "text": "甲寅 癸酉 丙寅 戊子，丙用癸为夫，坐酉自生，癸得戊为官，癸禄居子，夫得禄者贵。丙火得戊土，为子登龙池凤阁，主子贵。余仿此推。龙池煞，申子辰人龙午凤酉，寅午戌人龙子凤卯，巳酉丑人龙卯凤子，亥卯未人龙酉凤午。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0016",
      "sha256": "3cf99645a7a70815d92b2ee3f2648708384f87d2c26e69f1086b12c40a067c52"
    },
    {
      "section": "女命大义-1",
      "text": "贵",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0017",
      "sha256": "0c9640c83aa92be3a31317b83b09d8bae749e68a2c1c22ec3db78fdd2844154e"
    },
    {
      "section": "女命大义-1",
      "text": "贵者，尊荣之号。命中有官星，得财气以相资，三奇得其宗，四柱不值鬼病，乃女命尧舜也。经云：无煞女人之命，一贵可作良人。又云：女命无煞逢二德，可两国之封。二德者，非独天月二德，即财为一德，官为一德，加之印食，愈为贵也。如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0018",
      "sha256": "5a8decfd2e99ea79f190c6782726f45184b259791cc63447ba5bc27b93087bc2"
    },
    {
      "section": "女命大义-1",
      "text": "甲午 丙寅 丁未 壬寅，丁以壬为官，壬食甲为印，壬用丙为财，壬以亥为禄，得二寅暗合，虽夫星失时，喜行西北夫旺之运，故主大贵。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0019",
      "sha256": "440fff4f1d868dba30f3801eb14a5cdbcbf104b47c51d2904e273e15a94e4496"
    },
    {
      "section": "女命大义-1",
      "text": "乙亥 丙戌 辛卯 癸巳，辛用乙为财，旺於亥，丙为夫星，坐库归禄，巳上癸水为夫之官，辛金生癸为子坐巳上，与夫禄同位，又是贵神，又为财官双美，乃得夫子俱贵，封两国夫人。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0020",
      "sha256": "bf84e7e9411a250403a8f83a0f59bd4fb8e86a105c1608770ee719324a576afe"
    },
    {
      "section": "女命大义-1",
      "text": "浊",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0021",
      "sha256": "396152e60817fd8a4d58672fd9bfbe75b41da0dfd49bc1abd5efcb9919206440"
    },
    {
      "section": "女命大义-1",
      "text": "浊者，混也。乃五行失位，水土互伤，其身太旺，正夫不显，偏夫外杂，柱多分别，无财官印食，为下贱低浊或娼妓婢妾、淫巧之人。如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0022",
      "sha256": "7e6c28bac08beff9aa9c30539d2664367309cd2745bdbd38e439c0e9bea0f4a9"
    },
    {
      "section": "女命大义-1",
      "text": "己亥 乙亥 癸丑 己未，癸水生十月，太泛，癸以戊为夫，不显，时引己未是偏夫，嫌丑未皆有土混杂，柱中无财，乙木为食神干旺，己土受克，鬼败临身，五行失位，主先清後浊，不能享福。又癸未、甲寅、辛酉、乙未，辛酉八专自旺，用丙火为夫，长生於寅，夫旺本好，但辛贪乙未库中财，惹起未中丁火为暗夫，两库暗夫重过明夫，明暗交集，虽有正夫，未免暗中偷夫得财，乃浊乱之象。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0023",
      "sha256": "5759836806a6db79a5bf8fdf3641018697f154869cd84e234ce5c4faf5b63f9d"
    },
    {
      "section": "女命大义-1",
      "text": "滥",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0024",
      "sha256": "fa5c1961d88d1006f25edd33e79bed1b1769f5964ad2b43fc0d5c08622b24476"
    },
    {
      "section": "女命大义-1",
      "text": "滥者，婪也。谓柱中明有夫多，暗中财旺，干支又多带煞，必因酒色，私暗得财，此等之命，或为婢妾，或克夫再嫁。如庚寅、丙戌、庚申、丁亥，庚申八专自旺，丙火为夫，寅戌会局，时干又丁，爱重火情，庚申金暗克寅亥木为财，亥中壬水为食生财，其人虽美貌有福，不免滥而得财。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0025",
      "sha256": "7c18adb385151c6e85cec835a0de20c1f96d15e69c8b46f86993993311564e6c"
    },
    {
      "section": "女命大义-1",
      "text": "戊子 甲寅 己未 丁卯，正月甲木旺，卯未会局，偏正夫多，子上又有旺财，己合甲官，阴阳匹配，故虽聪明秀丽，不免失之於滥，况倒插桃花，上坐娣妹，不是官星，岂为良妇。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0026",
      "sha256": "b27036ab047ddb0509e092fff131f4797cf84f50c7762804f836a9e29d6cada2"
    },
    {
      "section": "女命大义-1",
      "text": "己酉 丁丑 癸丑 壬戍，柱中明有己夫，二丑一戌三夫暗藏，丁为财，归库於戌，与丑相刑，二阳得令，火亦进气，是夫多财旺，丁壬太过。又甲辰、癸酉、丙子、辛卯，丙子日犯阴阳煞，主男子挑诱，丙以癸为夫，辰子会水，夫多，日时丙辛合子卯，支刑干合，犯荒淫滚浪，酒色昏迷，酉中财旺，癸夫专坐。二命俱妓，卖奸得财。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0027",
      "sha256": "c2b0fe97d9c9ea16e17ca30b4e9e7b2e2f2468bf177a1b8347612800ad89798c"
    },
    {
      "section": "女命大义-1",
      "text": "娼",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0028",
      "sha256": "dbe2ca6fec79fb02c93b489b192d5c33394f2937ff1b685af0cc91ef9bd31e13"
    },
    {
      "section": "女命大义-1",
      "text": "娼者，妓也。乃身旺夫绝，官衰食盛，食柱中不见官煞，或有而伤官伤尽，或官煞混杂而食神盛旺，此必娼妓之命，否则为师尼婢妾，克夫淫奔。如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0029",
      "sha256": "42537253f49f842d70e046ca66c29827c0ae1939d64ec312224ec740e5ed26ee"
    },
    {
      "section": "女命大义-1",
      "text": "丁亥 庚戌 戊辰 庚申，戊以甲为夫，九月失时无气，又被庚克绝，时引入申，以庚为食，建禄在申，戊辰魁罡生申太旺，亥中壬财亦旺，谓之身旺逢生，贪食贪财，夫绝而为秀丽娼也。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0030",
      "sha256": "b924cd283eb1f92acc3f8c8eebe9f31dac50580e22c7a98986230aa60a2871c1"
    },
    {
      "section": "女命大义-1",
      "text": "乙亥 丙戌 甲子 丙寅，甲以庚辛为夫，九月金衰气退，时引食神长生木地会局，甲木归禄身旺，庚金引至寅地，绝而无气，二丙食神太旺，伤其金夫，谓之自旺食盛，衣食虽好，不免风尘娼妓。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0031",
      "sha256": "1a96a86c6c87a549cf8d33014097a66c657ef49a67b47a168fee46c69198e4be"
    },
    {
      "section": "女命大义-1",
      "text": "癸丑 庚申 戊辰 庚申，戊用乙夫，绝在申，戌日得庚申为食神，月时重见，谓之食旺夫绝，故主为娼。凡阳干女命食神多者为娼，阴乾女命食神多者为妓。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0032",
      "sha256": "776b26b1b92580cca859d8634b4ada6d072aebbf05c05828180319f89f4a76e4"
    },
    {
      "section": "女命大义-1",
      "text": "淫",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0033",
      "sha256": "d792c5bd62d2ee6d718ffc657a180d4844a6aefc3070a55b218f1d1aa76d0528"
    },
    {
      "section": "女命大义-1",
      "text": "淫者，泆(音同易)也。乃本身得地，夫星明暗交集，谓日干自任，柱中皆官煞是也。在干者为明，支者为暗，四柱太过。如一丁见三壬，及辰子多之例，谓之交集，於人无所不纳也。如戊辰、壬辰、壬戌、癸亥，壬辰、癸亥本自得地，明有戊土为正夫，暗有辰戌为偏夫。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0034",
      "sha256": "4b7f75cd62c087a066a500a440c15db53659b9c7b5ea8896aacb0c8bc69971ac"
    },
    {
      "section": "女命大义-1",
      "text": "庚戌 戊子 乙酉 甲申，乙以庚为明夫，而身坐酉支，时又引申为暗夫，运行西方金旺之地。二命俱夫星明暗交集，淫不可言。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0035",
      "sha256": "9f46717d81406f1bb72a10b7528f6ca1faceea70a66bfc10e89f4341e3789b2a"
    },
    {
      "section": "女命大义-1",
      "text": "癸亥 壬子 丁丑 壬寅，丁火纯于衆水之中，明暗夫多，淫乱无耻。经曰：丁遇壬而太过，必犯淫讹之乱是也。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0036",
      "sha256": "265fcf8389398bbd7b3397fe53434dcfe051d71e973c1a4a9b41e025873ed049"
    },
    {
      "section": "女命大义-1",
      "text": "癸卯 甲子 己卯 乙亥，己用甲为夫，甲败在子，卯为暗夫，坐于支下，又亥卯多明暗交集，正夫不能主张禁制，暗夫得势而入，正夫反回避也。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0037",
      "sha256": "96ae95457534eeecc2ddbe34d766bdaa95ca839adc8f8792e94a5b9db76ae62f"
    },
    {
      "section": "女命大义-1",
      "text": "旺夫伤子",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0038",
      "sha256": "17fe8e0f51f92557dab794c59bc95535ea2cfba4e08d3959fa2d3a9c9c78c648"
    },
    {
      "section": "女命大义-1",
      "text": "夫女人有旺夫伤子者何，此法皆时上推之。时为归宿之地，夫子二星引归於时，夫星生旺，子呈衰败是也。且如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0039",
      "sha256": "c51659c63404dd59dd74ab6ad8779fbc206ac0fbdb3d855e15dc1f1feab654ad"
    },
    {
      "section": "女命大义-1",
      "text": "丙戌 丙申 丁巳 辛亥，丁坐巳自旺，以壬水为夫，时上乃是夫星临官之地，月支申金乃夫星长生之地，以辛金为财，七月金旺，二丙相比，皆坐夫之财印，故主夫聪秀富贵。丁以戊为子息之垣，引至时上见亥，亥中甲水能克戊土，乃子星被克而难得也，故主旺夫伤子。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0040",
      "sha256": "46d151963c1f5ac1fc34f4425925c224df5379c315e9a06ed3281f32d22bc216"
    },
    {
      "section": "女命大义-1",
      "text": "旺子伤夫",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0041",
      "sha256": "7372ebc2f20800b84af3fe8d13b3cf077e7591a70c5e26bbde739119377169fd"
    },
    {
      "section": "女命大义-1",
      "text": "有旺子伤夫者何，此法专以月时推之。谓克我者为官为夫，有气得时，则夫发福，若支干失位，不得月气，柱中又逢冲克，时上又无旺气，而己生之子引至时上，逢长生临官帝旺之地，又无刑克，是旺子伤夫也。且如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0042",
      "sha256": "660dd6179619e876b7cce077a008507b52861af37ee8eb3483374489bb19dcd8"
    },
    {
      "section": "女命大义-1",
      "text": "己卯 甲戌 乙卯 戊寅，乙用庚为夫，九月庚金无气，乙用丙为子，丙火长生於寅，与戌会局，皆属火，月令既无金气，时引绝地，又被火克，是伤其夫星，旺其子息，故曰旺子伤夫。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0043",
      "sha256": "0d65e44539edeaf18fda77e3b98d9b8a36ee6a9d982edcbfd3afc8d9fafa552f"
    },
    {
      "section": "女命大义-1",
      "text": "伤夫克子",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0044",
      "sha256": "a23105aa6e5923d533c7f95ac221a1011c3265c805fe78ccc9569e4fae70b68e"
    },
    {
      "section": "女命大义-1",
      "text": "伤夫克子者，乃夫星干支失位，生月失时，柱中又逢冲克，时支亦不生扶，兼且印绶重逢，盗夫之气，克子之甚，夫子不能旺，反绝於时是也。且如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0045",
      "sha256": "7ee7758b1800d0982a443ec832c62289f3ae80b17061c73fa3edc90c348560cd"
    },
    {
      "section": "女命大义-1",
      "text": "丙子 庚子 乙亥 丙子，乙木以庚金为夫星，十一月金寒水冷，又金死子地，支亥子水盗金气尽，柱无土生助，伤官太多，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0046",
      "sha256": "1dbce8cf20f9ba7a21d985a221bf65053433c20031f3c606d4bbd93efaf2c9a7"
    },
    {
      "section": "女命大义-1",
      "text": "故伤其夫。乙木以丙火为子，引至子时，乃水旺火灭之地，虽年时干二火，被群水相克，夫子皆亡，故曰伤夫克子。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0047",
      "sha256": "cf02b948196b3119adb74b62c42695fc4acb88985a14d9151fc365636ef9ce1f"
    },
    {
      "section": "女命大义-1",
      "text": "安静守分",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0048",
      "sha256": "f3ab79d8958979a044ca9d5e4b3c8a0adf82e904255562525c2acd750269fa37"
    },
    {
      "section": "女命大义-1",
      "text": "安静守分者，乃夫星有气，日干自旺，相停无克，不值刑冲，财食得所者是也。且如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0049",
      "sha256": "a65c78e4b0b851631dee2694c5f4a82e37316aab4352789c8a809611835e1e45"
    },
    {
      "section": "女命大义-1",
      "text": "癸巳 庚申 乙卯 丁亥，乙坐卯专禄自旺，又得时支亥字合局，是本身旺也，以庚金为夫，七月庚禄到申，又得年支巳火为金长生之地，是夫星旺也，亥中壬水，夫之食神天厨，故主夫",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0050",
      "sha256": "4e184887ad6e2203e9fc33d43ba3dd7925dbdef84287e54044fabaa5e179c508"
    },
    {
      "section": "女命大义-1",
      "text": "食天禄，此乃自己夫星两不相伤，各乘旺气，无混杂相侵，夫妇和谐，安静守分格也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0051",
      "sha256": "ca746df6c3cec6bf06ffe9c7e32ef2ae72759032f086bf15172a343ddac4f650"
    },
    {
      "section": "女命大义-1",
      "text": "横夭少年",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0052",
      "sha256": "082025a40c2f160b35a3ad009a94f2cc9adc95cc5ecf5e8509233ca353cc0543"
    },
    {
      "section": "女命大义-1",
      "text": "夫横夭少年者，造化之穷绝，格局之变异也。有悬梁溺水，血産少亡，被人杀死。若此者何，乃身弱而遇煞重，煞多克身，又带刑冲破败之类，或命中无有官星受伤，行运复遇官乡，或无官见伤，运复临官之类，或带刃无制，运行合刃之地及亡神劫煞等类，此皆横夭类也。不独女命有之，男命亦同。且如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0053",
      "sha256": "1919ab48d946435327ba7b030f86afb432070df4431ef76ce6e9c7d30de2fb54"
    },
    {
      "section": "女命大义-1",
      "text": "丁卯 癸丑 庚辰 丙子，庚用丁为官，被癸水子辰伤官叠遇，克之太重，水多金沈，一交丁巳运，伤官见官，又会丙煞克身，故有溺水之害。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0054",
      "sha256": "f26588f8e420c70ecb7f4f74dda893e731806341ad56d6b9b9d2d4272fcda231"
    },
    {
      "section": "女命大义-1",
      "text": "乙酉 戊子 丙寅 己亥，日干丙火长生於寅，冬生亥子，官煞太重，谓之旺火投于盛水，故生産而亡。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0055",
      "sha256": "2eb4d4be4f023d559b562262b93a6bec81497461a7538710a017b432594cf3ae"
    },
    {
      "section": "女命大义-1",
      "text": "壬子 癸卯 甲戌 丁卯，月令羊刃，时丁卯伤官羊刃，子刑成合，柱中又无夫星财星，癸酉年乙丑月己卯日，犯奸杀死。凡女命官煞太重，羊刃无情，非淫滥则凶亡。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0056",
      "sha256": "edce4dbb01618ac71582edd22c8a656257b09d9df564139456520419b2dd8598"
    },
    {
      "section": "女命大义-1",
      "text": "福寿两备",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0057",
      "sha256": "da904ee034f29f2ba96714d4c71bab9a1683638c9ed70ba58c574c1f6e8aa8e0"
    },
    {
      "section": "女命大义-1",
      "text": "夫福寿两备者，造化之中和，格局之纯粹也。有享用一生，永锡难老。若此者何，乃身坐旺多，通於月气，支干相辅，更带财官印绶，各得其位，不行脱财坏印伤官之局，尤喜食神天厨。若身旺而运行财食之乡，此皆福寿两备之命也。且如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0058",
      "sha256": "530f395ed76a6c539890146c23b83ea1a7f2a5824438d721c6981cb2e179462b"
    },
    {
      "section": "女命大义-1",
      "text": "丙午 庚子 辛酉 癸巳，辛坐酉支，专禄自胜，时癸归禄於子，为食神寿星，子星得地，辛用丙火为官，丙禄归於巳，为夫星得地，又十一月生人，乃金白水清之象，兼支干上下相辅，俱无伤损，身不从化，故主为人美貌端正，夫子相停，福寿两备。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0059",
      "sha256": "81b466f473f579988a218d489bae2ce66c66f4f54ffdd7efd7d09ade91428e47"
    },
    {
      "section": "女命大义-1",
      "text": "正偏自处",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0060",
      "sha256": "323cf4f2ef2e6531d514e0e7b8145b24f312c43c1699756f9228777612cc093f"
    },
    {
      "section": "女命大义-1",
      "text": "夫正偏自处者何也，乃夫妇相合，复遇比肩分争，如一位夫星，有两位妻星相合，谓之争合，若本身自旺，彼身值衰，四柱不冲，则我正而彼为偏，若彼旺我衰，四柱冲我，则彼为正而我为偏矣。盖我身旺有气，则夫从我为正，我身衰而别位旺，则夫从别位，我反为偏，谓之彼旺，争去我夫，我只得为偏。或自旺太过，柱无夫星者，亦为偏。或官煞混杂，或伤官太重，亦为偏，更淫滥。且如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0061",
      "sha256": "b22665eb9116c2d468ad303a9dcd31b7728392cf049a5398d3474939c4ee97ff"
    },
    {
      "section": "女命大义-1",
      "text": "壬子 丙午 辛酉 辛卯，辛用丙为夫星，身坐酉支，专禄自旺，虽时引辛卯之金，彼却无力，故我为正而彼为偏，此为二女争夫，正偏自处。又",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0062",
      "sha256": "e739dece8b86fbb75767e2ae789840306e4b8f63b2fffd122412094d7dd3fa6c"
    },
    {
      "section": "女命大义-1",
      "text": "癸未 壬戌 癸巳 壬子，癸用土为夫，癸巳水弱，壬子水旺，弱不能胜旺，被壬水争去戊土正夫，乃彼胜我衰，我只得为偏，但壬水重而太泛，又带桃花，不能自处。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0063",
      "sha256": "e1a48258795adbfacd7d46f4bf084d647823f92da087b91e23315be76a928939"
    },
    {
      "section": "女命大义-1",
      "text": "招嫁不定",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0064",
      "sha256": "e3fcf831674136c07a70457b3016ac15294129cfbf64e21e4be22550b108b43b"
    },
    {
      "section": "女命大义-1",
      "text": "夫招嫁不定者何也，乃月令中有夫星透干，与己相合，己身从伏，其夫星却无气，时引夫星或煞星却乘旺地来克己身，又从伏偏夫，故谓之招嫁不定。若夫星不旺或受克制，必嫁夫迟，或嫁夫不明，或夫不济事，或有外情。且如",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0065",
      "sha256": "5b69137d7ef458279a740821275c4e1c430b3f39a69b7382f43ff9f98b3129aa"
    },
    {
      "section": "女命大义-1",
      "text": "癸酉 甲子 己未 乙亥，己用甲为夫，生於十一月，失时不旺，时逢亥字，乃甲水长生，是夫旺也，却不合又被乙木制己未，未为乙木库地，甲生子月，夫坐败地不显，时逢乙亥，亥中又有长生之甲，欲甲而又招乙也，此为招嫁不定。余仿此推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c298:p0066",
      "sha256": "b43d700eac1fb4b825182de8ba29fb18b3602f5b668b51092dd1a33abc18f462"
    }
  ]
}
