  "issues": [],
  "passages": [
    {
      "section": "食神诗诀",
      "text": "渊海子平卷五",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0001",
      "sha256": "d284d3c59105f6347a605b7d9c7a48dc5eebdc667d0b53daee688840ad6bd8a9"
    },
    {
      "section": "食神诗诀",
      "text": "食神诗诀",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0002",
      "sha256": "e18d62edb4d2ad1fec9554d33355eb6319a164d3a73285f57f14b2f1e67e605a"
    },
    {
      "section": "食神诗诀",
      "text": "食神有气胜财官，先要他强旺本干，若是反伤来夺食，忙忙辛苦祸千般。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0003",
      "sha256": "a148fd2dcb7ba3943815c261d3cefd14ea4ef0d2b21ea18878d95971b288237f"
    },
    {
      "section": "食神诗诀",
      "text": "食神无损格崇高，甲丙庚壬贵气牢，丁己乙丁多福禄，门甲弧矢出英豪。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0004",
      "sha256": "6e24e875e98ef170945008dee7f70babc48ae5c97190f35f72a62cbada66337a"
    },
    {
      "section": "食神诗诀",
      "text": "甲人见丙本盗气，丙去食戊号食神，心广体胖衣禄厚，若临偏印主孤贫。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0005",
      "sha256": "03ae2f79eb48cb1d8664ef3c8aeca373f836ae2c132c26fca792878586a4a1d9"
    },
    {
      "section": "食神诗诀",
      "text": "食神居先杀居後，衣禄平生福最厚，杀近食神却有殃，终日尘寰漫奔走。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0006",
      "sha256": "00aeac037f988eff8f47e61ae6ff9df68b4de20c2b43cb2a15e2ba119d0f93c3"
    },
    {
      "section": "食神诗诀",
      "text": "寿元合起最为奇，七杀何忧在岁时，禁凶制杀干头旺，此是人间富贵儿。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0007",
      "sha256": "45b0a807cfe0cf2182f4fa665e42a2a9dd743b848c5f287717e9a1aabe36025c"
    },
    {
      "section": "食神诗诀",
      "text": "申时戊日食神奇，惟在秋冬福禄齐，甲丙卯寅来克被，遇而不遇主狐疑。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0008",
      "sha256": "5b66e508b39da033666d7175e905a667d9758ff405556fec82c3d875423702fa"
    },
    {
      "section": "食神诗诀",
      "text": "补：",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0009",
      "sha256": "ad592f8b264aaeddf8801e317f934c68fd9278174ad0fac30c18e20ba79ba084"
    },
    {
      "section": "食神诗诀",
      "text": "食神制杀吉非常，财旺妻荣子更强，柱中若无吞啖杀，管教金殿佐君王。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0010",
      "sha256": "b09502d76fd5706e0928826475a4c584dfe78ecdab63b9939cbc3928b3750018"
    },
    {
      "section": "食神诗诀",
      "text": "食神逢禄号天厨，冲克空亡官无杀，死绝运临偏印地，寿星合是福交乎。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0011",
      "sha256": "ac70f6d608eaa4e84d4e5734c2e6da30eeea38cb7960896a7993e491feeaf825"
    },
    {
      "section": "食神诗诀",
      "text": "食神印绶不宜逢，惟见财官福更隆，食神喜行身旺地，逢枭遇劫总成空。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0012",
      "sha256": "e054efa65ce3759901d1e2beccfdcbcadf844a253c081fff7b00454abdfe9766"
    },
    {
      "section": "食神诗诀",
      "text": "食神生旺最堪夸，惟有水木金土佳，官杀更无来混杂，平生衣禄享荣华。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0013",
      "sha256": "fd3b1f1455de4e31a9d98a69866f175b5fe240242e1532ed5818f9d973f8089e"
    },
    {
      "section": "食神诗诀",
      "text": "食神生旺无刑克，命逢此格胜财官，更得身旺逢财地，青春年少步金銮。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0014",
      "sha256": "7f2555f538e545b7263113d29567f2edcf265b59df98ec0f8ab8a3daf21a625f"
    },
    {
      "section": "食神诗诀",
      "text": "食神无损寿绵长，庶母逢之不可当，若无偏财来救护，命如秋草带冬霜。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0015",
      "sha256": "b2fdd304b569f2103354b09c25049f890ee5691d2900bc958ae4f240f182f9fc"
    },
    {
      "section": "食神诗诀",
      "text": "食神月上号天厨，人命逢之富有余，切忌枭来明灭福，最嫌冲去暗消除。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0016",
      "sha256": "b8ce66b604244fda74fff1355a60edd05539375e02ed69f10f7af89f30352ba4"
    },
    {
      "section": "食神诗诀",
      "text": "生财化劫兼无病，制杀为祥信有诸，士子如逢科甲第，官封要职领天书。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0017",
      "sha256": "f52e54a2dc15b739b3239a332192c1e2a7cd803f3d3f79ca261a76ce00aea33d"
    },
    {
      "section": "食神诗诀",
      "text": "食神生旺喜生财，日主刚强福禄来，身弱食多反为害，或逢印绶不生灾。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c222:p0018",
      "sha256": "faf92eb49f75721fd5934605d11c5ea4339a5a2d1c3fdea9cab70888b20f6400"
    },
    {
      "section": "食神诗诀",
      "text": "眉批：食神，我生之子也，如人之有好子可依养，若不肖，则败其家业而反取祸，有害于父母也，以意断命，十有八验。五行内有即寿元，也如甲子乙丑海中金，即金为寿元也。“申时戊日食神奇”，此言庚申时逢於戊日，乃食神干旺之日是，忌甲丙卯寅，乃遇而不遇。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 119,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c222:p0019",
      "sha256": "9ade00f2f03018c12ed608c5c81592dbb22342f614113cb432256711c71d4278"
    }
  ]
}
