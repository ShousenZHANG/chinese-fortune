  "passages": [
    {
      "section": "时墓诗诀",
      "text": "渊海子平卷五",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c230:p0001",
      "sha256": "d284d3c59105f6347a605b7d9c7a48dc5eebdc667d0b53daee688840ad6bd8a9"
    },
    {
      "section": "时墓诗诀",
      "text": "时墓诗诀",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c230:p0002",
      "sha256": "14b9dd117f3a069eb16e1221b8d8eaade0935cd65feaea2d58402ae3bb216a7c"
    },
    {
      "section": "时墓诗诀",
      "text": "财官藏蓄四时辰，年少相冲可进身，不遇相冲遭压伏，果然不发少年人。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c230:p0003",
      "sha256": "3f11b917fbfc55e031e3f94ac632083d004dfed26aad2534f62aafe7b11da1af"
    },
    {
      "section": "时墓诗诀",
      "text": "北方壬癸遇河魁，南域加临小吉时，仓库丰盈金玉满，优游处世福相随。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c230:p0004",
      "sha256": "63c43837b856b6fb1588e2a4f8431fc6460b96d1e72d6955a9521fc2d323e733"
    },
    {
      "section": "时墓诗诀",
      "text": "若问财官墓库时，辰戌丑未一同推，财官俱要匙开库，压住财官未是奇。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c230:p0005",
      "sha256": "b8c5c2f139484ce5a4002cdcc97ef9e42e182b18b8fbd9142d1b7ff9360bfefd"
    },
    {
      "section": "时墓诗诀",
      "text": "要知何物能开库，刑冲破害是钥匙，露出财官方得用，身衰鬼墓甚危痴。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c230:p0006",
      "sha256": "f07b68e74eb811cc737fc987e449fd0038be66ea7476c609355c26d68abb310d"
    },
    {
      "section": "时墓诗诀",
      "text": "眉批：辰戌丑未为四墓地，也有浅深，术人不知墓库之分别，凡五行有生有死，死者埋之为墓，而又复生若库者，五行未死贮之，库乃有气之物，墓为绝气之物。库者遇冲开取而用之，墓者纵冲开取亦无用焉。此有轻重之分，如日干是甲，贵在丑宫辛金为正官、癸水为正印、己土为正财，不知何用之为福？但看柱中透出何字，为随所上者而言之。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 153,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c230:p0007",
      "sha256": "36478f26db97918340a4aa6cf69225c0a5b5740afaa981d15d7ffa647ac894db"
    },
    {
      "section": "时墓诗诀",
      "text": "盖库中之物，须待开其钥者，何也？乃刑冲破害耳。然而，官墓不显其荣，财墓不用於此，印墓不得为信，此三者入墓，正是紧要，喜冲开。其余则不要紧。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c230:p0008",
      "sha256": "b78aa87a5109c75b6f84ed4c42b6a7054d42358061760cb2c6a6ebcd28aeea6d"
    }
  ]
}
