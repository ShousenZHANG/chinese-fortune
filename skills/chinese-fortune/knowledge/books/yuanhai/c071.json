  "issues": [],
  "passages": [
    {
      "section": "论五行生克制化各有所喜所害例",
      "text": "论五行生克制化各有所喜所害例",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c071:p0001",
      "sha256": "d1b8dc8aadf0e4c3f13c0859bca1cdaba9e5218f5009cad1269a9f0b6b48b363"
    },
    {
      "section": "论五行生克制化各有所喜所害例",
      "text": "金旺得火，方成器皿。火旺得水，方成相济。水旺得土，方成池沼。土旺得木，方能疏通。木旺得金，方成栋梁。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c071:p0002",
      "sha256": "f2429da02dd5b66e397453b69d9c2505594e1b58671e8901aaed31e3156b9fbb"
    },
    {
      "section": "论五行生克制化各有所喜所害例",
      "text": "金赖土生，土多金埋。土赖火生，火多土焦。火赖木生，木多火炽。木赖水生，水多木漂。水赖金生，金多水浊。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c071:p0003",
      "sha256": "ddef9fb567c2ad326cd16e9661d9517c05deed02b7e8afc5ae34f727d1741c41"
    },
    {
      "section": "论五行生克制化各有所喜所害例",
      "text": "眉批：身弱逢印绶重重，即为所害。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 16,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c071:p0004",
      "sha256": "3e624cd37b495d85636f930fb4d560e8ec0f91b47ceae1b35bb5ce02a76fe2f2"
    },
    {
      "section": "论五行生克制化各有所喜所害例",
      "text": "金能生水，水多金沈。水能生木，木盛水缩。木能生火，火多木焚。火能生土，土多火晦。土能生金，金多土变。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c071:p0005",
      "sha256": "b7cb0804715777be729b5aa4b19efcd3a49c17a18074f8426a0ef16ebef85352"
    },
    {
      "section": "论五行生克制化各有所喜所害例",
      "text": "眉批：此乃身弱，伤官食神太旺，故有所害，此其大忌。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 25,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c071:p0006",
      "sha256": "08a05661752aeb86ab82d0163d35ff2950de55a0166cf2b7652675e5e972c73b"
    },
    {
      "section": "论五行生克制化各有所喜所害例",
      "text": "金能克木，木坚金缺。木能克土，土重木折。土能克水，水多土流。水能克火，火炎水热。火能克金，金多火熄。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c071:p0007",
      "sha256": "42cd3b49b1ae5fb2ff63036b30a2e793dae74141c644d879a67b9719b3ee78de"
    },
    {
      "section": "论五行生克制化各有所喜所害例",
      "text": "眉批：此身弱逢财，反能害身。身强遇财，人临富贵。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 24,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c071:p0008",
      "sha256": "b0f2a50a0bdb337561285f0af219a1895912c7e1273abd4ccaf8f2816ae8c090"
    },
    {
      "section": "论五行生克制化各有所喜所害例",
      "text": "金衰遇火，必见销熔。火弱逢水，必为熄灭。水弱逢土，必为淤塞。土衰遇木，必遭倾陷。木弱逢金，必为砍折。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c071:p0009",
      "sha256": "ff4368cfb52a205fac73570ad8c5571dac9ba9950adeae45801d85546a1f7b0b"
    },
    {
      "section": "论五行生克制化各有所喜所害例",
      "text": "眉批：身弱遇官煞旺，多为残伤贫而贱命。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 19,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c071:p0010",
      "sha256": "af70878be4f06734e04efb09c9e25cfc92c8a8eb1cabdfbbdee951ca06c765c9"
    },
    {
      "section": "论五行生克制化各有所喜所害例",
      "text": "强金得水，方挫其锋。强水得木，方泄其势。强木得火，方化其顽。强火得土，方止其焰。强土得金，方制其害。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c071:p0011",
      "sha256": "d7100b9e04dbf7c028b39ff7c0dcee46175cb7b707af4feac130c45ca63f542e"
    },
    {
      "section": "论五行生克制化各有所喜所害例",
      "text": "此乃身弱遇鬼，得物以化之则吉，如甲日被金杀来伤，若时上一位壬癸水或申子辰解之，即能化凶为吉。余者仿此。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c071:p0012",
      "sha256": "3d8b53c3a6f00b013b9e1adf758c19b6fd1fa7e6d1958765df42989fd4365adb"
    },
    {
      "section": "论五行生克制化各有所喜所害例",
      "text": "眉批：官与鬼一也，身旺逢之为官，身弱遇之为鬼。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 23,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c071:p0013",
      "sha256": "6b6876adebb7037493fc13fdd89c8aae7a07cea8dc673af60854b3b5b31c70f2"
    }
  ]
}
