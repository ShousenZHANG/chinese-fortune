  "passages": [
    {
      "section": "天干五阳通变",
      "text": "**﻿天干五阳通变**",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0001",
      "sha256": "525bffc6282d74770c832fe1e68b66d6b1d1d935ceb6cf1938f309720615de09"
    },
    {
      "section": "天干五阳通变",
      "text": "甲 丙 戊 庚 壬(日干)五干属阳喜合",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0002",
      "sha256": "59bd244b1f24c1a667d8be09f4b514e07df640ee01ec8d20f439cdbaedab12f2"
    },
    {
      "section": "天干五阳通变",
      "text": "甲 丙 戊 庚 壬为比肩兄弟之类",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0003",
      "sha256": "f08abb9c8641337bcbcf4e4936c46e7e2ee9bcd0a6f08631688789128239e530"
    },
    {
      "section": "天干五阳通变",
      "text": "乙 丁 己 辛 癸为劫财败财，剋父及妻",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0004",
      "sha256": "37c4302ae3e4253dd46f5f639d16ecb471d8574d5134f3cd2a2b3f338aa107e4"
    },
    {
      "section": "天干五阳通变",
      "text": "丙 戊 庚 壬 甲为食神，天厨寿星，为男",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0005",
      "sha256": "f6a755cd01f8bc93553b9e9a9e412e6b14b6b544650d8bc5e1e7f206344a2ec9"
    },
    {
      "section": "天干五阳通变",
      "text": "丁 己 辛 癸 乙为伤官，退财，耗气，子甥",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0006",
      "sha256": "c5fc4d0848a905cdcf354723bc31ba4f716636f9707cb991ce8687c875e235f6"
    },
    {
      "section": "天干五阳通变",
      "text": "戊 庚 壬 甲 丙为偏财，偏妻偏妾，剋子",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0007",
      "sha256": "e6bd88e196db21d9133dbb1b2004b396db5cef3b658c39c69c6b37b8fad290ca"
    },
    {
      "section": "天干五阳通变",
      "text": "己 辛 癸 乙 丁为正财，正妻，剋母，为合神",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0008",
      "sha256": "f853126cab0da3305de4398ef2bfc67dc71806e13fdaa7913e892e38dbe46d52"
    },
    {
      "section": "天干五阳通变",
      "text": "庚 壬 甲 丙 戊为偏官，七杀，官鬼，将星",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0009",
      "sha256": "070e4fa799c86d45eb218db74962c70074808659ec0130726e7ca869145e6cb5"
    },
    {
      "section": "天干五阳通变",
      "text": "辛 癸 乙 丁 已为正官，禄马，荣神，父母",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0010",
      "sha256": "b124b7d70cbb0bd5325223f95b7b23f7db40dc7e4af934934a9519eebc828071"
    },
    {
      "section": "天干五阳通变",
      "text": "壬 甲 丙 戌 庚为倒食，偏印，梟神，剋女",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0011",
      "sha256": "7cc255c91fbb906d39c1496b8909b8150cd966d7e50cf5eb04f4d93aaa28b6c1"
    },
    {
      "section": "天干五阳通变",
      "text": "癸 乙 丁 己 辛为印綬，正人君子，产业",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0012",
      "sha256": "e42aef6c856907074e21ef8b8642bf40c1fdae0fd0ab4b8f432dce6f804dd5cb"
    },
    {
      "section": "天干五阳通变",
      "text": "剋我者为正官偏官，生我者为正印偏印，我剋者为正财偏财，我生者为伤官食神，同我者为劫财败财。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0013",
      "sha256": "81c5743ef5e838380fdd612b4aa53afbe981b046526f507fa1217ff6bab03c6d"
    },
    {
      "section": "天干五阳通变",
      "text": "眉批：甲木乃阳木，也甲见甲为比肩，见庚金为煞，辛金为官，癸水为正印，壬水为偏印，丙火为食神，丁火为伤官，戊土为偏财，己土为正财，皆以阳见阴为正，阳见阳为偏。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 78,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
      "layer_status": "explicit_marker_not_collated",
      "passage_id": "yuanhai:c016:p0014",
      "sha256": "7ca994965cf90d7d9b7ce568ec5e836ef000a33a62c510e94a05546404c49736"
    },
    {
      "section": "天干五阳通变",
      "text": "举此为例，其餘类推。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c016:p0015",
      "sha256": "d43a3ac2fd717632e864855e059f2f6f0df21a40a6660a19cb941502adb0bd39"
    }
  ]
}
