    },
    {
      "section": "女命贵格",
      "text": "正气官星，财官两旺，印绶天德，独杀有制，伤官生财，坐禄逢财，官星带合，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c152:p0002",
      "sha256": "6582964363331ae92178cd6da36c390fa9d30182ca33fee86bc95666cb2abd1b"
    },
    {
      "section": "女命贵格",
      "text": "日贵逢财，官贵逢官，官星坐禄，官星桃花，食神生旺，食神生财，杀化印绶，",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c152:p0003",
      "sha256": "be23a8837bf756e3ee72949a4c188783e5075cd3b28170a6401d88e2083f61f1"
    },
    {
      "section": "女命贵格",
      "text": "二德扶身，三奇合局，羊刃有制，拱禄拱贵，归禄逢财。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c152:p0004",
      "sha256": "209aa64593661c6ae68a4a29d93ae3567de6abd07827d7a86dc69f0fbfcd1e21"
    },
    {
      "section": "女命贵格",
      "text": "眉批：官星要合，只喜一位为贵，合多不贵反为下贱。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
