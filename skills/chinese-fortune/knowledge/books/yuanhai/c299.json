  "raw_sha256": "64f17bc367874c69965e197914a8cc2ea3994e96b20590ad519fe341468ea3a9",
  "raw_kind": "cleaned_original_transcription_not_complete_http_response",
  "extraction_kind": "selected_original_html_node",
  "issues": [],
  "passages": [
    {
      "section": "女命大义-2",
      "text": "渊海子平卷七",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0001",
      "sha256": "6b80087542a73aa2a75d1af474ca2cda84e4b0f80256e05bc5a13ae1bac1e7f3"
    },
    {
      "section": "女命大义-2",
      "text": "女命大义-2",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0002",
      "sha256": "3b1f041ee3b42355c31eee5863079d5eed3551e3a1076f8225306a8bc87d4134"
    },
    {
      "section": "女命大义-2",
      "text": "女人之命，一贵为良，食重孤孀，贵多淫贱。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0003",
      "sha256": "ee573600ebab8f6c877c732b28cc4957ca4290061762b6ad6e1543b6e878cee0"
    },
    {
      "section": "女命大义-2",
      "text": "贵指官煞言，食伤官煞，孤克之星也，官煞叠见，淫乱之象也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0004",
      "sha256": "9e8084360c8abffd8be5c8b7fea6bc024facccc2c93b1f69990c93e1e6ddf3f9"
    },
    {
      "section": "女命大义-2",
      "text": "二德真贵，封赠可知，三奇真良，国号自至。金木有坚心之淑德，水火生乱性之虚花，五行偏喜休囚，四柱不宜生旺。富贵贫寒，全凭夫子。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0005",
      "sha256": "1cebdf4e2b0c068e885031e952f5f727a01a653dd41a2fe4563890337c889986"
    },
    {
      "section": "女命大义-2",
      "text": "二德即天月德也，女命得之，更有财官，纯粹不杂，必受封赠。三奇，甲戊庚之类，财官印食亦为三奇，女命中有此，必受国号。德者，纯一不杂之谓。金木性纯，本为女人之所守。水流主淫，火炎主暴，水火多则乱性，为人虚花不纯而暴恶矣。阴主柔，阳主刚，女阴也，与男相反，故喜休囚而忌生旺。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0006",
      "sha256": "fc0b1bdc2dd1877aef18ee0453f5dcd7db9b883deade6ede4fbdd823c1e048a0"
    },
    {
      "section": "女命大义-2",
      "text": "伤官克则食绝孤苦，夫健旺则子秀身荣。阴命印重本绝嗣，运行官煞反吉。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0007",
      "sha256": "8417f6bed2ebb8a0b4031017bb3a51f196f4ffb1cc8aac1a58659bd36a6ef14c"
    },
    {
      "section": "女命大义-2",
      "text": "夫旺子生，此理之常。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0008",
      "sha256": "84eaebfc2af0a31019442f7a5a2400e844b91f965ba4c59544e4edd9ede71492"
    },
    {
      "section": "女命大义-2",
      "text": "女犯伤官须克配，运入财旺亦佳。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0009",
      "sha256": "acf566ca93e414087180fcab9140b2f81f28269b3a1b26afe6aed155daa67393"
    },
    {
      "section": "女命大义-2",
      "text": "伤生财，财生官，所谓能使无情更有情。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0010",
      "sha256": "542dbc0e1f2e55c34faabc4dba7a0505836b8a752a956b959c588bdb6526a6ac"
    },
    {
      "section": "女命大义-2",
      "text": "弃命就煞，必配名家。专禄食神，断受诰命。孤鸾最利於七煞，桃花喜带乎官星。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0011",
      "sha256": "62c7b97a06ff0874b940432800a07c7aa08943d76e1e9db9aaeb2cd6ad75f228"
    },
    {
      "section": "女命大义-2",
      "text": "此四格皆主官贵，益夫旺子。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0012",
      "sha256": "622b084e203e34c0e31f96eb3c120e291c9bed6244a40fa5c6744e2959902156"
    },
    {
      "section": "女命大义-2",
      "text": "官贵太多，非偏房即为舞妓。会合过盛，不媒约则是尼姑。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0013",
      "sha256": "1534283a4aade81e602d45d53ca465d93123141d0aa2fe3bae9cefd539cbc5d9"
    },
    {
      "section": "女命大义-2",
      "text": "女命虽不嫌官贵，多则不吉。天干地支三合六合带得多者，必为此等之人。盖媒妁联二姓以成亲，尼姑受万人之施舍，参之人事，章章明矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0014",
      "sha256": "d4bbf88bcdcb39256dda0e7c2bf1249ed88fdb27aeb4f1872fe85e22fdcb36ba"
    },
    {
      "section": "女命大义-2",
      "text": "甲木坐申透庚金，子都西子。丙火坐申时壬水，大乔小乔。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0015",
      "sha256": "67fdcb503f6f92d5f5efa66445e4a7f2688b49eb899d767a3568b651ff9e7216"
    },
    {
      "section": "女命大义-2",
      "text": "言此二日专用煞，苟无混杂，其女必有倾国倾城之色矣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0016",
      "sha256": "06798f0959733175ababec8a43d76e329cddd9219512163a30f8ccf3d3699e98"
    },
    {
      "section": "女命大义-2",
      "text": "庚寅戊寅，纵遇破败犹得。己卯癸未，休教红艳相侵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0017",
      "sha256": "91201570776d1e5baa48e7bd8428c42cdd02963bb49a3257663ab3fb932b4be5"
    },
    {
      "section": "女命大义-2",
      "text": "此四日俱自坐长生临官之夫，如庚得寅、戊得寅，乃上人之妻，己得乙、癸得己，亦不失为佳妇，但五阴日不宜。红艳、桃花二煞，五阳遇之，纵为不堪，亦可养身。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0018",
      "sha256": "ef1c43019a80116b0c56a5ebe541c29623d209d0e73e57d569b5f744614d6eaf"
    },
    {
      "section": "女命大义-2",
      "text": "官临墓绝之地，老困娇娘。夫居杂气之中，最宜佳妇。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0019",
      "sha256": "133e000fe4834bb2633f9eeb64eafcc21328135c5444d713ad3792d8c1815031"
    },
    {
      "section": "女命大义-2",
      "text": "如庚用丁为夫，十一月生，辛用丙为夫，八月生，虽名为夫，实则不。时纵有貌，必然受困，所谓红顔多薄命是也。如癸日生於未月杂气之中，有丁乙己夫星，子息财帛全，虽居杂见之，不忌。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0020",
      "sha256": "a2d8e616a1d0719487a5245f62f7db5188244ed1e05257bab976ec4c9d2b6403"
    },
    {
      "section": "女命大义-2",
      "text": "官得令而逢伤，反作奴婢。煞当权而有制，当为正室。日刃逢煞，不偏则尼。月伤叠刃，非奴则婢。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0021",
      "sha256": "36ff2ecdaee2b559af033f9eccec62da60e5707e95202913fed722bd824fbc1c"
    },
    {
      "section": "女命大义-2",
      "text": "日刃逢煞，如壬子日戊申时之例。月伤叠刃，如丁卯月甲辰日之例。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0022",
      "sha256": "7f982e8a30c90d897ca81ceab7207e550a0358364c21fae82999170bca758dca"
    },
    {
      "section": "女命大义-2",
      "text": "伤官夺夫之柄，化煞助夫之资。桃花喜共官星，红艳休同然伴。寒衾少怨，命值孤鸾。独枕早孀，日临寡鹄(音同胡)。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0023",
      "sha256": "fae5655ac9dd1b047b8aeee809f87cf286e3b659b1e839fb76a676b9e293e293"
    },
    {
      "section": "女命大义-2",
      "text": "柱中绝无官煞，值此日为忌。如有官煞等项倚靠，虽犯孤鸾、阴阳差错等日，反吉。寡鹄即孤鸾。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0024",
      "sha256": "900a4f26cc268be76b5e088c7d264d92c218cc65f3a97f177bcbcc123a9bec23"
    },
    {
      "section": "女命大义-2",
      "text": "孤鸾若遇夫星，必多子女。天德如逢煞化，定盛婢奴。一片比肩，官地争夫。拟定浑身泄气，印星望嗣堪求。旺夫伤子，乃官令而枭强。旺子伤夫，因食时而官绝。印重盈盘，遇富夫而多得子。食清值令，得壮妹必许夫荣。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0025",
      "sha256": "2b2db166f5dc24a4580db3fc665999a18f302998dc8e85afd3c78ec34375e4b5"
    },
    {
      "section": "女命大义-2",
      "text": "富夫乃官星带财之论。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0026",
      "sha256": "0b02e1ff250f566305b0b16811e6d4200db4c4ebbb10b9cfafd6759b183d261e"
    },
    {
      "section": "女命大义-2",
      "text": "印重官轻夺夫权，凤舞鸾飞坑婢命。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0027",
      "sha256": "93721414946a372905eb6541d1f71b910b66456da10b2895aff701eaea04e42e"
    },
    {
      "section": "女命大义-2",
      "text": "孤鸾日乃旺毒之辰。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0028",
      "sha256": "6814063aa4a45142e0880dff8c7af4bd0c96c08ca5bf50f34e5dc86e31f4b5e9"
    },
    {
      "section": "女命大义-2",
      "text": "天月二德无他乱，衣锦冠金。羊刃七煞无善降，身尘发垢。一逢阴煞，非守志必也无儿。两透阳伤，且桥身而不克婿。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0029",
      "sha256": "ab10acc1338c7027ff128903b672fdb7ca717a5eb6438cac3244bd89ba275f72"
    },
    {
      "section": "女命大义-2",
      "text": "五阴日见五阴煞为凶，阳伤官得印重反荣身而不克婿。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0030",
      "sha256": "26e4a00b087d36678acb48bd1a237015a4bf12edb4dd5a6ca6eeca0ff8d404fa"
    },
    {
      "section": "女命大义-2",
      "text": "日刃同刃，最忌生産。食神反破，难与留服。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0031",
      "sha256": "2872c99508f97155533991a18c6f434f10117720cb7ed32e3cf0944b217e924e"
    },
    {
      "section": "女命大义-2",
      "text": "日刃同刃是逢冲也，如丙午、庚寅、壬子、癸卯，是年刃与日刃相冲。食神犯破是逢枭也，如丙申、庚子、戊戌、丙辰，月於庚食被时丙克之。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0032",
      "sha256": "e322fd55f607ec65e2f2afedaed6c49848e571729f5363cdb448cfdfeedd8512"
    },
    {
      "section": "女命大义-2",
      "text": "官临死绝知夫丧，枭遇驱除断子来。何知夫得贵，孰察子得官，食附官而可知，官即食而可见。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0033",
      "sha256": "ce3c1bf52b7ad90f7b86482900353a20ee990a9b214a14e6d72c96461803430e"
    },
    {
      "section": "女命大义-2",
      "text": "如己未日辛亥时，甲与己合，辛附甲官，食神健旺子贵，逢破则子不肖。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0034",
      "sha256": "c50ce70a625398282659d9641123fcd9c3c0ba2c36cf167887cf094f873d84bb"
    },
    {
      "section": "女命大义-2",
      "text": "先後兴衰，倚夫星之好恶。始终盛替，察子运之荣枯。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0035",
      "sha256": "36d578a0c4aca77625091b24a5d60bb68ed258ce74548e4fdc4928b80574066f"
    },
    {
      "section": "女命大义-2",
      "text": "如一命戊日生春甲寅时，偏官乃戊之夫，虽壮不见财星，行至东方，又无金制其木，其夫无名无利，交到午运，夫星正值食得所，却是甲水死地，故克夫再嫁。未申二运，财帛驰至，大发。运至酉下五年，甲胎为寿，戊土丙火至此俱死，七煞见伤官，甲无倚而亡。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0036",
      "sha256": "a6a3a8f3242937868f0473d9db0ffe39c3f7b2ce908156d3a5b20d18c8735690"
    },
    {
      "section": "女命大义-2",
      "text": "登明足艳，太乙多淫。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0037",
      "sha256": "acd1818e484fae3fe2fa6e7f2789a359a6863c31575fb53d48642c970b03dfd2"
    },
    {
      "section": "女命大义-2",
      "text": "亥为入夜之时，巳为迎夜之候，女命而得亥多者有姿，巳多者好色。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0038",
      "sha256": "cff37dc19ce4899f00c948e26582b782c26c9c59972a4426b7d917ce2cdbd6e8"
    },
    {
      "section": "女命大义-2",
      "text": "木盛则妖妍，水澄则清洁。金多夭折，火致刚强，土则富厚。负天月二德，则霞帔金冠。得禄命身三财，则夫荣子贵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0039",
      "sha256": "03dde574502f672b04896e2f05e909dd1bf2a1c1b6cd9e07810693861703f613"
    },
    {
      "section": "女命大义-2",
      "text": "岁干所克者禄财，岁支所克者命财，纳音所克者身财，其三财所属之五行，在命中一财不乏而得之全者，夫必荣，子必贵。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0040",
      "sha256": "9b42ff0971eae1ffd9039fed16a5cb47e37b8184c356f739438b794d030d7c92"
    },
    {
      "section": "女命大义-2",
      "text": "切嫌者，阴刃妨害尊亲。最忌者，纯阴不宜子息。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0041",
      "sha256": "1fbf8d93db100d12de48252d332576710d5dbe0e5bf412f6596e87bff1450b76"
    },
    {
      "section": "女命大义-2",
      "text": "禄後一辰曰阴刃，男得之妨妻族亲，女得之访夫族亲。又命年月日时干支俱属阴，或生五月之後十一月之前者，乃阴极而阳不生，是为纯阴，多无子息，盖独阴不生，独阳不成故也。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0042",
      "sha256": "ff181433621c09ab45649c3fb536946dcbcf91bf6d9a38fbc2925866b1e2e5cf"
    },
    {
      "section": "女命大义-2",
      "text": "骨髓破殃罹内外，荐枕星招涉是非。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0043",
      "sha256": "7b06af35085baace31cfbbb8b69b85b0c6173894699fc30e62b6b8a81003df8f"
    },
    {
      "section": "女命大义-2",
      "text": "骨髓破即白衣煞，得之者刑及内外二族。荐枕星乃冠带位，得之者一生多涉是非。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0044",
      "sha256": "6e3937b679ac2009820fbdb02e952f7e1d45a8ca17d8ce3a3e729522fe8c916c"
    },
    {
      "section": "女命大义-2",
      "text": "鸳鸯惮于见水，倾国倾城。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0045",
      "sha256": "078c5516ac3f0e974752df883894fdff47bb1fde0ad1a40397aca798dbb06272"
    },
    {
      "section": "女命大义-2",
      "text": "凡三支三干，凤凰、麒麟、凤沼三格，在女命则变为鸳鸯煞，主淫秽，命中又见水多，主风尘多艳质。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0046",
      "sha256": "84325b20c0fac347552698423b3d185b6d14ffe0475d575d317ecd041463339d"
    },
    {
      "section": "女命大义-2",
      "text": "官鬼旺於贵垣，凤冠霞帔。花钗与桃花相犯，暮雨朝云。贵人共天喜争窠，穿垣蹇牖。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0047",
      "sha256": "e6c0c09778757cb61bc40682c19c8fd214d591dd2e19768d04bc66e59d7dcb90"
    },
    {
      "section": "女命大义-2",
      "text": "命前一辰为花钗煞，後一辰为桃花煞，本生上见之，全而不偏，是为同犯，主为娼优，得三奇不在此论。天乙住处曰贵人，旺气住处曰喜神，本生上带之而又同宫，是为争窠，主为淫奔之妾，落空亡不在此论。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c299:p0048",
      "sha256": "22a6d0f01004afa1b3cd1bb89698b509c61bba4c268aeec242d47964c4f5fbfc"
    }
  ]
}
