      "section": "冠带诗诀",
      "text": "渊海子平卷五",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c271:p0001",
      "sha256": "d284d3c59105f6347a605b7d9c7a48dc5eebdc667d0b53daee688840ad6bd8a9"
    },
    {
      "section": "冠带诗诀",
      "text": "冠带诗诀",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c271:p0002",
      "sha256": "eb219d4e433271804a973385d9dbbed156e34b1e7b3895a808a3c9398b632b78"
    },
    {
      "section": "冠带诗诀",
      "text": "命逢冠带少人知，初主贫寒中主宜，更得贵人加本位，功成名遂又何疑。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c271:p0003",
      "sha256": "500b05f016c59dbe8e5510df555bf78e6ebdec0037805fba682394c4061836a5"
    },
    {
      "section": "冠带诗诀",
      "text": "人命若还逢冠带，兄弟妻孥无陷害，因何接祖绍箕裘，只为胎中有冠盖。",
      "layer": "historical_work_transcription",
      "passage_id": "yuanhai:c271:p0004",
      "sha256": "78353186b2a368564d417906542e56448f221637a749c233a33cad7c80d742fe"
    },
    {
      "section": "冠带诗诀",
      "text": "眉批：冠带如人年长至十五，可以冠中，更带以在。五行始生，招之故为吉庆，人命当此，可以兴家立业。",
      "layer": "historical_commentary",
      "commentary_spans": [
        {
          "start": 0,
          "end": 47,
          "layer": "historical_commentary",
          "marker": "眉批：",
          "boundary_closed": true
        }
      ],
